                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TESTMODE2</name>
                  <description>Read: In test-mode 2.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TESTMODE3</name>
                  <description>Read: In test-mode 3.</description>
