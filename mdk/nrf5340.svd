          memory mapped addresses</description>
              <lsb>0</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable</description>
                  <value>0xFFFFFFFF</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable</description>
                  <value>0x00000000</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ERASEPROTECT</name>
          <description>Erase protection</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <fields>
            <field>
              <name>PALL</name>
              <description>Blocks NVMC ERASEALL and CTRLAP ERASEALL functionality</description>
              <lsb>0</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable</description>
                  <value>0xFFFFFFFF</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable</description>
                  <value>0x00000000</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TINSTANCE</name>
          <description>SW-DP Target instance</description>
          <addressOffset>0x024</addressOffset>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <fields>
            <field>
              <name>TINSTANCE</name>
              <description>TINSTANCE bits are negated and used in the SW-DP DLPIDR.TINSTANCE field. E.g. 0xF in this field is translated to 0x0 in DLPIDR.TINSTANCE field.</description>
              <lsb>28</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <dim>0xC0</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>OTP[%s]</name>
          <description>Description collection: OTP bits [31+n*32:0+n*32].</description>
          <addressOffset>0x100</addressOffset>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <fields>
            <field>
              <name>OTP</name>
              <description>Bits [31+n*32:0+n*32] of OTP Region</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <cluster>
          <name>KEYSLOT</name>
          <description>Unspecified</description>
          <headerStructName>UICR_KEYSLOT</headerStructName>
          <addressOffset>0x400</addressOffset>
          <cluster>
            <dim>128</dim>
            <dimIncrement>0x008</dimIncrement>
            <name>CONFIG[%s]</name>
            <description>Unspecified</description>
            <headerStructName>UICR_KEYSLOT_CONFIG</headerStructName>
            <addressOffset>0x000</addressOffset>
            <register>
              <name>DEST</name>
              <description>Description cluster: Destination address where content of registers KEYSLOT.KEYn.VALUE[0-3]
          will be pushed by KMU. Note that this address MUST match that of a peripherals
          APB mapped write-only key registers, else the KMU can push this key value into
          an address range which the CPU can potentially read!</description>
              <addressOffset>0x000</addressOffset>
              <access>read-write</access>
              <resetValue>0xFFFFFFFF</resetValue>
              <fields>
                <field>
                  <name>DEST</name>
                  <description>Destination address for key slot n</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>PERM</name>
              <description>Description cluster: Define permissions for key slot n. Bits 0-15 and 16-31 can only be written once.</description>
              <addressOffset>0x004</addressOffset>
              <access>read-write</access>
              <resetValue>0xFFFFFFFF</resetValue>
              <fields>
                <field>
                  <name>WRITE</name>
                  <description>Write permission for key slot n</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>Disable write to registers KEYSLOT.KEYn.VALUE[0-3]</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>Registers KEYSLOT.KEYn.VALUE[0-3] can be written</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>READ</name>
                  <description>Read permission for key slot n.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>Disable read from registers KEYSLOT.KEYn.VALUE[0-3]</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>Registers KEYSLOT.KEYn.VALUE[0-3] can be read</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>PUSH</name>
                  <description>Push permission for key slot n</description>
                  <lsb>2</lsb>
                  <msb>2</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>Content of registers KEYSLOT.KEYn.VALUE[0-3] can not be pushed, but can be read if field READ is 'Enabled'</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>Content of registers KEYSLOT.KEYn.VALUE[0-3] can be pushed over secure APB. Register KEYSLOT.CONFIGn.DEST must contain a valid destination address!</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>STATE</name>
                  <description>Revocation state for key slot n</description>
                  <lsb>16</lsb>
                  <msb>16</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Revoked</name>
                      <description>Registers KEYSLOTn.KEY.VALUE[0-3] can no longer be read or pushed</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Active</name>
                      <description>Registers KEYSLOTn.KEY.VALUE[0-3] are readable (if enabled) and can be pushed (if enabled)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <dim>128</dim>
            <dimIncrement>0x010</dimIncrement>
            <name>KEY[%s]</name>
            <description>Unspecified</description>
            <headerStructName>UICR_KEYSLOT_KEY</headerStructName>
            <addressOffset>0x400</addressOffset>
            <register>
              <dim>0x4</dim>
              <dimIncrement>0x4</dimIncrement>
              <name>VALUE[%s]</name>
              <description>Description collection: Define bits [31+o*32:0+o*32] of value assigned to key slot n</description>
              <addressOffset>0x000</addressOffset>
              <access>read-write</access>
              <resetValue>0xFFFFFFFF</resetValue>
              <fields>
                <field>
                  <name>VALUE</name>
                  <description>Define bits [31+o*32:0+o*32] of value assigned to key slot n</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
