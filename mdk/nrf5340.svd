        <cluster>
          <dim>27</dim>
          <dimIncrement>0x004</dimIncrement>
          <name>PERIPHID[%s]</name>
          <description>Unspecified</description>
          <headerStructName>SPU_PERIPHID</headerStructName>
          <addressOffset>0x800</addressOffset>
          <register>
            <name>PERM</name>
            <description>Description cluster: List capabilities and Access permissions for the peripheral with ID n</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000012</resetValue>
            <fields>
              <field>
                <name>SECUREMAPPING</name>
                <description>Define configuration capabilities  for TrustZone-M secure attribute</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NonSecure</name>
                    <description>This peripheral is always accessible as a Non-Secure peripheral</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Secure</name>
                    <description>This peripheral is always accessible as a Secure peripheral</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UserSelectable</name>
                    <description>Non-Secure or Secure attribute for this peripheral is defined by the PERIPHID[n].PERM register</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Split</name>
                    <description>This peripheral implements the  split security mechanism. Non-Secure or Secure attribute for this peripheral is defined by the PERIPHID[n].PERM register</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMA</name>
                <description>Indicate if the peripheral has DMA capabilities and if DMA transfer  can be assigned to a different security attribute than the peripheral itself</description>
                <lsb>2</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoDMA</name>
                    <description>Peripheral has no DMA capability</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NoSeparateAttribute</name>
                    <description>Peripheral has DMA and DMA transfers always have the same security attribute as assigned to the peripheral</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SeparateAttribute</name>
                    <description>Peripheral has DMA and DMA transfers can have a different security attribute than the one assigned to the peripheral</description>
                    <value>2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SECATTR</name>
                <description>Peripheral security mapping</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Secure</name>
                    <description>Peripheral is mapped in Secure Peripheral Address space.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NonSecure</name>
                    <description>If SECUREMAPPING == UserSelectable: Peripheral is mapped in Non-Secure Peripheral Address space. If SECUREMAPPING == Split: Peripheral is mapped in Non-Secure and Secure Peripheral Address space.</description>
                    <value>0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMASEC</name>
                <description>Security attribution for the DMA transfer</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Secure</name>
                    <description>DMA transfers initiated by this peripheral have the Secure attribute set.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NonSecure</name>
                    <description>DMA transfers initiated by this peripheral have the Non-Secure attribute set.</description>
                    <value>0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LOCK</name>
                <lsb>8</lsb>
                <msb>8</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Unlocked</name>
                    <description>This register can be updated</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Locked</name>
                    <description>The content of this register can't be changed until the next reset</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PRESENT</name>
                <description>Indicate if a peripheral is present with ID n.</description>
                <lsb>31</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NotPresent</name>
                    <description>Peripheral is not present</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>IsPresent</name>
                    <description>Peripheral is present</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>OSCILLATORS_NS</name>
      <description>Oscillator control 0</description>
      <baseAddress>0x40004000</baseAddress>
      <headerStructName>OSCILLATORS</headerStructName>
      <!--Security dma=NSA-->
      <!--Security securemapping=US-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>OSCILLATORS</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>ATECLOCK</name>
          <description>Analog test bus control for clock modules</description>
          <addressOffset>0x584</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>ROSC32K</name>
              <description>Configure connection of the ROSC32K oscillator  to analog test bus</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>PLL</name>
              <description>Configure connection of PLL to analog test bus</description>
              <lsb>1</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disconnected</name>
                  <description>Disconnect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VC</name>
                  <description>Connect loop filter voltage to ATB0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Osc32MDiv</name>
                  <description>Connect 32 MHz divided clock to ATB1</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Both</name>
                  <description>Connect both VC and Osc32MDiv</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CPUPLL</name>
              <description>Configure connection of the CPU PLL  to analog test bus</description>
              <lsb>3</lsb>
              <msb>4</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disconnected</name>
                  <description>ATB0 in high impedance</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VTUNE</name>
                  <description>Tune voltage VTUNE on ATB0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OSCPLLVHF</name>
                  <description>OSC_PLL_VHF_0V9 on ATB0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Forbidden</name>
                  <description>Forbidden</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSPPLL</name>
              <description>Configure connection of the DSP PLL  to analog test bus</description>
              <lsb>5</lsb>
              <msb>6</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disconnected</name>
                  <description>ATB0 in high impedance</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VTUNE</name>
                  <description>Tune voltage VTUNE on ATB0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OSCPLLVHF</name>
                  <description>OSC_PLL_VHF_0V9 on ATB0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Forbidden</name>
                  <description>Forbidden</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>XOSC32K</name>
              <description>Configure connection of the XOSC32K oscillator  to analog test bus</description>
              <lsb>7</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>AUDIOPLL</name>
              <description>Configure connection of the DSP PLL  to analog test bus</description>
              <lsb>9</lsb>
              <msb>10</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disconnected</name>
                  <description>ATB0 in high impedance</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VTUNE</name>
                  <description>Tune voltage VTUNE on ATB0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OSCPLL</name>
                  <description>OSC_PLL_0V9 on ATB0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OSCPLL140M</name>
                  <description>OSC_PLL_140M_1V2 on ATB0</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>XOSC32MCAPS</name>
          <description>Programmable capacitance of XC1 and XC2.</description>
          <addressOffset>0x5C4</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CAPVALUE</name>
              <description>Capacitor value = 6 + 0.57*CAPVALUE [pF] If disabled, capacitor value = 3.3 [pF]</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Enable on-chip capacitors on XC1 and XC2</description>
              <lsb>8</lsb>
              <msb>8</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Capacitor disabled (use external caps)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Capacitor enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>BYPASSHFXOSC</name>
          <description>Enable or disable bypass of HFCLK crystal oscillator with external clock source</description>
          <addressOffset>0x600</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>BYPASS</name>
              <description>Enable or disable bypass of HFCLK crystal oscillator with external clock source</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable (use with Xtal or low-swing external source)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable (use with rail-to-rail external source)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIOBYPASS</name>
          <description>Enable bypass from GPIO</description>
          <addressOffset>0x604</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>CPUPLL</name>
              <description>Enable bypass from GPIO for the CPU PLL</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Bypass is disabled - CPU PLL is operating normally</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Bypass is enabled - The output signal of the CPU PLL is replaced by the signal applied to the pad</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSPPLL</name>
              <description>Enable bypass from GPIO for the DSP PLL</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Bypass is disabled - DSP PLL is operating normally</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Bypass is enabled - The output signal of the DSP PLL is replaced by the signal applied to the pad</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AUDIOPLL</name>
              <description>Enable bypass from GPIO for the AUDIO PLL</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Bypass is disabled - AUDIO PLL is operating normally</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Bypass is enabled - The output signal of the AUDIO PLL is replaced by the signal applied to the pad</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
