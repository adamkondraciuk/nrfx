                </enumeratedValue>
                <enumeratedValue>
                  <name>YE</name>
                  <description>Counter starts on YE rising edge</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AUTOINC</name>
