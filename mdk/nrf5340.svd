            <description>Audio PLL Frequency from 10.666MHz to 13.333MHz in 3.3ppm steps</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <fields>
              <field>
                <name>FREQUENCY</name>
                <description>Frequency 0: 10.666 MHz 65535: 13.333 MHz</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FREQINC</name>
            <description>Frequency increment</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <fields>
              <field>
                <name>FREQINC</name>
                <description>Signed 8-bit frequency increment, applied to FREQUENCY every FREQINCPERIOD.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FREQINCPERIOD</name>
            <description>Frequency increment period 1us steps</description>
            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <fields>
              <field>
                <name>FREQINCPERIOD</name>
                <description>0: Invalid 1: 1 us period 65535: 65535 us period</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FREQINCENABLE</name>
            <description>Frequency increment enable</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-write</access>
            <fields>
              <field>
                <name>FREQINCENABLE</name>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disable frequency incrementation</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Enable frequency incrementation</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
