        <register>
          <name>IFTIMING</name>
          <description>SPI interface timing. SPI MEM CTRL Read Dummy Cycles reg.</description>
          <addressOffset>0x640</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000200</resetValue>
          <fields>
            <field>
              <name>RDC2IO</name>
              <description>Number of 64 MHz dummy Cycles for READ2IO Instruction (opcode BB).</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>RDC4IO</name>
              <description>Number of 64 MHz dummy Cycles for READ4IO Instruction (opcode EB).</description>
              <lsb>4</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>RXDELAY</name>
              <description>Timing related to sampling of the input serial data. The value of RXDELAY specifies the number of 64 MHz cycles (15.625 ns) delay from the the rising edge of the SPI Clock (SCK) until the input serial data is sampled. As en example, if set to 0 the input serial data is sampled on the rising edge of SCK.</description>
              <lsb>8</lsb>
              <msb>10</msb>
            </field>
          </fields>
        </register>
      </registers>
