                  <description>ADC is ready. No on-going conversion.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>ADC is busy. Conversion in progress.</description>
                  <value>1</value>
