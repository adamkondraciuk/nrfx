            <addressOffset>0x384</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>IQFILTERB4</name>
                <description>Filter Coefficient B4 for Quadrature phase stream. This is a Q10 format (i.e. output of filter is right-shifted by 10 bits) 2's complement value.Relevant when IQ_IMBALANCE_DISABLE = 0.</description>
