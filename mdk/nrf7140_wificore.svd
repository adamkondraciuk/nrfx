            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>RESAMPBYPASS</name>
                <description>Used to set the bypass mode of the Resampler block.When bypass is set the Resampler block is powered down and data passes around it unaltered.When set to Normal the block operates as programmed by the registers that control it.</description>
