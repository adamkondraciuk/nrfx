            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>NCLIPDEEPFIRSTITER</name>
                <description>Number of samples in clip to decide as deep clip condition.</description>
                <lsb>0</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>NCLIPMODERATEFIRSTITER</name>
                <description>Number of samples in clip to determine moderate clip.</description>
                <lsb>11</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FIRSTAGCCUTBACKSETTINGSFIRSTITERATION</name>
