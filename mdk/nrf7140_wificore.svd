            </fields>
          </register>
          <register>
            <name>TBUSRSTCTRL</name>
            <description>EDC PERIP TBUS RST CTRL</description>
            <addressOffset>0xC10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>RESETTBUSID</name>
                <description>Port ID of TBus to reset.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>RESETOFFSETUNPACKER</name>
                <description>Reset Address Generator Offset unpacker.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>RESETTBUSWRUNPACKER</name>
                <description>Reset TBus write unpacker.</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>RESETTBUSRDPACKER</name>
                <description>Reset TBus read packer.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>RESETTBUSRDPORT</name>
                <description>Reset TBus read port data held for next transfer.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PERFCTRL</name>
            <description>EDC PERIP PERF CTRL</description>
            <addressOffset>0xC14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EXTRAMREADAHEAD</name>
                <description>0 : Do not read-ahead from ExtRAM (appropriate setting for multi-channel ExtRAM reads).1 : Read-ahead from ExtRAM (appropriate setting for single-channel ExtRAM reads or multi-channel only where each channel has a unique EXT_RAM_ID in range 0 to EDC_EXT_RAM_REQS-1).For use in high read latency ExtRAM systems, should not be used in low latency ExtRAM systems as can reduce performance due to additional destination address generation latency.When enabled, address generator modes that make use of offsets (run-length, twisted-row-col, FIFO) are not supported for ExtRAM or GRAM TFR_MODE=4 destination transfer from an ExtRAM source TFR_MODE=1 transfer.ExtRAM-to-ExtRAM transfers are not supported when enabled.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCSCPCTRL</name>
            <description>EDC SCP CTRL</description>
            <addressOffset>0xC18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EDCSCPKICK</name>
                <description>EDC_SCP_KICK[n]=1 causes update of SET_ADC_POWER/SET_SCP_POWER/NEW_ADC_POWER/NEW_SCP_POWER/INPUT_I/INPUT_Q registers within SCP[n] when SCP_CONTROL2[n].SCP_KICK_ENABLE=1.Register auto-clears.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCDCPBASEADDR</name>
            <description>EDC DCP BASE ADDR</description>
            <addressOffset>0xC1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>DCPBASEADDR</name>
                <description>Base address of combined DCP code image (for use by debugger).</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANRXCTRL</name>
            <description>EDC PERIP WLAN RX CTRL</description>
            <addressOffset>0xC20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANRXFINAL</name>
                <description>Set to flag last Rx Job before posting final SCP input transfer.Must be cleared following completion of SCP input job.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXCTRL</name>
            <description>EDC PERIP WLAN TX CTRL</description>
