            <fields>
              <field>
                <name>EXTRAMID1ADDRMSBSEXT</name>
                <description>Defines bits 61:38 of ExtRAM request ID 1 word address (bits 63:40 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
