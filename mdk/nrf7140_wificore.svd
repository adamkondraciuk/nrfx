                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDPKTSIZEACT</name>
            <description>This register holds the value that controller is using for VID_PKT_SIZE.</description>
            <addressOffset>0x13C</addressOffset>
