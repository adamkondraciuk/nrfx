            <addressOffset>0x60</addressOffset>
            <access>read-write</access>
            <resetValue>0x0000001D</resetValue>
            <fields>
              <field>
                <name>WLANRTMRSSICONVFACTOR</name>
                <description>The LTF-RSSI conversion factor. s7.0This factor represents the conversion from voltage domain (power in dBm) in analog to digital representation of IQ's.LTF_RSSI_DBM = LTF_POWER_DB - AGC_GAIN_DB - DGC_GAIN_DB - WLAN_RTM_RSSI_CONV_FACTOR</description>
                <lsb>0</lsb>
