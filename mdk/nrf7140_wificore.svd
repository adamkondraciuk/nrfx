          <register>
            <name>RESAMPLINGFACTORBASE</name>
            <description>SCP RESAMPLING FACTOR BASE</description>
            <addressOffset>0x120</addressOffset>
            <access>read-write</access>
            <resetValue>0x00800000</resetValue>
            <fields>
              <field>
                <name>RESAMPBASE</name>
                <description>Resampling factor base. This is an unsigned value which is combined with the 2's complement RESAMP_CONTROL to generate the 26-bit control Fs:Fs = (RESAMP_BASE &amp;lt;&amp;lt; 23) + RESAMP_CONTROLFs is the sample conversion ratio (I / O) used in the sample rate conversion section of the SCP.Fs is an unsigned number, where the full-scale range of values is 1 / (2^25) to ((2^26) - 1) / (2^25) = 2.98023224E-08 to 1.99999997NOTE: To convert a ratio into the 26-bit Fs, multiply by 2^25</description>
                <lsb>21</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RESAMPLINGFACTORCONTROL</name>
            <description>SCP RESAMPLING FACTOR CONTROL</description>
            <addressOffset>0x124</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>RESAMPCONTROL</name>
                <description>Resampling factor control. This is a 2's complement value which is combined with RESAMP_BASE to generate the 26-bit control Fs:Fs = (RESAMP_BASE &amp;lt;&amp;lt; 23) + RESAMP_CONTROL</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
