            <register>
              <name>CONTROL</name>
              <description>Description cluster: EDC SYS CONTROL</description>
              <addressOffset>0x00</addressOffset>
              <access>read-write</access>
              <resetValue>0x80000003</resetValue>
              <fields>
                <field>
                  <name>STATE</name>
                  <description>Read-only status:</description>
                  <lsb>0</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Running</name>
                      <description>RUNning</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Waiting</name>
                      <description>WAITing</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Stepping</name>
                      <description>STEPping</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Halted</name>
                      <description>HALTed</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DMAACTIVE</name>
                  <description>Read-only status:</description>
                  <lsb>2</lsb>
                  <msb>2</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NoActiveDmaJobInstr</name>
                      <description>No active DMA job, instruction stream processing can continue.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ActiveDmaJobInstruc</name>
                      <description>Active DMA job, instruction stream processing stalled until completion.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>LATCHEDDCPRESET</name>
                  <description>Latched DCP thread software reset.</description>
                  <lsb>27</lsb>
                  <msb>27</msb>
                </field>
                <field>
                  <name>PULSEDDCPRESET</name>
                  <description>Self-clearing DCP thread software reset.</description>
                  <lsb>28</lsb>
                  <msb>28</msb>
                </field>
                <field>
                  <name>RUN</name>
                  <description>Set to 1 to start execution of the instruction stream from the current PC</description>
                  <lsb>29</lsb>
                  <msb>29</msb>
                </field>
                <field>
                  <name>STEP</name>
                  <description>Set to 1 to STEP by one instruction. This bit takes precedence over RUN</description>
                  <lsb>30</lsb>
                  <msb>30</msb>
                </field>
                <field>
                  <name>HALT</name>
                  <description>Set to 1 to HALT instruction stream. This bit takes precedence over STEP and RUN</description>
                  <lsb>31</lsb>
                  <msb>31</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>PC</name>
              <description>Description cluster: EDC SYS PC</description>
              <addressOffset>0x04</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <fields>
                <field>
                  <name>PC</name>
                  <description>The memory address from which the next instruction will be loaded</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <dim>64</dim>
            <dimIncrement>0x008</dimIncrement>
            <name>EDCSYSDEBUGREGS[%s]</name>
            <description>Unspecified</description>
