            <addressOffset>0xC08</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>GPIO0IN</name>
                <description>Value input on bits 15:0 of UCCP top level GPIO_IN pins.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCGPIO1IN</name>
