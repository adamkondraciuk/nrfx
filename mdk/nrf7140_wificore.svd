        </cluster>
        <cluster>
          <name>WLAN_ED</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WLAN_ED</headerStructName>
          <access>read-write</access>
          <addressOffset>0x09000</addressOffset>
          <register>
            <name>CONTROLREGISTER</name>
            <description>WLAN ED CONTROL REGISTER</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>RESET</name>
                <description>1: Asserts reset0: De-asserts reset</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>ENABLE</name>
                <description>1: Enables ED module0: Disables ED module</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>AGCESTTRIGGERMETHOD</name>
                <description>Defines the AGC trigger method.'0' -Agc estimation process starts only after ED done'1' -Agc is free running and starts adjusting gain value if absolute difference in RSSI and target value is more than threshold.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>ENABLEMIDPACKETDET</name>
                <description>When set Mid-Packet detection is enabled; otherwise only DSSS and OFDM packets will be detected.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WAITCOUNTER</name>
            <description>WLAN ED WAIT COUNTER</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WAITCOUNT</name>
                <description>Number of data samples for which module waits before it actually starts processing.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>THRESHSETTINGS</name>
            <description>WLAN ED THRESH SETTINGS</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EDTHRESHOLD</name>
                <description>RSSI Threshold in dBm corresponding to sensitivity required. Signal crossing this threshold indicates energy in the channel.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ESTIMATIONLENGTH</name>
            <description>WLAN ED ESTIMATION LENGTH</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>ESTIMATIONLENGTH</name>
                <description>No of symbols to be averaged to Estimate Average variance.0: 1 symbol, 1: 2 symbols, 2: 4 symbols, 3: 8 symbols</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>BARKERCORRELATIONSETTINGS</name>
            <description>WLAN ED BARKER CORRELATION SETTINGS</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>BARKERCORRENABLE</name>
                <description>1: Enables Barker correlationThis correlation is performed on data stream-1.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>DSSSCORRTHRESMANTISSA</name>
                <description>DSSS Correlation Threshold:Represents 8 bit Mantissa value of Threshold.</description>
                <lsb>1</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>DSSSCORRTHRESEXPONENT</name>
                <description>DSSS Correlation Threshold:Represents 8 bit Exponent value of Threshold.</description>
                <lsb>9</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CCATHRESPRIM20</name>
            <description>WLAN ED CCA THRES PRIM20</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CCABUSYTHRESHPRIM20</name>
                <description>Signal level in dB corresponding to CCA threshold in the primary 20MHz channel. The threshold is given in 2's complement form.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CCATHRESSECONDARY</name>
            <description>WLAN ED CCA THRES SECONDARY</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CCABUSYTHRESHSEC20</name>
                <description>Signal level in dB corresponding to CCA threshold in the secondary 20MHz channel. The threshold is given in 2's complement form.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>CCABUSYTHRESHSEC40</name>
                <description>Signal level in dB corresponding to CCA threshold in the secondary 40MHz channel. The threshold is given in 2's complement form.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DYNAMICEDSETTINGS</name>
            <description>WLAN ED DYNAMIC ED SETTINGS</description>
            <addressOffset>0x1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>DYNAMICEDENABLE</name>
                <description>1-Enable, 0-Disable</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>MARGINTOTRIGINTR</name>
                <description>If the energy found over all the NUM_SYMB_DYNAMIC_ED symbols is consistently below the ED threshold an interrupt is generated. Field is valid only when dynamic ED is enabled. 0: 0dB, 1: 1dB, 2: 2 dB15: 15 dB.</description>
                <lsb>1</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>NUMSYMBDYNAMICED</name>
                <description>Number of Symbols to determine Average Energy. Valid only when Dynamic ED is enabled.0: 1 symbol, 1: 2 symbols, 2: 4 symbols, 3: 8 symbols, 4:16 symbols, 5: 32 symbols, 6: 64 symbols, 7: 128 symbols</description>
                <lsb>7</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>NUMSYMBDYNAMICEDINITSKIP</name>
                <description>This specifies the number of consecutive below-threshold events to skip, before starting the count for low energy event. Can take values from 0 to 7. Suppose the value is 3 then it skips first 3 consecutive below-threshold symbols, then proceeds to count for generating low energy event. If the below-threshold events are not consecutive then the count is reset.</description>
                <lsb>10</lsb>
                <msb>12</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EVENTSTATUS</name>
            <description>WLAN ED EVENT STATUS</description>
            <addressOffset>0x20</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>LOWENERGYEVENT</name>
                <description>1: Event status. Asserted when energy is below a threshold by a margin</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>DSSSCORROVEREVENT</name>
                <description>This field will be set once the correlation is done over desired number of symbols after assertion of AGC done signal.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>S2LDONEEVENT</name>
                <description>'1' - S2L processing is over.'0' - S2L processing is not over.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>OFDMCORRORPOPEVENT</name>
                <description>This event status register holds the status of post AGC OFDM correlation completion if AGC_EST_TRIGGER_METHOD is 0 or packet over packet detection event if AGC_EST_TRIGGER_METHOD is 1.'1' - Event detected.'0' - Event not detected.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>STARTSCPOUTPUTEVENT</name>
                <description>This event register holds the status of the SCP output and indicates when the SCP output was set valid.'1' - Event detected.'0' - Event not detected.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>POSTAGCESTEVENT</name>
                <description>This event register holds the status of the post AGC estimations being valid.'1' - Event detected.'0' - Event not detected.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EVENTCLR</name>
            <description>WLAN ED EVENT CLR</description>
            <addressOffset>0x24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>LOWENERGYEVENTCLR</name>
                <description>Clears low energy event</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>DSSSCORROVEREVENTCLR</name>
                <description>Clears DSSS correlation event</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>S2LDONEEVENTCLR</name>
                <description>Clears the S2L done Event.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>OFDMCORRORPOPEVENTCLR</name>
                <description>This event clear register resets the status of post AGC OFDM correlation completion or packet over packet detection event.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>STARTSCPOUTPUTEVENTCLR</name>
                <description>This event clear register resets the status of the SCP output event.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
