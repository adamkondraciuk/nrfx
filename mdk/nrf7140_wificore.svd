            <addressOffset>0x378</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000007</resetValue>
            <fields>
              <field>
                <name>IQINPHASEDELAY</name>
                <description>Delay line for Inphase stream. This is a unsigned value.The maximum supported value is 14.Relevant when IQ_IMBALANCE_DISABLE = 0.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
            </fields>
