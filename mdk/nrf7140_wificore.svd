                <lsb>0</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANTIMERSINTSTATUSRAW</name>
                <description>General purpose raw interrupt status register.</description>
                <lsb>12</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>INTEN</name>
