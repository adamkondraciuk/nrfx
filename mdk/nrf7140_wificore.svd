                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x40</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>JOB0[%s]</name>
            <description>Description collection: EDC PERIP JOB0</description>
            <addressOffset>0xD00</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EXTRAMID</name>
                <description>ExtRAM request ID used for ExtRAM transfers on this channel.Note: DCP uses ID of 0 for instruction fetch and loads/stores.</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>FORCEFLEXIBLEAGEN</name>
                <description>Note: if EDC_SYS_CONFIGURATION_STATUS[0] = '0', this register is notpresent.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotUseFlexibleAddr</name>
                    <description>Do not use flexible address generator when linear mode is configured.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ForceUsageOfFlexible</name>
                    <description>Force usage of flexible address generator (over linear address generator) even if linear mode is configured.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OFFSETINCR</name>
                <description>Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[1] = '1'.</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>AdvanceOffsetEveryGr</name>
                    <description>Advance offset every GRAM access.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AdvanceOffsetEvery2G</name>
                    <description>Advance offset every 2 GRAM accesses.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AdvanceOffsetEvery4G</name>
                    <description>Advance offset every 4 GRAM accesses.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AdvanceOffsetEvery8G</name>
                    <description>Advance offset every 8 GRAM accesses.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OFFSETADD</name>
                <description>0: Disable addition of offsets to GRAM addresses.1: Enable addition of offsets to GRAM addresses.Notes:1. This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[1] = '1'.2. Only ITEM_BYTES = '10' is supported.3. Modulo wrap of item index is not supported.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>OFFSETDELTA</name>
                <description>Defines the delta to be added to MA in case of GRAM accesses with OFFSET_ADD = 1 and OFFSET_INCR &amp;gt; 0.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[1] = '1'.</description>
                <lsb>7</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>HOLDOFFSAT</name>
                <description>Indicates that the transfer hold-off FINE_RATE accumulator has saturated.Automatically cleared at start of next DMA job.</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>FLAGDONETIMING</name>
                <description>Note: Channel DISCARD_OP/PW/PALIGN settings cannot be changed safely following completion of a TBus write job when FLAG_DONE_EARLY=1 because these are used following the output buffer.</description>
                <lsb>22</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FlagCompletionOfTbus</name>
                    <description>Flag completion of TBus write job on output to peripheral.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FlagCompletionOfTbus1</name>
                    <description>Flag completion of TBus write job on write to output buffer, providing additional time to configure subsequent jobs for realtime output peripherals (e.g. DAC, TSO).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FlagCompletionOfTran</name>
                    <description>Flag completion of transfer to ExtRAM/GRAM/PBus/SysBus only once final store has reached destination.This could impact performance.Not supported for write to EDC channel or write to TBus transfer modes (TFR_MODE=001,011,110 or TFR_MODE=000,101,111 &amp;amp;&amp;amp; PER_BUS=0).</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETLUTADDR</name>
            <description>EDC OFFSET LUT ADDR</description>
            <addressOffset>0xE00</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>OFFSETLUTADDR</name>
                <description>Offset lookup table address. Automatically incremented when all the entries (number of entries per location = GRAM_REQS-1) at the same address have been written.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETLUTDATA</name>
            <description>EDC OFFSET LUT DATA</description>
            <addressOffset>0xE04</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>OFFSETLUTDATA</name>
                <description>Offset lookup table value to be written into the offset LUT.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETADJLUTADDR</name>
            <description>EDC OFFSET ADJ LUT ADDR</description>
            <addressOffset>0xE08</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>OFFSETADJLUTADDR</name>
                <description>Offset adjustment lookup table address. Automatically incremented.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETADJLUTDATA</name>
            <description>EDC OFFSET ADJ LUT DATA</description>
            <addressOffset>0xE0C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>OFFSETADJLUTDATA</name>
                <description>Offset adjustment lookup table value to be written into the offset adjustment LUT.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETADJLUTCTRL</name>
            <description>EDC OFFSET ADJ LUT CTRL</description>
            <addressOffset>0xE10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>OFFSETADJENABLE</name>
                <description>Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DisableAdditionOfOff</name>
                    <description>Disable addition of offset adjustments to GRAM addresses.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EnableAdditionOfOffs</name>
                    <description>Enable addition of offset adjustments to GRAM addresses.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OFFSETADJCHANNEL</name>
                <description>Select which EDC channel the offset adjustments are applied to.Note: Selected EDC channel must be configured for offset addressing OFFSET_ADD=1.</description>
                <lsb>4</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>OFFSETADJMULFACTOR</name>
                <description>Defines the multiplication factor used for the offset adjustments.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>12</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x4</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>L4CHECKSUMCTRL[%s]</name>
            <description>Description collection: EDC PERIP L4 CHECKSUM CTRL</description>
            <addressOffset>0xE40</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>L4CSUMBLOCKENABLE</name>
                <description>Enable signal for L4 checksum block:</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumBlockDisab</name>
                    <description>L4 checksum block disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L3ChecksumBlockEnabl</name>
                    <description>L3 checksum block enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L3CSUMENABLE</name>
                <description>Enable signal for L3 checksum calculation in case of IPV4 ethernet type:</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L3ChecksumCalculatio</name>
                    <description>L3 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L3ChecksumCalculatio1</name>
                    <description>L3 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L4CSUMIPV4TCPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV4 ethernet type and TCP protocol:</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L4CSUMIPV4UDPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV4 ethernet type and UDP protocol:</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L4CSUMIPV6TCPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV6 ethernet type and TCP protocol:</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L4CSUMIPV6UDPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV6 ethernet type and UDP protocol:</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CSUMOP</name>
                <description>L4 checksum operation:0:TX operation. L3 and L4 checksums are calculated,1:RX operation. L3 and L4 checksums are calculated and compared with thecorresponding received checksum values.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>MACHEADERLENGTH</name>
                <description>MAC header length in bytes.This is the number of bytes at the start of packet that are skipped and notincluded in the L4 checksum calulation.Note: only even values for MAC header lengths are supported.</description>
                <lsb>7</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>EDCCHANNELSELECT</name>
                <description>EDC channel select.Selects the EDC channel connected to L4 checksum instance.</description>
                <lsb>15</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
          <cluster>
            <dim>4</dim>
            <dimIncrement>0x00C</dimIncrement>
            <name>EDCPERIPL4CHECKSUMSTATUS[%s]</name>
            <description>Unspecified</description>
            <headerStructName>RPUPBUS_EDC_PERIP_EDCPERIPL4CHECKSUMSTATUS</headerStructName>
            <access>read-write</access>
            <addressOffset>0xE50</addressOffset>
            <register>
              <name>L3CHECKSUMTX</name>
              <description>Description cluster: EDC PERIP L3 CHECKSUM TX</description>
              <addressOffset>0x000</addressOffset>
              <access>read-only</access>
              <resetValue>0x0000FFFF</resetValue>
              <fields>
                <field>
                  <name>L3CHECKSUMTX</name>
                  <description>Calculated L3 checksum.Note: L3 checksum is calculated only for IPV4 ethernet type.This register will hold calculated L3 checksum value for both operations TX and RX andit will be cleared at the start of every new packet.Note: This field should be read once the TX_CHECKSUM_VALID flag is asserted in TX operation.In RX operation this value can be used for debug and checked after RX_CHECKSUM_VALID flag assertion.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L3CHECKSUMTXOFFSET</name>
                  <description>L3 checksum TX offset.This field gives the information on offset of L3 checksum within the packet.</description>
                  <lsb>16</lsb>
                  <msb>20</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMTX</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM TX</description>
              <addressOffset>0x004</addressOffset>
              <access>read-only</access>
              <resetValue>0x0000FFFF</resetValue>
              <fields>
                <field>
                  <name>L4CHECKSUMTX</name>
                  <description>Calculated L4 checksum.This field will hold calculated L4 checksum value for both operations TX and RXand it will be cleared at the start of every new packet.Note: This field should be read once the TX_CHECKSUM_VALID flag is asserted in TX operation.In RX operation this value can be used for debug and checked after RX_CHECKSUM_VALID flag assertion.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L4CHECKSUMTXOFFSET</name>
                  <description>L4 checksum TX offset.This field gives the information on offset of L4 checksum within the packet.</description>
                  <lsb>16</lsb>
                  <msb>22</msb>
                </field>
                <field>
                  <name>TXCHECKSUMVALID</name>
                  <description>TX checksum valid flag.This bit gets set once the L4 checksum calculation for TX operation is completedand it will be cleared at the start of every new packet.</description>
                  <lsb>23</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMTXRXSTATUS</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM TX RX STATUS</description>
              <addressOffset>0x008</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <fields>
                <field>
                  <name>RXCHECKSUMSTATUS</name>
                  <description>RX checksum status flag.Note: This bit should be checked once the RX_CHECKSUM_VALID flag is asserted.It will be cleared at the start of every new packet.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>FailCalculatedL4Che</name>
                      <description>FAIL - Calculated L4 checksum and L4 checksum extracted from packet header are mismatching,</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PassCalculatedL4Che</name>
                      <description>PASS - Calculated L4 checksum and L4 checksum extracted from packet header are matching.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>CHECKSUMINFO</name>
                  <description>TX_RX checksum info flag.Note: This bit is used for both TX and RX operation.It will be cleared at the start of every new packet.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>CalculationOfL4Check</name>
                      <description>Calculation of L4 checksum was skipped,</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>L4ChecksumCalculated</name>
                      <description>L4 checksum calculated and was not skipped.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>RXCHECKSUMVALID</name>
                  <description>RX checksum valid flag.This bit gets set once the L4 checksum calculation for RX operation is completedand L4 checksum status is ready. It will be cleared at the start of every new packet.</description>
                  <lsb>2</lsb>
                  <msb>2</msb>
                </field>
              </fields>
            </register>
          </cluster>
