                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTXE</name>
              <description>Detect DMU Element Service</description>
              <lsb>23</lsb>
              <msb>23</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Queueing of DMU Element does not activate interrupt flag</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Queueing of DMU Element will activate interrupt flag when DMUI.EHS = DMUI.DEHS</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EHS</name>
              <description>Element Handler State</description>
              <lsb>24</lsb>
              <msb>26</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>wait4cce</name>
                  <description>wait for bit MCAN:CCCR.CCE getting zero</description>
                  <value>0x0</value>
