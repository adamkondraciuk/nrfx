            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANLDPCDECODERCODE</name>
                <description>Select LDPC code:0: Codeword length 648 rate 1/21: Codeword length 648 rate 2/32: Codeword length 648 rate 3/43: Codeword length 648 rate 5/64: Codeword length 1296 rate 1/25: Codeword length 1296 rate 2/36: Codeword length 1296 rate 3/47: Codeword length 1296 rate 5/68: Codeword length 1944 rate 1/29: Codeword length 1944 rate 2/310: Codeword length 1944 rate 3/411: Codeword length 1944 rate 5/612-15: Reserved</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ITERATIONS</name>
