                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>recovery</name>
                  <description>exception recovery</description>
                  <value>0x5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TX</name>
