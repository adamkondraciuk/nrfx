            <addressOffset>0xC8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>NEXTLNASTAGEIFCURRMODE6RFRSSI0</name>
                <description>This register holds the next LNA stage, if the RF RSSI (3-bit) is '0'.</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>NEXTLNASTAGEIFCURRMODE6RFRSSI1</name>
                <description>This register holds the next LNA stage, if the RF RSSI (3-bit) is '1'.</description>
                <lsb>3</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>NEXTLNASTAGEIFCURRMODE6RFRSSI2</name>
                <description>This register holds the next LNA stage, if the RF RSSI (3-bit) is '2'.</description>
                <lsb>6</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>NEXTLNASTAGEIFCURRMODE6RFRSSI3</name>
                <description>This register holds the next LNA stage, if the RF RSSI (3-bit) is '3'.</description>
                <lsb>9</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>NEXTLNASTAGEIFCURRMODE6RFRSSI4</name>
                <description>This register holds the next LNA stage, if the RF RSSI (3-bit) is '4'.</description>
                <lsb>12</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>NEXTLNASTAGEIFCURRMODE6RFRSSI5</name>
                <description>This register holds the next LNA stage, if the RF RSSI (3-bit) is '5'.</description>
                <lsb>15</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>NEXTLNASTAGEIFCURRMODE6RFRSSI6</name>
                <description>This register holds the next LNA stage, if the RF RSSI (3-bit) is '6'.</description>
                <lsb>18</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>NEXTLNASTAGEIFCURRMODE6RFRSSI7</name>
                <description>This register holds the next LNA stage, if the RF RSSI (3-bit) is '7'.</description>
                <lsb>21</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AACIDETSETTINGSREG1</name>
            <description>WLAN AGC AACI DET SETTINGS REG 1</description>
            <addressOffset>0xCC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>MINRSSILNAGAINMODE1</name>
                <description>This field represents the min rssi for the LNA gain mode 1. If the RSSI of the input signal is below this value, the AGC would never have come to this gain modein the first place. This value is configure from the LNA switch point information.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>MINRSSILNAGAINMODE2</name>
                <description>This field represents the min rssi for the LNA gain mode 2. If the RSSI of the input signal is below this value, the AGC would never have come to this gain modein the first place. This value is configure from the LNA switch point information.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>MINRSSILNAGAINMODE3</name>
                <description>This field represents the min rssi for the LNA gain mode 3. If the RSSI of the input signal is below this value, the AGC would never have come to this gain modein the first place. This value is configure from the LNA switch point information.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AACIDETSETTINGSREG2</name>
            <description>WLAN AGC AACI DET SETTINGS REG 2</description>
            <addressOffset>0xD0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>MINRSSILNAGAINMODE4</name>
                <description>This field represents the min rssi for the LNA gain mode 4. If the RSSI of the input signal is below this value, the AGC would never have come to this gain modein the first place. This value is configure from the LNA switch point information.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>MINRSSILNAGAINMODE5</name>
                <description>This field represents the min rssi for the LNA gain mode 5. If the RSSI of the input signal is below this value, the AGC would never have come to this gain modein the first place. This value is configure from the LNA switch point information.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>MINRSSILNAGAINMODE6</name>
                <description>This field represents the min rssi for the LNA gain mode 6. If the RSSI of the input signal is below this value, the AGC would never have come to this gain modein the first place. This value is configure from the LNA switch point information.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AACIDETTHRESHOLD</name>
            <description>WLAN AGC AACI DET THRESHOLD</description>
            <addressOffset>0xD4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AACIDETTHRESHOLD</name>
                <description>This field represents the threshold in the below equation:if (MIN_RSSI(LNA_GAIN_MODE) - AGC rssi &amp;gt; AACI_DET_THRESHOLD)then, AACI detected in AGC module.Where MIN_RSSI(LNA_GAIN_MODE) is the value in the config register, corresponding to the LNA gain mode at which the AGC converged during the LNA gain search stage. Unsigned value, maximum 127.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>LNAGAINCTRLSETTINGS</name>
            <description>WLAN AGC LNA GAIN CTRL SETTINGS</description>
            <addressOffset>0xD8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <fields>
              <field>
                <name>LASTLNASTAGEBEFOREEXIT</name>
                <description>This register is used only when LUT based LNA mode search is used.This is the LNA stage after reaching which further LNA mode search is aborted. This this the last usable LNA mode. This is used in the case where the RF contains less than 6 LNA stages. If the usable LNA stage values starting from highest to lowest is 4 down to 0, then we have to configure this register to 4.</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>LNAGAINCTRLMODE</name>
                <description>There are three modes of LNA gain control.'0' - Legacy mode of LNA gain control based on 1 bit RF RSSI via RF controller interface.'1' - New 3-bit RF RSSI + LUT based LNA gain control that directly interfaces with RF.'2' - External LNA gain control using the SLGC module.</description>
                <lsb>3</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>LNAGAINSETTLINGTIME</name>
                <description>This is the duration in terms of ADC sample periods, that we need to wait before issuing start for the RSSI averaging. This wait time allows for the new LNA gain stage to settle down.</description>
                <lsb>5</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>RFRSSILNASATTHRES</name>
                <description>This the value of the threshold, equal to or less than which the average RF RSSI Status has to be if the LNA is considered to be not-saturating. Can be any value from 0 to 7.</description>
                <lsb>13</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>DISBBADJFORSLGCLNAADJWHENFREEZE</name>
                <description>This bit will disable the logic which will trigger BB gain adjust (to keep the total gain constant) when BT trigger has caused an LNA change. This logic sits outside the AGC trigger disable(freeze).'0' - BB gain adjust enabled (when LNA gain change detected).'1' - BB gain adjust disabled(when LNA gain change detected).</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>DISBBADJFORSLGCLNAADJWHENNOFREEZE</name>
                <description>This bit will disable the logic which will trigger BB gain adjust (to keep the total gain constant) when BT trigger has caused an LNA change. This logic sits inside the AGC trigger disable(freeze). This means that when this bit is enabled, when AGC is not in freeze and an external SLGC LNA gain adj start is detected, we'll wait for SLGC LNA gain adj done and if an LNA gain change is detected we'll do a corresponding BB gain change to keep the total gain constant.'0' - BB gain adjust enabled (when LNA gain change detected).'1' - BB gain adjust disabled(when LNA gain change detected).</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>INITLNAGAIN</name>
                <description>Setting the initial LNA gain stage. This is 3-bit value, that needs to specify the LNA stage in terms of the original LNA gain stage specification format used by RF.</description>
                <lsb>18</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGMODERFRSSISTATUSIN</name>
            <description>WLAN AGC DEBUG MODE RF RSSI STATUS IN</description>
            <addressOffset>0xDC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>DEBUGRFRSSISTATUSIN</name>
                <description>This value of 3-bit RF RSSI status will be used to bypass the corresponding port value if DEBUG_MODE_RF_RSSI_INPUT_EN is '1'.</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>DEBUGRFRSSISTATUSVALID</name>
                <description>This value of RF RSSI valid will be used to bypass the corresponding port value if DEBUG_MODE_RF_RSSI_INPUT_EN is '1'.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AACIDETSETTINGSREG3</name>
            <description>WLAN AGC AACI DET SETTINGS REG 3</description>
            <addressOffset>0xE0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AACIDETAGCVARESTTOLERANCE</name>
                <description>This value of 4-bit unsigned is the tolerance in dB of the AGC variance estimation. This is used in the logic that decides when to get out of AACI in progress state. If the live AGC variance in dB is less than the AGC AACI variance - tolerance, this indicates the original signal that triggered AACI detection has disappeared, so the AACI detection FSM will de-assert AACI_Detected and will get out of AACI_IN_PROG_STATE state.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>ENAACIDISAPPDETLOGIC</name>
                <description>This bit set to '1' enables the logic that sets up the disappearance detection mechanism, so that, when the AACI signal disappears (causing a fall in the AGC RSSI), a AACI_DISAPP_TRIG is generated, which causes AGC re-estimation. By this way, the LNA stage can be returned to the MAX LNA gain stage.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>AACITARGETLEVELDB</name>
                <description>This is the target level in dB (max 54dB and min 0dB) that we want the AACI signal to be placed at (in the digital variance domain), when we enable the disappearance trigger logic. This should be set in such a way so as to accomodate inband signals that have power greater than AACI leakage power to be detected, at the same time to keep the variance in dB high enough to detect a fall in variance (indicating disappearance of AACI signal). For example, a value of 30dB will give a head room of 15dB for inband signals to be decoded and still be high enough to indicate disappearance of AACI signal.</description>
                <lsb>5</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WAITBEFOREAACIDISAPPSETUP</name>
                <description>Number of symbols (each ESTIMATION_LENGTH duration) that the AGC needs to wait after AACI detection before starting to setup the disappearance logic. For eg. if the ESTIMATION_LENGTH is 0.4us and this reg value is 10, then it waits for 10 symbol ends, equivalent to 4us, before starting the disappearance detection logic. This is used when the AGC is working in external LGC mode when the LNA gain cannot be incremented immediately after trigger as that would interfere with the BT module's packet detection/decoding. This helps in giving the BT module sufficient time to assert freeze.</description>
                <lsb>13</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>RFRSSISTEPSIZEDB</name>
                <description>The step size in dB of RF RSSI status value. This is used in the equation:LNA_IP_RSSI_EST = MIN_RSSI_LNA_GAIN_MODE + RF_RSSI_AVG**RF_RSSI_STEP_SIZE_DB.RF_RSSI_AVG (= RF_RSSI_STATUS) is the value of RF RSSI value measured with the LNA_GAIN_MODE. The step size is an unsigned value.</description>
                <lsb>19</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RFNOISEFLOORREG1</name>
            <description>WLAN AGC RF NOISE FLOOR REG 1</description>
            <addressOffset>0xE4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>NOISEFLOORLNASTAGE0</name>
                <description>This value of 8-bit signed is the noise floor expressed in dBm. Please note this depends on the operating bandwidth so has to be reconfigured when OBW changes.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>NOISEFLOORLNASTAGE1</name>
                <description>This value of 8-bit signed is the noise floor expressed in dBm. Please note this depends on the operating bandwidth so has to be reconfigured when OBW changes.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>NOISEFLOORLNASTAGE2</name>
                <description>This value of 8-bit signed is the noise floor expressed in dBm. Please note this depends on the operating bandwidth so has to be reconfigured when OBW changes.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RFNOISEFLOORREG2</name>
            <description>WLAN AGC RF NOISE FLOOR REG 2</description>
            <addressOffset>0xE8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>NOISEFLOORLNASTAGE3</name>
                <description>This value of 8-bit signed is the noise floor expressed in dBm. Please note this depends on the operating bandwidth so has to be reconfigured when OBW changes.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>NOISEFLOORLNASTAGE4</name>
                <description>This value of 8-bit signed is the noise floor expressed in dBm. Please note this depends on the operating bandwidth so has to be reconfigured when OBW changes.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>NOISEFLOORLNASTAGE5</name>
                <description>This value of 8-bit signed is the noise floor expressed in dBm. Please note this depends on the operating bandwidth so has to be reconfigured when OBW changes.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGSIGNALS</name>
            <description>WLAN AGC DEBUG SIGNALS</description>
            <addressOffset>0xF8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANAGCDEBUGRSSIAVGSTART</name>
                <description>Overridden RSSI_AVG_START value applicable when WLAN_AGC_DEBUG_FORCE_OUTPUT_SIGNALS is set.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANAGCDEBUGLNAINCR</name>
                <description>Overridden WLAN_INCR value applicable when WLAN_AGC_DEBUG_FORCE_OUTPUT_SIGNALS is set.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANAGCDEBUGDECR</name>
                <description>Overridden WLAN_DECR value applicable when WLAN_AGC_DEBUG_FORCE_OUTPUT_SIGNALS is set.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLANAGCDEBUGFREEZE</name>
                <description>Overridden WLAN_FREEZE value applicable when WLAN_AGC_DEBUG_FORCE_OUTPUT_SIGNALS is set.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANAGCDEBUGTRIGGER</name>
                <description>Overridden WLAN_TRIGGER value applicable when WLAN_AGC_DEBUG_FORCE_OUTPUT_SIGNALS is set.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLANAGCDEBUGLNAADJINPROGRESS</name>
                <description>Overridden LNA_ADJ_IN_PROGRESS value applicable when WLAN_AGC_DEBUG_FORCE_INPUT_SIGNALS is set.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANAGCDEBUGLNASTAGE</name>
                <description>Overridden LNA_STAGE value applicable when WLAN_AGC_DEBUG_FORCE_INPUT_SIGNALS is set.</description>
                <lsb>6</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>WLANAGCDEBUGFORCEINPUTSIGNALS</name>
                <description>When set input and data signals are overriden with the fields below.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>WLANAGCDEBUGFORCEOUTPUTSIGNALS</name>
                <description>When set output signals are overriden with the fields below.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGLNAGAIN</name>
            <description>WLAN AGC DEBUG LNA GAIN</description>
            <addressOffset>0xFC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>LNAGAINFORCE</name>
                <description>Enable debug mechanism for forcing agc_lna_gain_stage signal.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>LNAGAINVALUE</name>
                <description>Sets value of agc_lna_gain_stage when LNA_GAIN_FORCE is raised.</description>
                <lsb>1</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>WLAN_VITERBI</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WLAN_VITERBI</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0B000</addressOffset>
          <register>
            <name>CONTROL0</name>
            <description>WLAN VITERBI CONTROL0</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000010</resetValue>
            <fields>
              <field>
                <name>WLANVITERBIDONEEFCLEAR</name>
                <description>0 : Do nothing1 : Clear the event flag WLAN_VITERBI_DONE_EF_STATUSThis bit automatically returns to 0</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>LATCHEDSOFTWARERESET</name>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RemoveReset</name>
                    <description>Remove reset</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ApplyReset</name>
                    <description>Apply reset</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PULSEDSOFTWARERESET</name>
                <description>0 : Do nothing1 : Apply a pulsed software resetThis bit is automatically returns to 0</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>MINSTATETRACEBACK</name>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>TraceBackFromZeroSta</name>
                    <description>Trace back from zero state</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TraceBackFromMinimum</name>
                    <description>Trace back from minimum state</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PUNCTURERATE</name>
                <description>PUNCTURE_RATEOptions are</description>
                <lsb>8</lsb>
                <msb>9</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Rate12</name>
                    <description>rate = 1/2</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Rate23</name>
                    <description>rate = 2/3</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Rate34</name>
                    <description>rate = 3/4</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Rate56</name>
                    <description>rate = 5/6</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PACKETLENGTHREMAINDERBITS</name>
                <description>PACKET_LENGTH_REMAINDER_BITS Options are</description>
                <lsb>12</lsb>
                <msb>14</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>0Bits</name>
                    <description>0 bits</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>1Bit</name>
                    <description>1 bit</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2Bits</name>
                    <description>2 bits</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>4Bits</name>
                    <description>4 bits</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>5Bits</name>
                    <description>5 bits</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>6Bits</name>
                    <description>6 bits</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>3Bits</name>
                    <description>3 bits</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GENERATEEOP</name>
                <lsb>15</lsb>
                <msb>15</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DonTGenerateAnEopFl</name>
                    <description>Don't generate an EOP flag at the end of the packet</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GenerateAnEopFlagAtT</name>
                    <description>Generate an EOP flag at the end of the packet</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>REMOVETAILBITS</name>
                <lsb>16</lsb>
                <msb>16</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OutputDataBytesConta</name>
                    <description>Output data bytes contain tail bits</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TailBitsAreNotOutput</name>
                    <description>Tail bits are not output</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CONTROL1</name>
            <description>WLAN VITERBI CONTROL1</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>PACKETLENGTHBYTES</name>
                <description>Packet length in bytes</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>START</name>
            <description>WLAN VITERBI START</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VITERBIACTIVE</name>
                <description>ACTIVE=0 when the Wi-Fi Vietrbi is idle, and ACTIVE=1 when the Wi-Fi Viterbi is active.When ACTIVE==1, writing to this bit has no effect.When ACTIVE= =0, writing ACTIVE= 1 causes the Wi-Fi Viterbi to start an operation using theparameters set in the registers above.ACTIVE automatically returns to 0 when the Viterbi operation completes after last trace back</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>IPDMATBUSCONTROL</name>
            <description>WLAN VITERBI IPDMA TBUS CONTROL</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>IPDMATBUSSTALLWHENCOMPLETE</name>
                <description>Controls whether TBus write port stalls upstream when the Viterbi job is complete:</description>
                <lsb>20</lsb>
                <msb>20</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ViterbiTbusWritePort</name>
                    <description>Viterbi TBus write port discards data when the Viterbi job is complete</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ViterbiTbusWritePort1</name>
                    <description>Viterbi TBus write port stalls upstream when the Viterbi job is complete</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUS</name>
            <description>WLAN VITERBI STATUS</description>
            <addressOffset>0x34</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANVITERBIDONEEFSTATUS</name>
                <description>WLAN_VITERBI_DONE_EF_STATUS is set to 1 when an VITERBI operation completes,and is cleared when 1 is written to WLAN_VITERBI_DONE_EF_CLEAR in the WLAN_VITERBI_CONTROL0 register.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>COREID</name>
            <description>WLAN VITERBI CORE ID</description>
            <addressOffset>0x38</addressOffset>
            <access>read-only</access>
            <resetValue>0x000F0E00</resetValue>
            <fields>
              <field>
                <name>CONFIGURATIONID</name>
                <description>Configuration of the core.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>COREID</name>
                <description>Identifies the member of the IP group. [0x0E = Wireless LAN Viterbi]</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>GROUPID</name>
                <description>Identifies core as part of an IMG IP family group. [0x0F = UCC]</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>COREREVISION</name>
            <description>WLAN VITERBI CORE REVISION</description>
            <addressOffset>0x3C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>MAINTENANCEREV</name>
                <description>Maintenance Release Revision.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>MINORREV</name>
                <description>Core Minor Release Revision.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>MAJORREV</name>
                <description>Family Major Release Revision.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>WLAN_RTM_FD</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WLAN_RTM_FD</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0C000</addressOffset>
          <register>
            <name>RESET</name>
            <description>WLAN RTM FD RESET</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDPULSEDSOFTWARERESET</name>
                <description>Self-clearing software reset.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANRTMFDLATCHEDSOFTWARERESET</name>
                <description>Latched software reset.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANRTMFDSTATSCOUNTERSRESET</name>
                <description>Self-clearing software reset for the statistics counters.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG</name>
            <description>WLAN RTM FD CONFIG</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000030</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDOPERATINGBW</name>
                <description>Receiver operating bandwidth:</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20 MHz,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40 MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMFDPRIMEOFFSET</name>
                <description>Prime offset for 40 MHz operating bandwidth:</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Low</name>
                    <description>Low,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>High</name>
                    <description>High</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMFDSTA20MHZOFFSET</name>
                <description>Selects the 20MHz partition of the BSS operating bandwidth (up to 80 MHz supported):0-1: when BSS operating bandwidth is 400-3: when BSS operating bandwidth is 80</description>
                <lsb>2</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANRTMFDCHEAVERAGEENA</name>
                <description>Enable / disable L-LTF and L-SIG channel estimations average. L-LTF estimation is output when the average is disabled.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLANRTMFDCHESMOOTHINGENA</name>
                <description>Enable / disable channel estimation smoothing.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANRTMFDPARTIALAID</name>
                <description>Partial association ID : combination of the association ID and the BSSID.</description>
                <lsb>6</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>WLANRTMFDBSSCHECKDIS</name>
                <description>Disable BSS association checks: PARTIAL_AID and BSS_COLOR.</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>WLANRTMFDMAPROCESSINGDIS</name>
                <description>Disable midambles processing. When disabled the MIMO Channel Estimation matrix is not updated for the midambles.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>WLANRTMFDBEAMFORMSUPPORT</name>
                <description>Enable support for Beamforming. When disabled the unsupported flag will be rised when a NDP is detected.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG1</name>
            <description>WLAN RTM FD CONFIG 1</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00094F0E</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDRSDTHRESHSLOPE</name>
                <description>Repeated L-SIG detector SNR threshold interpolation slope:threshold =WLAN_RTM_FD_RSD_THRESH_SLOPE * SNRdB + WLAN_RTM_FD_RSD_THRESH_OFFSET</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANRTMFDRSDTHRESHOFFSET</name>
                <description>Repeated L-SIG detector SNR threshold interpolation offset:threshold =WLAN_RTM_FD_RSD_THRESH_SLOPE * SNRdB + WLAN_RTM_FD_RSD_THRESH_OFFSET</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANRTMFDHIGHESTSUPPORTEDMCS</name>
                <description>Configure the highest supported MCS: detected packets with MCS greater than WLAN_RTM_FD_HIGHEST_SUPPORTED_MCS will be dropped.NOTE: the final highest MCS will be the minimum of this register and the internal value (i.e. HT: 7, VHT: 8 for SigBW20, 9 for SigBW40, HE-SU/MU: 9, HE-ER: 2 for SigBW20, 0 for SigBW40</description>
                <lsb>16</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG2</name>
            <description>WLAN RTM FD CONFIG 2</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00020000</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDHEMUSTAIDVIF0</name>
                <description>VIF0 - STA identifier for HE-MU</description>
                <lsb>0</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>WLANRTMFDBSSCOLORVIF0</name>
                <description>VIF0 - BSS color of the BSS of which the STA is a member.</description>
                <lsb>11</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANRTMFDNOTUSEDVIF0</name>
                <description>Set to mark the VIF0 as not used: STA-ID and BSS color will be ignored.</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>GENSTATUS</name>
            <description>WLAN RTM FD GEN STATUS</description>
            <addressOffset>0x10</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDCSMNOTIDLE</name>
                <description>Indicates the training mode - frequency domain is not idle (i.e. processing packet)</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANRTMFDCSMLLTFPROCESSED</name>
                <description>Indicates the legacy LTF fields processing is completed : L-LTF estimated channel</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANRTMFDCSMLHEADERDECODED</name>
                <description>Indicates the legacy header is decoded : L-SIG</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLANRTMFDCSMHHEADERDECODED</name>
                <description>Indicates the non-legacy header is decoded (when it applies) : HT-SIG / VHT-SIG-A / HE-SIG-A</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANRTMFDCSMMUHEADERDECODED</name>
                <description>Indicates the multi-user header is decoded (when it applies) : VHT-SIG-B / HE-SIG-B</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLANRTMFDCSMHLTFPROCESSED</name>
                <description>Indicates the non-legacy LTF fields processing is completed : HT-LTF / VHT-LTF / HE-LTFestimated channel</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANRTMFDCSMDATAPROCESSED</name>
                <description>Indicates all the data OFDM symbols are output to the RXP : L-DATA / HT-DATA / VHT-DATA / HE-DATA</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>WLANRTMFDCSMFORMATDETECTED</name>
                <description>Indicates the packet format is detected (valid)</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANRTMFDCSMPACKETFORMAT</name>
                <description>Packet format:</description>
                <lsb>8</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LLegacy</name>
                    <description>L (legacy)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Ht</name>
                    <description>HT</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Vht</name>
                    <description>VHT</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSu</name>
                    <description>HE-SU</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeMu</name>
                    <description>HE-MU</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeEr</name>
                    <description>HE-ER</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeTb</name>
                    <description>HE-TB</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMFDHBPLSIGERROR</name>
                <description>Indicates L-SIG decoding error:- invalid rate- invalid reserved bits- invalid tail bits- parity check failure</description>
                <lsb>11</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANRTMFDHBPHTSIGERROR</name>
                <description>Indicates HT-SIG decoding error:- invalid reserved bits- invalid tail bits- CRC check failure</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLANRTMFDHBPHTSIGUNSUPPORTED</name>
                <description>Indicates HT-SIG unsupported feature:- MCS &amp;gt; 7- STBC &amp;gt; 1</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>WLANRTMFDHBPVHTSIGAERROR</name>
                <description>Indicates VHT-SIG-A decoding error:- invalid reserved bits- invalid tail bits- CRC check failure</description>
                <lsb>14</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>WLANRTMFDHBPVHTSIGAUNSUPPORTED</name>
                <description>Indicates VHT-SIG-A unsupported feature:- Bandwidth &amp;gt; 1- Group ID not 0 or 63 (VHT-MU)- NSTS &amp;gt; 0 if STBC = 0, NSTS &amp;gt; 1 if STBC = 1- MCS &amp;gt; 8 if Bandwidth = 0, MCS &amp;gt; 9 if Bandwidth = 1</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANRTMFDHBPHESIGAERROR</name>
                <description>Indicates HE-SIG-A decoding error:- invalid reserved bits- invalid tail bits- CRC check failure- mod(L-SIG[length], 3) == 0</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANRTMFDHBPHESIGAUNSUPPORTED</name>
                <description>Indicates HE-SIG-A unsupported feature:[HE-SU/HE-ER]- UL detected (PPDU is addressed to an AP)- MCS &amp;gt; 9 if HE-SU, MCS &amp;gt; 2 if HE-ER and Bandwidth = 0, MCS &amp;gt; 0 if HE-ER and Bandwidth = 1- Bandwidth &amp;gt; 1- NSTS &amp;gt; 0 if STBC = 0, NSTS &amp;gt; 1 if STBC = 1- HE-TB detected[HE-MU]- HE-SIGB-MCS &amp;gt; 5, HE-SIGB-MCS = 2 or HE-SIGB-MC &amp;gt; 4 if HE-SIGB-DCM enabled- HE-LTF symbols &amp;gt; 8 if Doppler = 0, HE-LTF symbols &amp;gt; 4 if Doppler = 1</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>WLANRTMFDHBPHESIGBERROR</name>
                <description>Indicates HE-SIG-B decoding error (common and user fields):- invalid tail bits- CRC check failure</description>
                <lsb>18</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>WLANRTMFDHBPHESIGBUNSUPPORTED</name>
                <description>Indicates HE-SIG-B unsupported feature:- MCS &amp;gt; 9- DCM = 1 if STBC = 1- NSTS &amp;gt; 0 if STBC = 0, NSTS &amp;gt; 1 if STBC = 1</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLANRTMFDHBPBSSCHECKFAIL</name>
                <description>Indicates BSS association check failure:- VHT : PARTIAL_AID not matching WLAN_RTM_FD_PARTIAL_AID- HE-SU/HE-ER : BSS_COLOR not matching WLAN_RTM_FD_BSS_COLOR- HE-MU : STA-ID not matching WLAN_RTM_FD_HEMU_STA_ID or not matchig broadcast STA-IDsNote: PARTIAL_AID and BSS_COLOR checks can be disabled by setting WLAN_RTM_FD_BSS_CHECK_DIS register to 1</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>WLANRTMFDSPATIALREUSEEVENT</name>
                <description>Indicates Spatial Reuse is detected.</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>WLANRTMFDRTMPOPERROR</name>
                <description>Indicates POP error event in the RTM-FD.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RXPDECSTATUS</name>
            <description>WLAN RTM FD RXPDEC STATUS</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDLSIGVALID</name>
                <description>Indicates when the L-SIG decoded data is available.Note: this register is cleared when soft-reset</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANRTMFDHTSIGVALID</name>
                <description>Indicates when the HT-SIG / VHT-SIG_A / HE-SIG-A decoded data is available.Note: this register is cleared when soft-reset</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANRTMFDVHTSIGBVALID</name>
                <description>Indicates when the VHT-SIG-B decoded data is available.Note: this register is cleared when soft-reset</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
