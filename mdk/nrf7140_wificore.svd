            <addressOffset>0x24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CUTBACKDEEPCLIPFIRSTITER</name>
                <description>AGC Cut back in case of Deep saturation.value can be in between 0 to 63dB.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>CUTBACKMODERATECLIPFIRSTITER</name>
                <description>Cut back in case of Moderate saturation. The cutback can be anywhere in between 0 to 63dB.</description>
                <lsb>6</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>CUTBACKNONZEROCLIPSCASEFIRSTITER</name>
                <description>The cutback to be applied when non-zero number of clips are seen in a symbol and less than the threshold required to call it a moderate clip. Value is considered in 2's complement and can range from -31 to 32 dB.</description>
                <lsb>12</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
