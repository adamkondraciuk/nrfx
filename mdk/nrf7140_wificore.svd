            <fields>
              <field>
                <name>GAINMAPPERMETHOD</name>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>DEBUGMODERFRSSIINPUTEN</name>
                <description>This register enables inputting of the RF RSSI Status/Valid from the Debug input register instead of the input ports. This is used for validation of the AGC functinality. Similar to DEBUGIQ mode where IQ's are fed into the SCP module using DEBUG input registers instead of the SCP IQ input ports.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RfRssiStatusValidFr</name>
                    <description>RF RSSI status/Valid from AGC input ports.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RfRssiStatusValidIn</name>
                    <description>RF RSSI status/Valid input from Debug register.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
