              </field>
              <field>
                <name>WLANRTMTDPACKETFORMAT</name>
                <description>Packet format:Note: default value set when software reset</description>
                <lsb>2</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LLegacy</name>
                    <description>L (legacy)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Ht</name>
                    <description>HT</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Vht</name>
                    <description>VHT</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSu</name>
                    <description>HE-SU</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeMu</name>
                    <description>HE-MU</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeEr</name>
                    <description>HE-ER</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeTb</name>
                    <description>HE-TB</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMTDDATAGUARDFORMAT</name>
                <description>Guard duration for DATA symbols :</description>
                <lsb>5</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>04UsLegacyShort</name>
                    <description>0.4us (legacy short),</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>08UsLegacyLong</name>
                    <description>0.8us (legacy long),</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16Us</name>
                    <description>1.6us,</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>32Us</name>
                    <description>3.2us</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMTDNUMPREAMBLEOFDMSYM</name>
                <description>Number of preamble / header OFDM symbols, counting after L-SIG (i.e. for legacy packet the value is zero)Note: default value set when software reset</description>
                <lsb>7</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANRTMTDHELTFFORMAT</name>
                <description>HE-LTF format :0: 1x HE-LTF (3.2us)+ 0.8us GI,1: 1x HE-LTF (3.2us)+ 1.6us GI,2: 2x HE-LTF (6.4us)+ 0.8us GI,3: 2x HE-LTF (6.4us)+ 1.6us GI,4: 4x HE-LTF (12.8us) + 0.8us GI,5: 4x HE-LTF (12.8us) + 3.2us GI,6-7: ReservedNote: default value set when software reset</description>
                <lsb>12</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>WLANRTMTDHEMIDAMBLE</name>
                <description>HE-LTF format :Note: default value set when software reset</description>
                <lsb>15</lsb>
                <msb>16</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoMidambles</name>
                    <description>No midambles,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MidamblesEvery10Ofdm</name>
                    <description>Midambles every 10 OFDM data symbols,</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MidamblesEvery20Ofdm</name>
                    <description>Midambles every 20 OFDM data symbols</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMTDDETECTVALID</name>
                <description>Indicates the detection control register fields are valid.Note: default value set when software reset</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DetectionControlRegi</name>
                    <description>Detection control register fields not yet set</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WlanRtmTdHeDetec</name>
                    <description>WLAN_RTM_TD_HE_DETECTED and WLAN_RTM_TD_LRATE_DETECTED are valid</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMTDHEDETECTED</name>
                <description>HE detection flag :Note: default value set when software reset</description>
                <lsb>18</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NonHeDetected</name>
                    <description>non-HE detected,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeDetected</name>
                    <description>HE detected</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMTDLRATEDETECTED</name>
                <description>L-SIG 6 Mbps detection flag :Note: default value set when software reset</description>
                <lsb>19</lsb>
                <msb>19</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LSigRateNot6Mbps</name>
                    <description>L-SIG rate not 6 Mbps,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LSigRateIs6Mbps</name>
                    <description>L-SIG rate is 6 Mbps</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMNUMHELTFOFDMSYM</name>
                <description>Number of HE-LTF OFDM symbols in the preamble section (do NOT include the midables HE-LTFs)Note: default value set when software reset</description>
                <lsb>20</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONTROL1</name>
