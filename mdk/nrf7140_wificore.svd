          <register>
            <name>RXPDECHTSIGH</name>
            <description>WLAN RTM FD RXPDEC HTSIG H</description>
            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDHTSIGHDATA</name>
