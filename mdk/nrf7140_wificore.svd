                <lsb>0</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>NCLIPMODERATESECONDITER</name>
                <description>Number of samples in clip to determine moderate clip. This field can have values from 0 to 512.</description>
                <lsb>11</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
