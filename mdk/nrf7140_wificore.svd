                <lsb>0</lsb>
                <msb>30</msb>
              </field>
              <field>
                <name>LMACINT3</name>
                <description>This Read Only bit is set to 1 when the lmac_int_3 event is asserted.Writing to LMAC_INT_CLR_3 in the umac_to_lmac_ack_3 register clears this bit.</description>
                <lsb>31</lsb>
                <msb>31</msb>
              </field>
            </fields>
