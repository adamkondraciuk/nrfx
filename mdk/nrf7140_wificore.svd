          <register>
            <name>CONFIG</name>
            <description>WLAN MIMO DECODER CONFIG</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANMIMODECODERLLRWIDTH</name>
                <description>Select LLR bit width.</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>4BitFixedPointSuit</name>
                    <description>4-bit fixed point, suitable for Viterbi decoder input, where LLR = log(P(x=1)/P(x=0))</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>6BitFixedPointSuit</name>
                    <description>6-bit fixed point, suitable for Viterbi decoder input, where LLR = log(P(x=1)/P(x=0))</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>8BitFixedPointSuit</name>
                    <description>8-bit fixed point, suitable for Viterbi decoder input, where LLR = log(P(x=1)/P(x=0))</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>8BitFixedPointSuit3</name>
                    <description>8-bit fixed point, suitable for LDPC decoder Q6.1 input, where LLR = log(P(x=0)/P(x=1))</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANMIMODECODERLLRFORMAT</name>
                <description>For fixed point LLRs, specify the number of LSBs to truncate from full precision 16-bit LLRs.For floating point mode, specify the number of fractional bits we assume the full precision 16-bit LLRs represent.</description>
                <lsb>2</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANMIMODECODERRMATRIXFORMAT1</name>
                <description>Specify the number of LSBs to drop from each R-matrix element for first spatial stream.Note that only settings of 0-4 are supported.5-7 are reserved.</description>
                <lsb>8</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>WLANMIMODECODERRMATRIXFORMAT2</name>
                <description>Specify the number of LSBs to drop from each R-matrix element for second spatial stream.Note that only settings of 0-4 are supported.5-7 are reserved.</description>
                <lsb>12</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>WLANMIMODECODERRMATRIXFORMAT3</name>
                <description>Specify the number of LSBs to drop from each R-matrix element for third spatial stream.Note that only settings of 0-4 are supported.5-7 are reserved.</description>
                <lsb>16</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>WLANMIMODECODERRMATRIXFORMAT4</name>
                <description>Specify the number of LSBs to drop from each R-matrix element for fourth spatial stream.Note that only settings of 0-4 are supported.5-7 are reserved.</description>
                <lsb>20</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>OFDMSYMBOLS</name>
            <description>WLAN MIMO DECODER OFDM SYMBOLS</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANMIMODECODEROFDMSYMBOLS</name>
                <description>Specify the number of OFDM symbols for which the channel matrices are valid.Once the specified number of OFDM symbols have been processed, the channel matrices are invalidated, and a new set of channel matrices will be used.Provided suitable hardware support is enabled, it is possible to pre-load the next set of channel matrices whilst processing receive vectors with the current set of channel matrices.Note that once the current set of channel matrices have been invalidated, no new receive vectors will be processed until the next set of channel matrices have been loaded (or pre-loaded).When this register is set to zero, the channel matrices will never be invalidated, and subsequent channel matrix loads will overwrite existing data in-place.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CMLOADED</name>
            <description>WLAN MIMO DECODER CM LOADED</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANMIMODECODERCMLOADED</name>
                <description>Assume channel matrices are already loaded into the MIMO decoder</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DonTAssumeChannelMa</name>
                    <description>Don't assume channel matrices have been loaded</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AssumeChannelMatrice</name>
                    <description>Assume channel matrices have been loaded</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
