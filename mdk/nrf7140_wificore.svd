                    <value>0xC</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LUTSIZECONF</name>
                <description>This field configures the size used to transport the Write Lut commands as follows:</description>
                <lsb>16</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LUTSIZE0</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUTSIZE1</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUTSIZE2</name>
                    <description>Unspecified</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUTSIZE3</name>
                    <description>Unspecified</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DBIPARTITIONINGEN</name>
            <description>This register configures whether DWC_mipi_dsi_host is to partition DBI traffic automatically.</description>
            <addressOffset>0x024</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>PARTITIONINGEN</name>
                <description>When set to 1, this bit enables the use of write_memory_continue input commands (system needs to ensure correct partitioning of Long Write commands). When not set, partitioning is automatically performed in the DWC_mipi_dsi_host.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DBICMDSIZE</name>
            <description>This register configures the command size and the size for automatic partitioning of DBI packets.</description>
            <addressOffset>0x028</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WRCMDSIZE</name>
                <description>This field configures the size of the DCS write memory commands. The size of DSI packet payload is the actual payload size minus 1, because the DCS command is in the DSI packet payload.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>ALLOWEDCMDSIZE</name>
                <description>This field configures the maximum allowed size for a DCS write memory command. This field is used to partition a write memory command into one write_memory_start and a variable number of write_memory_continue commands. It is only used if the partitioning_en bit of the DBI_CFG register is disabled. The size of the DSI packet payload is the actual payload size minus 1, because the DCS command is in the DSI packet payload.</description>
                <lsb>16</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PCKHDLCFG</name>
            <description>This register configures how EoTp, BTA, CRC and ECC are to be used, to meet peripherals characteristics</description>
            <addressOffset>0x02C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EOTPTXEN</name>
                <description>When set to 1, this bit enables the EoTp transmission in high-speed.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>EOTPRXEN</name>
                <description>When set to 1, this bit enables the EoTp reception.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>BTAEN</name>
                <description>When set to 1, this bit enables the Bus Turn-Around (BTA) request.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>ECCRXEN</name>
                <description>When set to 1, this bit enables the ECC reception, error correction, and reporting.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>CRCRXEN</name>
                <description>When set to 1, this bit enables the CRC reception and error reporting.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>EOTPTXLPEN</name>
                <description>When set to 1, this bit enables the EoTp transmission in low-power.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>GENVCID</name>
            <description>This register configures the Virtual Channel ID of READ responses to store and return to Generic interface.</description>
            <addressOffset>0x030</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>GENVCIDRX</name>
                <description>This field indicates the Generic interface read-back virtual channel identification.</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>GENVCIDTEARAUTO</name>
                <description>This field indicates the virtual channel identification for tear effect by hardware</description>
                <lsb>8</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>GENVCIDTXAUTO</name>
                <description>This field indicates the Generic interface virtual channel identification where generic packet is automatically generated  and  transmitted.</description>
                <lsb>16</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MODECFG</name>
            <description>This register configures the mode of operation between Video or Command Mode. (Commands can still be sent while in video mode.)</description>
            <addressOffset>0x034</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <fields>
              <field>
                <name>CMDVIDEOMODE</name>
                <description>This bit configures the operation mode:</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>VIDMODE</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CMDMODE</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDMODECFG</name>
            <description>This register configures several aspects of Video mode operation, the transmission mode, switching to low-power in the middle of a frame, enabling acknowledge and whether to send commands in low-power.</description>
            <addressOffset>0x038</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VIDMODETYPE</name>
                <description>This field indicates the video mode transmission type as follows:</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>VIDMODE0</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VIDMODE1</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VIDMODE2</name>
                    <description>Unspecified</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VIDMODE3</name>
                    <description>Unspecified</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LPVSAEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the VSA period when timing allows.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>LPVBPEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the VBP period when timing allows.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>LPVFPEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the VFP period when timing allows.</description>
                <lsb>10</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>LPVACTEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the VACT period when timing allows.</description>
                <lsb>11</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>LPHBPEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the HBP period when timing allows.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>LPHFPEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the HFP period when timing allows.</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>FRAMEBTAACKEN</name>
                <description>When set to 1, this bit enables the request for an acknowledge response at the end of a frame.</description>
                <lsb>14</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>LPCMDEN</name>
                <description>When set to 1, this bit enables the command transmission only in low-power mode.</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>VPGEN</name>
                <description>When set to 1, this bit enables the video mode pattern generator.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>VPGMODE</name>
                <description>This field is to select the pattern:</description>
                <lsb>20</lsb>
                <msb>20</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>COLORBAR</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BERPATTERN</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>VPGORIENTATION</name>
                <description>This field indicates the color bar orientation as follows:</description>
                <lsb>24</lsb>
                <msb>24</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>VPGORENT0</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VPGORENT1</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDPKTSIZE</name>
            <description>This register configures the video packet size.</description>
            <addressOffset>0x03C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VIDPKTSIZE</name>
                <description>This field configures the number of pixels in a single video packet.</description>
                <lsb>0</lsb>
                <msb>13</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDNUMCHUNKS</name>
            <description>This register configures the number of chunks to use. The data in each chunk has the size provided by VID_PKT_SIZE.</description>
            <addressOffset>0x040</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VIDNUMCHUNKS</name>
                <description>This register configures the number of chunks to be transmitted during a Line period (a chunk is pair made of a video packet and a null packet). If set to 0 or 1, video line is still transmitted in a single packet. If set to 1 that packet is part of a chunk, meaning that a null packet follows it (if vid_null_sizeFIXME GT0). Otherwise, multiple chunks are used to transmit each video line.</description>
                <lsb>0</lsb>
                <msb>12</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDNULLSIZE</name>
            <description>This register configures the size of null packets.</description>
            <addressOffset>0x044</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VIDNULLSIZE</name>
                <description>This register configures the number of bytes inside a null packet. Setting to 0 disables null packets.</description>
                <lsb>0</lsb>
                <msb>12</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDHSATIME</name>
            <description>This register configures the video HSA time.</description>
            <addressOffset>0x048</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VIDHSATIME</name>
                <description>This field configures the Horizontal Synchronism Active period in lane byte clock cycles.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDHBPTIME</name>
            <description>This register configures the video HBP time.</description>
            <addressOffset>0x04C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VIDHBPTIME</name>
                <description>This field configures the Horizontal Back Porch period in lane byte clock cycles.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDHLINETIME</name>
            <description>This register configures the overall time for each video line.</description>
            <addressOffset>0x050</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VIDHLINETIME</name>
                <description>This field configures the size of the total line time (HSA+HBP+HACT+HFP) counted in lane byte clock cycles.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDVSALINES</name>
            <description>This register configures the VSA period.</description>
            <addressOffset>0x054</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VSALINES</name>
                <description>This field configures the Vertical Synchronism Active period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDVBPLINES</name>
            <description>This register configures the VBP period.</description>
            <addressOffset>0x058</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VBPLINES</name>
                <description>This field configures the Vertical Back Porch period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDVFPLINES</name>
            <description>This register configures the VFP period.</description>
            <addressOffset>0x05C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VFPLINES</name>
                <description>This field configures the Vertical Front Porch period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDVACTIVELINES</name>
            <description>This register configures the vertical resolution of video.</description>
            <addressOffset>0x060</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VACTIVELINES</name>
                <description>This field configures the Vertical Active period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>13</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CMDMODECFG</name>
            <description>This register configures several aspect of command mode operation, tearing effect, acknowledge for each packet and the speed mode to transmit each Data Type related to commands.</description>
            <addressOffset>0x068</addressOffset>
