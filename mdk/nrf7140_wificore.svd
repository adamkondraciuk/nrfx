          <addressOffset>0x62C</addressOffset>
          <access>read-write</access>
          <resetValue>0x0000003F</resetValue>
          <fields>
            <field>
              <name>SYMBOLTOLUPPER</name>
              <description>Maximum allowable received NFC pulse width, given in pulses of 13.56 MHz clock</description>
              <lsb>0</lsb>
              <msb>5</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>CONTINUOUSSUBCARRIER</name>
          <description>Selects continuous sub-carrier transmission</description>
          <addressOffset>0x630</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CONTINUOUSSUBCARRIER</name>
              <description>Selects continuous sub-carrier transmission</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Normal</name>
                  <description>Normal modulation</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Carrier</name>
                  <description>Continuous sub-carrier transmission</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CLOCKRECCONFIG</name>
          <description>Configuration bits for NFCT_CLOCKREC_GF22N</description>
          <addressOffset>0x63C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000121</resetValue>
          <fields>
            <field>
              <name>ENABLERXTHRESHOLD</name>
              <description>Enables RX threshold of the sine-to-square converter. 1b_0 enables TX threshold.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>RXTHRESHOLD</name>
              <description>Select RX threshold voltage</description>
              <lsb>4</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>ENABLEOUTPUT</name>
              <description>Enables the NFCT_REF_13M56_AO_0V8 output</description>
              <lsb>8</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>SPARE</name>
              <description>Spare</description>
              <lsb>9</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>OVERRIDEENABLE</name>
          <description>Enables override functionality.</description>
