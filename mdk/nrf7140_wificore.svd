            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXFINAL</name>
                <description>Set to flag last Tx Job before posting final TX-SCP output transfer.Must be cleared following completion of TX-SCP output job.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS0</name>
            <description>EDC PERIP MEM ADDR MSBS0</description>
            <addressOffset>0xC2C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EXTRAMID0ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 0 word address (bits 39:25 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS1</name>
            <description>EDC PERIP MEM ADDR MSBS1</description>
            <addressOffset>0xC30</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EXTRAMID1ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 1 word address (bits 39:25 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS2</name>
            <description>EDC PERIP MEM ADDR MSBS2</description>
            <addressOffset>0xC34</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EXTRAMID2ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 2 word address (bits 39:25 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS3</name>
            <description>EDC PERIP MEM ADDR MSBS3</description>
            <addressOffset>0xC38</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EXTRAMID3ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 3 word address (bits 39:25 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBSEXT0</name>
            <description>EDC PERIP MEM ADDR MSBS EXT0</description>
            <addressOffset>0xC3C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EXTRAMID0ADDRMSBSEXT</name>
                <description>Defines bits 61:38 of ExtRAM request ID 0 word address (bits 63:40 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
