                <lsb>3</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>GAINMODE3PATTERN</name>
                <description>Pattern for indicating the gain region between MODE3-GAIN and MODE4-GAIN</description>
                <lsb>6</lsb>
