            <access>read-write</access>
            <resetValue>0x00006363</resetValue>
            <fields>
              <field>
                <name>Z</name>
                <description>NFCID1 byte Z (very last byte sent)</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>Y</name>
                <description>NFCID1 byte Y</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>X</name>
                <description>NFCID1 byte X</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>W</name>
                <description>NFCID1 byte W</description>
                <lsb>24</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SECONDLAST</name>
