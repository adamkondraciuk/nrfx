          <register>
            <name>GNSSOUTPUTFORMAT</name>
            <description>SCP GNSS OUTPUT FORMAT</description>
            <addressOffset>0x360</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>GNSSOUTPUTFORMAT</name>
                <description>SCP, GNSS Location Core output format selection.0:1x I/Q pair(12-bits per component)This represents standard SCP operation.1:3x I/Q pairs(4-bits per component)2:4x I/Q pairs(3-bits per component)3:6x I/Q pairs(2-bits per component)4: 12x I/Q pairs(1-bitper component)Other values are reserved and must not be used.Where a non-zero value is set in this register the 12-bit samples in each pair are reduced to the k-bit width indicated by selecting the k MSBs from each 12-bit sample.Setting this register to a non-zero value assumes TBUS_OUTPUT_FORMAT=0</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TBUSCONTROL</name>
            <description>SCP TBUS CONTROL</description>
            <addressOffset>0x380</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>TBUSOUTPUTFORMAT</name>
                <description>Used to select TBus output format:0 : 12-bit real in upper and 12-bit imaginary in lower 24 bits of TBus output (default).1 : Alternating 16-bit imaginary followed by 16-bit real, left aligned in 24-bits of output TBus.8-bit lsbs are zero padded and full 24 bits transferred to memory by EDC for processing as 24-bit double by MCP.2 : Alternating 16-bit imaginary followed by 16-bit real, right aligned in 24-bits of output TBus.Sign extended to 24 bits but in practice only lower 16 bits will be transferred to memory by EDC for processing as 32-bit complex by MCU.This field is only relevant on 16-bit SCPs.Note reference to this register in the description of register GNSS_OUTPUT_FORMAT.</description>
                <lsb>18</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>TBUSOUTPUTSTALL</name>
                <description>Used to enable or disable stalling of SCP when output FIFO is full:</description>
                <lsb>20</lsb>
                <msb>20</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>StallingOfScpDisable</name>
                    <description>Stalling of SCP disabled when output FIFO is full.TBUS_OVERFLOW_EVENT flagged when SCP output overflows TBus output FIFO.OVERFLOW_EVENT can also be flagged when input data rate too high for enabled processing (i.e. due to re-sample factor, or enabling of notch/impulse filters).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StallingOfScpEnabled</name>
                    <description>Stalling of SCP enabled when output FIFO is full.TBUS_OVERFLOW_EVENT not flagged, only OVERFLOW_EVENT flagged when input data rate too high for enabled processing (i.e. due to re-sample factor, or enabling of notch/impulse filters), or as a result of EDC TBus job rate being too slow.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TBUSOUTPUTENABLE</name>
                <description>Used to enable or disable output of next symbol to TBus:</description>
                <lsb>21</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OutputToTbusDisabled</name>
                    <description>Output to TBus disabled at end of next symbol.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OutputToTbusEnabledA</name>
                    <description>Output to TBus enabled at start of next symbol.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TBUSOUTPUTMODE</name>
                <description>Used to enable output to TBus:</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OutputToTbusDisabled</name>
                    <description>Output to TBus disabled.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OutputToTbusEnabled</name>
                    <description>Output to TBus enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
