                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>RESETPSMPTIMER</name>
                <description>Reset timer.** NOTE: After reset, Reset_enable bit will be set. Thus timer will be in reset mode.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ResetDisable</name>
                    <description>Reset disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ResetEnableTimerWil</name>
                    <description>Reset enable,Timer will be in reset mode , header decoded signal will be ignored.</description>
