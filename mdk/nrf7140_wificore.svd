            <fields>
              <field>
                <name>WLANCTRLOFDMRTMSCPEOPSNAPSHOTLSB</name>
                <description>LSB of snapshot of time measurement counter, taken when OFDM Receiver Training Mode - SCP EOP goes high</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>OFDMRTMFDEOPSNAPSHOTMSB</name>
            <description>WLAN CTRL OFDM RTM FD EOP SNAPSHOT MSB</description>
            <addressOffset>0x60</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLOFDMRTMFDEOPSNAPSHOTMSB</name>
                <description>MSB of snapshot of time measurement counter, taken when OFDM Receiver Training Mode - FD EOP goes high</description>
                <lsb>0</lsb>
                <msb>23</msb>
