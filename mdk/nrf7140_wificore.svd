          <register>
            <name>CHANNELLOAD</name>
            <description>WLAN ED CHANNEL LOAD</description>
            <addressOffset>0x94</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CHLLOADTHRESH</name>
                <description>A signal is asserted whenever received signal in primary channel crossing this threshold . Threshold value is configured in steps of 1dB ranging from -128dB to 127dB.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>CHLLOADSEL</name>
                <description>012</description>
                <lsb>8</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>PRIM20CORRINDINCLUDE</name>
                <description>If this is set primary correlation result in included in providing channel load information.</description>
                <lsb>11</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>SEC20CORRINDINCLUDE</name>
                <description>If this is set secondary20 correlation result in included in providing channel load information.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>SEC40CORRINDINCLUDE</name>
                <description>If this is set secondary40 correlation result in included in providing channel load information.</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CORRELATIONRESULT</name>
            <description>WLAN ED CORRELATION RESULT</description>
            <addressOffset>0x98</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>PRIM20CORRELATIONINDICATION</name>
                <description>This signal logical 'OR'ed with CCA busy of primary 20MHz channel indicates channel busy condition. This can be cleared once PLCP header is successfully received. MCP sets this bit if it sees correlation successful in secondary channel.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>SEC20CORRELATIONINDICATION</name>
                <description>This signal logical 'OR'ed with CCA busy of secondary 20MHz channel indicates channel busy condition. This can be cleared once PLCP header is successfully received.MCP sets this bit if it sees correlation successful in secondary channel.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>SEC40CORRELATIONINDICATION</name>
                <description>This signal logical 'OR'ed with CCA busy of secondary 40MHz channel indicates channel busy condition. This can be cleared once PLCP header is successfully received.MCP sets this bit if it sees correlation successful in secondary 40MHz channel.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FILTGAINCOMPFACTORS</name>
            <description>WLAN ED FILT GAIN COMP FACTORS</description>
            <addressOffset>0x9C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>COMPFACFILTGAIN20</name>
                <description>Value = 20**log10(2^(N_ADC_BITS-1)/ADC_PK_VOLT) + FILT_GAINN_ADC_BITS : Number of ADC bits (10)ADC_PK_VOLT : ADC peak voltage level (0.5V)FILT_GAIN: Gain in dB due to filter</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>COMPFACFILTGAIN40</name>
                <description>Value = 20**log10(2^(N_ADC_BITS-1)/ADC_PK_VOLT) + FILT_GAINN_ADC_BITS : Number of ADC bits (10)ADC_PK_VOLT : ADC peak voltage level (0.5V)FILT_GAIN: Gain in dB due to filter</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>COMPFACFILTGAIN80</name>
                <description>This is gain difference between two filters.Value = 20**log10(2^(N_ADC_BITS-1)/ADC_PK_VOLT) + (FILT1_GAIN - FILT2_GAIN)N_ADC_BITS : Number of ADC bits (10)ADC_PK_VOLT : ADC peak voltage level (0.5V)FILT_GAIN: Gain in dB due to filter</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MIMOEXTENSION</name>
            <description>WLAN ED MIMO EXTENSION</description>
            <addressOffset>0xA0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>ANT0ENABLE</name>
                <description>Enables Antenna 0 input processing for ED module.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>ANT1ENABLE</name>
                <description>Enables Antenna 1 input processing in ED module</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>ANT2ENABLE</name>
                <description>Enables Antenna 2 input processing in ED module</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>ANT3ENABLE</name>
                <description>Enables Antenna 3 input processing in ED module</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>DSSSCORRANTSEL</name>
                <description>The antenna index to be selected for DSSS correlation in ED. Can be from 0 to 3.</description>
                <lsb>4</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>CORRMINNORMPASS</name>
                <description>Denotes the number of passes for the correlation metric above threshold for Correlation Pass in ED.</description>
                <lsb>6</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>OFDMCORROVEREVENTEN</name>
                <description>This register enable the assertion of OFDM post AGC correlation done event.'0' - Event assertion is disabled.'1' - Enabled.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>VARIANCESWOFF</name>
                <description>Bit to switch off the variance computation modules inside ed module.'1' - switch off the variance estimation modules.'0' - don't switch off. Controlled according to internal logic.</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>MINVARFOROFDMCORRPASS</name>
                <description>This register holds the minimum value of RSSI in dBm (signed), that is necessary for OFDM correlation check to pass. If the computed RSSI is below thisvalue then even though OFDM correlation metric is high the OFDM correlation success will not be enabled, so ED will not be successful. This is used for preventing low amplitude periodic signals especially DC offset from triggering OFDM correlation based ED.</description>
                <lsb>14</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>OFDMCORREN</name>
                <description>OFDM correlation enable.'1' - OFDM correlation enabled.'0' - OFDM correlation disabled.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>POSTAGCESTEVENTEN</name>
                <description>This register enables the assertion of post AGC estimation event.'0' - Event assertion is disabled.'1' - Event assertion is enabled.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DCCOMPENSATIONSETTINGS</name>
            <description>WLAN ED DC COMPENSATION SETTINGS</description>
            <addressOffset>0xA4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>DCCOMPENABLE</name>
                <description>1-&amp;gt;Enable DC compensation0-&amp;gt;Disable DC compensation</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>DCESTIMATIONLENGTH</name>
                <description>DC Estimation Length indicates the number of samples over which DC should be estimated in the signal preprocessor block.'000' - 8 Samples'001' - 16 Samples'010' - 32 Samples'011' - 64 Samples'100' - 128 Samples</description>
                <lsb>1</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>DCESTIMATIONENABLE</name>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CORRMETRICTH1</name>
            <description>WLAN ED CORR METRIC TH1</description>
            <addressOffset>0xA8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CORRMETRICTH1</name>
                <description>Contains two's complement representation of corr metric threshold , in dB with 3 bit precision after decimal point. i.e. upto 0.125dB accuracy. For example, 332 indicates -22.5dB threshold. 257 indicates -31.875dB threshold.</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>CORRMETRICTH1POSTAGC</name>
                <description>Post AGC CorrMetric Threshold.Contains two's complement representation of corr metric threshold , in dB with 3 bit precision after decimal point. i.e. upto 0.125dB accuracy. For example, 332 indicates -22.5dB threshold. 257 indicates -31.875dB threshold.</description>
                <lsb>9</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUSREGISTER</name>
            <description>WLAN ED STATUS REGISTER</description>
            <addressOffset>0xAC</addressOffset>
            <access>read-only</access>
            <resetValue>0x00400000</resetValue>
            <fields>
              <field>
                <name>EDSTATUS</name>
                <description>Level 'High' indicates energy is detected.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>POSTAGCESTVALIDPRIM20</name>
                <description>Value '1' indicates post AGC estimation performed over prim20 signal are valid.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>POSTAGCESTVALIDPRIM40</name>
                <description>Value '1' indicates post AGC estimation performed over prim40 signal are valid.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>POSTAGCESTVALIDPRIM80</name>
                <description>Value '1' indicates post AGC estimation performed over prim80 signal are valid.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>POSTAGCESTVALIDSEC20</name>
                <description>Value '1' indicates post AGC estimation performed over sec20 signal are valid.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>POSTAGCESTVALIDSEC40</name>
                <description>Value '1' indicates post AGC estimation performed over sec40 signal are valid.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>PRIM20CCABUSY</name>
                <description>Primary20MHz CCA Busy Signal</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>SEC20CCABUSY</name>
                <description>Secondary 20MHz CCA Busy Signal.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>SEC40CCABUSY</name>
                <description>Level 'High' indicates secondary channel is busy.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>DSSSCORRSUCCESS</name>
                <description>Value of '1' indicates DSSS correlation is successful.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>DEDAVGENERGY</name>
                <description>This is the estimate of average energy in dB (10**log10(var)) when dynamic ed event occured</description>
                <lsb>10</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>POSTAGCOFDMCORRSUCCESS</name>
                <description>This bit gives the post AGC OFDM correlation status.'0' - Correlation Failure.'1' - Correlation success.</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>S2LSTATUS</name>
                <description>'1' - S2L Detected.'0' - S2L TimeOut.</description>
                <lsb>18</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>EDDONESOURCE</name>
                <description>This register indicates the source of ED done event.'001' - ED due to prim20 variance exceeding threshold.'010' - ED due to prim20 OFDM correlation exceeding threshold.'011' - ED due to prim20 DSSS correlation exceeding threshold.'100' - ED due to prim20 RSSI between ED detection and CCA'101' - ED due to sec20 RSSI between ED detection and CCA'110' - ED due to sec40 RSSI between ED detection and CCAThe value in this register is only valid when ED_STATUS=1.When ED_STATUS=0 the value in this register is only for debug purposes.</description>
                <lsb>19</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>EDS2LMETRIC</name>
                <description>This register indicates the metric of s2l done event.</description>
                <lsb>22</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DECIMATORFILTCOEFFREG1</name>
            <description>WLAN ED DECIMATOR FILT COEFF REG1</description>
            <addressOffset>0xB0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>FILTERCOEFFH0</name>
                <description>Decimator filter tap 0 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>2</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>FILTERCOEFFH1</name>
                <description>Decimator filter tap 1 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>14</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DECIMATORFILTCOEFFREG2</name>
            <description>WLAN ED DECIMATOR FILT COEFF REG2</description>
            <addressOffset>0xB4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>FILTERCOEFFH2</name>
                <description>Decimator filter tap 2 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>2</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>FILTERCOEFFH3</name>
                <description>Decimator filter tap 3 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>14</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DECIMATORFILTCOEFFREG3</name>
            <description>WLAN ED DECIMATOR FILT COEFF REG3</description>
            <addressOffset>0xB8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>FILTERCOEFFH4</name>
                <description>Decimator filter tap 4 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>2</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>FILTERCOEFFH5</name>
                <description>Decimator filter tap 5 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>14</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DECIMATORFILTCOEFFREG4</name>
            <description>WLAN ED DECIMATOR FILT COEFF REG4</description>
            <addressOffset>0xBC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>FILTERCOEFFH6</name>
                <description>Decimator filter tap 6 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>2</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>FILTERCOEFFH7</name>
                <description>Decimator filter tap 7 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>14</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DECIMATORFILTCOEFFREG5</name>
            <description>WLAN ED DECIMATOR FILT COEFF REG5</description>
            <addressOffset>0xC0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>FILTERCOEFFH8</name>
                <description>Decimator filter tap 8 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>2</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>FILTERCOEFFH9</name>
                <description>Decimator filter tap 9 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>14</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DECIMATORFILTCOEFFREG6</name>
            <description>WLAN ED DECIMATOR FILT COEFF REG6</description>
            <addressOffset>0xC4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>FILTERCOEFFH10</name>
                <description>Decimator filter tap 10 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>2</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>FILTERCOEFFH11</name>
                <description>Decimator filter tap 11 coefficients. Expressed in 10-bit 2's complement</description>
                <lsb>14</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SIGNALPREPROCREG</name>
            <description>WLAN ED SIGNAL PREPROC REG</description>
            <addressOffset>0xC8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>RXOPERFS</name>
                <description>This indicates the Fs at which the RX is operating</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RxAt20Mhz</name>
                    <description>RX at 20MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RxAt40Mhz</name>
                    <description>RX at 40MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RxAt80Mhz</name>
                    <description>RX at 80MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PRIM20OFFSET</name>
                <description>This indicates the offset of the primary20MHz.if RX_OPER_FS = '00' (20MHz)'00' - This is the only allowed value.if RX_OPER_FS = '01' (40MHz)'00' - Primary 20 is the lower 20 MHz.'01' - Primary 20 is the upper 20 MHz.if RX_OPER_FS = '02' (80MHz)'00' - Primary 20 is the lower 20 MHz of the lower 40MHz.'01' - Primary 20 is the upper 20 MHz of the lower 40MHz.'10' - Primary 20 is the lower 20 MHz of the upper 40MHz.'11' - Primary 20 is the upper 20 MHz of the upper 40MHz.</description>
                <lsb>2</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>SIGPREPROCWAITCNT</name>
                <description>This is a 5-bit value specifies how many valid scp output samples to wait before enabling the signal preprocessor</description>
                <lsb>4</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DETTHRESPRIM20</name>
            <description>WLAN ED DET THRES PRIM20</description>
            <addressOffset>0xCC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EDDETTHRESHPRIM20</name>
                <description>Signal level in dB corresponding to ED Detected threshold in the primary 20MHz channel. ED done will be given if primary 20 RSSI is greater than this threshold and less than prim20 CCA busy threshold. The threshold is given in 2's complement form.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DETTHRESSECONDARY</name>
            <description>WLAN ED DET THRES SECONDARY</description>
            <addressOffset>0xD0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EDDETTHRESHSEC20</name>
                <description>Signal level in dB corresponding to ED Detected threshold in the secondary 20MHz channel. ED done will be given if secondary 20 RSSI is greater than this threshold and less than sec20 CCA busy threshold. The threshold is given in 2's complement form.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>EDDETTHRESHSEC40</name>
                <description>Signal level in dB corresponding to ED Detected threshold in the secondary 40MHz channel. ED done will be given if secondary 40 RSSI is greater than this threshold and less than sec40 CCA busy threshold. The threshold is given in 2's complement form.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>S2LREG1</name>
            <description>WLAN ED S2L REG1</description>
            <addressOffset>0xD4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>S2LDETECTIONEN</name>
                <description>'1' - S2L detection in ED module is enabled.'0' - disabled</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>S2LENCONSECCHECK</name>
                <description>'1' - Enables consecutives passes check for S2L detection.'0' - enables minimum pass check for S2L detection.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>S2LCONSECUTIVEPASS</name>
                <description>Denotes the consecutive number of times the OFDM correlation metric be below the S2L detection threshold, so as to indicate S2L detected.</description>
                <lsb>2</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>S2LMINPASS</name>
                <description>Denotes the min number of times the OFDM corr metric should be below the S2L threshold, for S2L detection to happen.</description>
                <lsb>6</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>S2LREG2</name>
            <description>WLAN ED S2L REG2</description>
            <addressOffset>0xD8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>S2LTIMEOUTWAITVALUE</name>
                <description>This is the number of 20MHz starting from AGC done, that we need to wait before asserting Timeout Event incase S2L detection does not happen. If S2L detection event is generated, then S2L timeout event will not be generated.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>S2LDETTHRES1</name>
                <description>Contains two's complement representation of S2L corr metric threshold , in dB with 3 bit precision after decimal point. i.e. upto 0.125dB accuracy. For example, 332 indicates -22.5dB threshold. 257 indicates -31.875dB threshold.</description>
                <lsb>12</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PRIM20EDDISABLECONDITION</name>
            <description>WLAN ED PRIM20 ED DISABLE CONDITION</description>
            <addressOffset>0xDC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>PRIM20SEC20POWDIFFTH</name>
                <description>This parameter gives th 8-bit difference in RSSI between primary 20 and secondary 20 above which primary20 ED Status is disabled.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>PRIM40SEC40POWDIFFTH</name>
                <description>This parameter gives th 8-bit difference in RSSI between primary 40 and secondary 40 above which primary20 ED Status is disabled.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>ENPRIMSECDIFFEDDISABLE</name>
                <description>'1' - Enables the logic which prevents the ED in primary 20MHz from triggering if secRSSI-primRSSI &amp;gt; threshold.'0' - Disables.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>DISSEC20EDPREVENTIONLOGIC</name>
                <description>Sec20 ED detection Prevention Logic.Prevent Sec20 ED (ED Source = 5) from getting asserted if we determine that it is caused by leakage from either Prim20 or Sec40 band.'1' - Disables the logic.'0' - Enables the logic.</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>DISSEC40EDPREVENTIONLOGIC</name>
                <description>Sec40 ED detection Prevention Logic.Prevent Sec40 ED (ED Source = 6) from getting asserted if we determine that it is caused by leakage from either Prim20 or Sec20 band.'1' - Disables the logic.'0' - Enables the logic.</description>
                <lsb>18</lsb>
                <msb>18</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SECONDAGCSETTINGS</name>
            <description>WLAN ED SECOND AGC SETTINGS</description>
            <addressOffset>0xE0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>ENHTSTFDETECTSECAGCTRIGGER</name>
                <description>The Second Agc Estimation process trigger will depend on the HT-STF detection if this flag is enabled,otherwise it will depend on the time out from the s2l point.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>SECONDAGCESTSTARTWAITTIME</name>
                <description>Contains the time out value upto which, will wait from s2l point and triggers second AGC process immediately or after HT-STF detection depends on the flag.NOTE: A value of zero disables the trigger.</description>
                <lsb>1</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>SECONDAGCESTENDWAITTIME</name>
                <description>Contains the time out value upto which will wait from s2l point and stops the HT-STF detection if it is not detected.NOTE: A value of zero disables the check to stop the detection.</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>POPDETSETTINGS</name>
            <description>WLAN ED POP DET SETTINGS</description>
            <addressOffset>0xE4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>ENABLEPOPCHECK</name>
                <description>Enables or disables packet over packet detection:'1' - Enable packet over packet detection.'0' - Disable packet over packet detection.Before setting this bit, make sure REF_POW_FOR_POP_CHECK and PRIM20_REF_POW_DIFF_THRESH are configured appropriately.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>REFPOWFORPOPCHECK</name>
                <description>This is a two's complement value which is the reference power for packet over packet detection. This is set by MCP with the primary 20MHz RSSI of present decoding packet.</description>
                <lsb>1</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>PRIM20REFPOWDIFFTHRESH</name>
                <description>This parameter gives the threshold value for difference in RSSI between primary 20MHz and reference above which packet over oacket detecetion event is set.</description>
                <lsb>9</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>HWPOPDETENABLE</name>
                <description>Enabling POP directly from hardware through this bit. When this bit is set, PoP logic is automatically enabled after ED detection. RSSI estimated in ED module is used as base RSSI for PoP.When this bit is not set then PoP logic depends on ENABLE_POP_CHECK field.</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SIGNALSTATUS</name>
            <description>WLAN ED SIGNAL STATUS</description>
            <addressOffset>0xE8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>PRIM20SIGSTATUSKNOWN</name>
                <description>This register disables ED detection due to primary 20MHz RSSI. This is set to '1' by MCP during Mid-packet detection.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>SEC20SIGSTATUSKNOWN</name>
                <description>This register disables ED detection due to secondary 20MHz RSSI. This is set to '1' by MCP during Mid-packet detection.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>SEC40SIGSTATUSKNOWN</name>
                <description>This register disables ED detection due to secondary 40MHz RSSI. This is set to '1' by MCP during Mid-packet detection.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CORRSUCCESSWAITTIME</name>
            <description>WLAN ED CORR SUCCESS WAIT TIME</description>
            <addressOffset>0xEC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>PRIM20CORRSUCCESSTIMEOUTWAITVALUE</name>
                <description>Contains the timeout wait value for the primary 20MHz samples after which the correlation success wait done flag is set to 1 to allow OFDM or DSSS correlation success to happen before triggering ED done. The counter starts incrementing when estimated primary 20MHz RSSI becomes greater than ED detection threshold and less than CCA busy threshold.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ENAGCTRANSIENTEDRESET</name>
            <description>WLAN ED EN AGC TRANSIENT ED RESET</description>
            <addressOffset>0xF0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>ENAGCTRANSIENTEDRESET</name>
                <description>Defines the ED reset behaviour when AGC is in transient.'1' - Allows the Agc in transient flag based ED reset before ED_STATUS is asserted.'0' - Allows the Agc in transient flag based ED reset irrespective of ED_STATUS.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CORRMETRICTH2</name>
            <description>WLAN ED CORR METRIC TH2</description>
            <addressOffset>0xF4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CORRMETRICTH2</name>
                <description>Contains two's complement representation of corr metric threshold , in dB with 3 bit precision after decimal point. i.e. upto 0.125dB accuracy. For example, 332 indicates -22.5dB threshold. 257 indicates -31.875dB threshold.</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>CORRMETRICTH2POSTAGC</name>
                <description>Post AGC CorrMetric Threshold.Contains two's complement representation of corr metric threshold , in dB with 3 bit precision after decimal point. i.e. upto 0.125dB accuracy. For example, 332 indicates -22.5dB threshold. 257 indicates -31.875dB threshold.</description>
                <lsb>9</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CORRMETRICTH3</name>
            <description>WLAN ED CORR METRIC TH3</description>
            <addressOffset>0xF8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CORRMETRICTH3</name>
                <description>Contains two's complement representation of corr metric threshold , in dB with 3 bit precision after decimal point. i.e. upto 0.125dB accuracy. For example, 332 indicates -22.5dB threshold. 257 indicates -31.875dB threshold.</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>CORRMETRICTH3POSTAGC</name>
                <description>Post AGC CorrMetric Threshold.Contains two's complement representation of corr metric threshold , in dB with 3 bit precision after decimal point. i.e. upto 0.125dB accuracy. For example, 332 indicates -22.5dB threshold. 257 indicates -31.875dB threshold.</description>
                <lsb>9</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>S2LREG3</name>
            <description>WLAN ED S2L REG3</description>
            <addressOffset>0xFC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>S2LDETTHRES3</name>
                <description>Contains two's complement representation of S2L corr metric threshold , in dB with 3 bit precision after decimal point. i.e. upto 0.125dB accuracy. For example, 332 indicates -22.5dB threshold. 257 indicates -31.875dB threshold.</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>S2LDETTHRES2</name>
                <description>Contains two's complement representation of S2L corr metric threshold , in dB with 3 bit precision after decimal point. i.e. upto 0.125dB accuracy. For example, 332 indicates -22.5dB threshold. 257 indicates -31.875dB threshold.</description>
                <lsb>9</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AGCTOS2LCOUNTREG</name>
            <description>WLAN ED AGC TO S2L COUNT REG</description>
            <addressOffset>0x100</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AGCTOS2LCOUNT</name>
                <description>This register holds number of samples between AGC done and S2L success.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CFOESTREALREG</name>
            <description>WLAN ED CFO EST REAL REG</description>
            <addressOffset>0x104</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CFOESTREAL</name>
                <description>This value holds the real part of the estimated CFO.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CFOESTIMAGREG</name>
            <description>WLAN ED CFO EST IMAG REG</description>
            <addressOffset>0x108</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CFOESTIMAG</name>
                <description>This value holds the imaginary part of the estimated CFO.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>IEEE80211KCONTROLREGISTER</name>
            <description>WLAN ED IEEE802 11K CONTROL REGISTER</description>
            <addressOffset>0x10C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANED11KRESET</name>
                <description>This flag when set to 1 Resets the Radio Measurement Module(11K standard support).</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANED11KENABLE</name>
                <description>This flag when set to 1 Enables the Radio Measurement Module(11K standard support).</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>IEEE80211KSETTINGS</name>
            <description>WLAN ED IEEE802 11K SETTINGS</description>
            <addressOffset>0x110</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANED11KTXON</name>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANED11KVIRTUALCHANNELBUSY</name>
                <description>.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANED11KDEBUGMODEEN</name>
                <description>This Flag when set to 1 (In Debug Mode) selects the system states TxOn and VirtualChannelBusy required for RadioMeasurementModule, from Register Memory instead of from Ports.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANED11KCHANNELSEL</name>
                <description>This Flag selects the Bandwidth on which Radio Measurements should be done0 - 20MHz1 - 40MHz2 - 80MHz.</description>
                <lsb>4</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANED11KANPIMAXACCUMLENSEL</name>
                <description>Select the maximum number of RSSI samples to be accumulated for ANPI measurement.'0' - maxAccumLen = 2^10;'1' - maxAccumLen = 2^15;'2' - maxAccumLen = 2^18;'3' - maxAccumLen = 2^20;After the maxAccumLen is reached, the accumulation is stopped and the values are retained.The module needs to be reset to do the accumulation again.</description>
                <lsb>11</lsb>
                <msb>12</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ACIDETECTIONSETTINGS</name>
            <description>WLAN ED ACI DETECTION SETTINGS</description>
            <addressOffset>0x118</addressOffset>
            <access>read-write</access>
            <resetValue>0x000B00FF</resetValue>
            <fields>
              <field>
                <name>WLANEDACIDETTHRESDB</name>
                <description>This threshold is in dB, Unsigned value. If the difference between AGC RSSI and ED RSSI is greater than this threshold, then ACI presence is detected, and hence ED Status assertion will be blocked. To bypass this feature, this threshold should be configured to 0xFF.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANEDAGCRSSICOMPFACTOR</name>
                <description>This is an signed value in dB that used in the AGC RSSI computation, from the AGC log variance.AGC_RSSI= AGC_LOG_VARIANCE + AGC_RSSI_COMP_FACTOR - AGC_GAIN_DB</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANEDSUPPRESSCCAIFACIDETECTED</name>
                <description>'1' - Enable ACI based CCA suppression, i. e. , if ACI is detected, then prim20, sec20, and sec40 CCA busy signals are forced to '0' during the duration.'0' - Disable. ACI detection does not have any impact on the CCA signal generation.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANEDMVGAVGESTLEN</name>
                <description>This specifies length of the moving averager (FIFO length) for averaging the ED variance. There is a ED variance estimation block that estimates prim20, prim40 and prim80 variances from the corresponding IQ samples. The variance estimates become valid once in a 0.8us interval (one symbol). The output of the variance estimator is then sent to a moving average FIFO for further averaging. The variance estimate is sampled on the valid and written to the FIFO. The length of moving average is specified as follows:</description>
                <lsb>17</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MovingAverageFifoLen</name>
                    <description>Moving average fifo length is 1. Use the current ED variance. (So effective averaging is over 0.8us)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MovingAverageFifoLen1</name>
                    <description>Moving average fifo length is 2. Average the latest two ED variances. (So effective averaging is over 1.6us)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MovingAverageFifoLen2</name>
                    <description>Moving average fifo length is 4. Average the latest four ED variances. (So effective averaging is over 3.2us)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NotValid</name>
                    <description>Not valid</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANEDACIUSEMVGAVGVAR</name>
                <description>This bit is used to choose between block averaged and moving averaged ED RSSI for ACI detection logic.Moving averaged ED variance improves the ED RSSI accuracy (reduces fluctuations).'1' - Use moving averaged based ED variance.'0' - Use normal block averaged ED variance.</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AACIDETECTIONSETTINGS</name>
            <description>WLAN ED AACI DETECTION SETTINGS</description>
            <addressOffset>0x11C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <fields>
              <field>
                <name>WLANEDSUPPRESSCCAIFAACIDETECTED</name>
                <description>'1' - Enable AACI based CCA suppression, i. e. if AACI is detected, then prim20, sec20, and sec40 CCA busy signals are forced to '0' for the duration.'0' - This feature is not active, i.e. AACI detection does not have any impact on the CCA signal generation.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>IEEE80211KANPIACCUMVALUE</name>
            <description>WLAN ED IEEE802 11K ANPI ACCUM VALUE</description>
            <addressOffset>0x120</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANED11KANPIACCUMVALUE</name>
                <description>This value holds the value of the current value of ANPI accumulator right shifted by 4.This is because ANPI accumulator is 28bit and register width is 24 bit.So when ANPI_DBM value is computed we need to do:ANPI_DBM = (ANPI_ACCUM_VALUE&amp;lt;&amp;lt;4) / ANPI_ACCUM_COUNT</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>IEEE80211KANPIACCUMCOUNT</name>
            <description>WLAN ED IEEE802 11K ANPI ACCUM COUNT</description>
            <addressOffset>0x124</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANED11KANPIACCUMCOUNT</name>
                <description>This value holds the value of the current value of ANPI accumulator count.The count is incremented for everytime variance valid is generated.</description>
                <lsb>0</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGOFDMORDSSS</name>
            <description>WLAN ED DEBUG OFDM OR DSSS</description>
            <addressOffset>0x1FC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>OFDMORDSSSFORCE</name>
                <description>Enable debug mechanism for forcing ed_ofdm_or_dsss signal.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>OFDMORDSSSLEVEL</name>
                <description>Sets value of ed_ofdm_or_dsss signal when OFDM_OR_DSSS_FORCE is raised.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>WLAN_AGC</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WLAN_AGC</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0A000</addressOffset>
          <register>
            <name>CONTROLREGISTER</name>
            <description>WLAN AGC CONTROL REGISTER</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AGCMODRST</name>
                <description>Bit to reset the AGC process.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>MODULEEN</name>
                <description>Bit field to enable AGC module. 1-enable, 0-disable</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>INITGAINSELENABLE</name>
                <description>Bit to enable initial AGC gain selection.01</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>GAINSELTOGGLEENABLE</name>
                <description>Bit to enable registering of changes in Gain Selection.0-Disable1-Enable</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>ENRFSTATUSGAINSET</name>
                <description>Bit to enable Gain Changes due to RF RSSI STATUS.1-Enable0-Disable</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>ENPOPDETAGCDEFREEZE</name>
                <description>If Flag set to 1, then it allows to clear the AGC Trigger Disable flag when POP Event comes</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>HWENAGCTRIGGERDISABLE</name>
                <description>To assert AGC_TRIGGER_DISABLE through ED hardware. When ED is done then immediately AGC module is frozen to stop any further AGC updates. AGC module is released when ED module is reset.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>ENAACIDETECTIONLOGIC</name>
                <description>If Flag sets to 1, enables the AACI detection logic. '0' - AACI detection logic is disabled.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WAITTIME</name>
            <description>WLAN AGC WAIT TIME</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WAITTIME</name>
                <description>The number of cycles after which the final enable will be given to the module once the module enable is asserted high.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>RFRSSIVALIDGENWAITTIME</name>
                <description>This value indicates the number of valid samples we need to wait( for the settling of LNA ) to regenerate and read RF RSSI valid.the RSSI valid will be used in RF RSSI STATUS state in AGC fsm.</description>
                <lsb>10</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ESTPARAMETERS</name>
            <description>WLAN AGC EST PARAMETERS</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00100000</resetValue>
            <fields>
              <field>
                <name>ESTIMATIONMETHOD</name>
                <description>0: Variance based estimation, 1: Peak based estimation</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>ESTIMATIONLENGTHSELECTION</name>
                <description>Estimation window length selection0-8samples,1-16 samples,2-32 samples, 3-64 samples, 4-128 samples, 5-256samples, 6-512 samples</description>
                <lsb>1</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>AGCESTTRIGGERMETHOD</name>
                <description>Defines trigger method used in AGC:</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>AgcEstimationProcess</name>
                    <description>AGC estimation process starts only after ED Done.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AgcIsFreeRunningAndS</name>
                    <description>AGC is free running and starts adjusting the gain value if the absolute difference in RSSI (variance) and target value is not within the limits of lower and upper threshold or if clip count is more than certain threshold.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>NSYMBVARAVGSEL</name>
                <description>Number of symbol over which variance is averaged to use in AGC trigger condition:0: 1 symbol1: 2 symbols2: 4 symbols3: 8 symbols4: 16 symbolsEach symbol constitutes number of samples defined in (ESTIMATION_LENGTH_SELECTION)</description>
                <lsb>5</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>DISABLEDCSUBTRACTINESTIMATION</name>
                <description>Flag to disable or enable DC subtraction ( | E[X] |^2 ) while estimating the variance which is used to compute the gain.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>DISABLEBBGAINCHANGEINRFRSSISTATE</name>
                <description>This bit is used either to allow or disallow the base band gain increment, when LNA gain is reduced ( stage changed )in RF RSSI STATE due to compression signal.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>BBGAINLIMITVALUEINRFRSSISTATE</name>
                <description>This value is used to limit the allowed base band gain increment, when LNA gain is reduced ( stage changed )in RF RSSI STATE due to compression signal.</description>
                <lsb>10</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>ENINCRLNAGAININAGCESTSTATE</name>
                <description>This bit set to '1' will enable the logic that generates INCR request to LNA gain controller. '0' will disable the generation of INCR. This is applicable to both internal 3-bit RF RSSI LNA gain control mode and SLGC mode.</description>
                <lsb>18</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>ENDECRLNAGAININAGCESTSTATE</name>
                <description>This bit set to '1' will enable the logic that generates DECR request to LNA gain controller. '0' will disable the generation of DECR. This is applicable to both internal 3-bit RF RSSI LNA gain control mode and SLGC mode.</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>USEMVGAVGVARLIVE</name>
                <description>This bit when made '1' will enable the moving averager which averages the latest N values of individual variance estimates and also connect the corresponding dB value to the AGC live variance output ports and status registers. The port output will be used by the ED module for ACI detection.When this bit is '0', the moving averager is disabled and the variance estimate is sent out as live variance on the ports and status registers.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SETINITAGCGAIN</name>
            <description>WLAN AGC SET INIT AGC GAIN</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>INITAGCGAIN0</name>
                <description>Register for setting the initial AGC gain.2's complement of the value is considered for the field. So the range is from -128 to 127dB.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>INITAGCGAIN1</name>
                <description>2's complement of the value is considered for this field. So the range is from -128 to 127dB.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TARGETLEVEL</name>
            <description>WLAN AGC TARGET LEVEL</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>TARGETSIGLEVEL</name>
                <description>AGC target signal level in dB to which the gain need to be adjusted. Input to the field is given in 2's complement form. This can take values between -128dB and 127dB.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>DCCOMPENSATION</name>
                <description>DC head room in steps of 1dB.</description>
                <lsb>8</lsb>
                <msb>10</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CLIPLEVEL</name>
            <description>WLAN AGC CLIP LEVEL</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CLIPLEVEL</name>
                <description>The maximum value of ADC output beyond which clip is declared. This maximum value setting is valid for both I and Q samples at the output of ADC.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FIRSTAGCTRANSSETTINGSFIRSTITERATION1</name>
            <description>WLAN AGC FIRSTAGC TRANS SETTINGS FIRST ITERATION1</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AGCTRANSLENDEEPCLIPFIRSTITER</name>
                <description>AGC transient length to be used after applying the AGC cutback when deep clip conidition is observed.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>AGCTRANSLENMODERATECLIPFIRSTITER</name>
                <description>AGC transient length that is used after applying the AGC cutback when moderate clip conidition is observed.</description>
                <lsb>10</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FIRSTAGCTRANSSETTINGSFIRSTITERATION2</name>
            <description>WLAN AGC FIRSTAGC TRANS SETTINGS FIRST ITERATION2</description>
            <addressOffset>0x1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AGCTRANSLENNONZEROCLIPSCASEFIRSTITER</name>
                <description>A 10-bit value indicating the length in number of samples to skip for the AGC transient to settle.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FIRSTAGCCLIPSETTINGSFIRSTITERATION</name>
