              <field>
                <name>VARDCESTIMATIONLENGTH</name>
                <description>Number of symbol over which variance is computed after AGC estimation.0: 1 symbol1: 2 symbols2: 4 symbols3: 8 symbolsEach symbol constitutes number of samples defined in estimation length (ESTIMATION_LENGTH_1)</description>
                <lsb>1</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>DSSSCORRTHRESHPOSTAGCMANTISSA</name>
