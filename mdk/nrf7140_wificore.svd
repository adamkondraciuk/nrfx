            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AGCTRANSLENDEEPCLIPSECONDITER</name>
                <description>AGC transient length to be used after applying the AGC cutback when deep clip conidition is observed in second iteration.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>AGCTRANSLENMODERATECLIPSECONDITER</name>
