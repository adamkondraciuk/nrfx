            <name>RXPDECHTSIGL</name>
            <description>WLAN RTM FD RXPDEC HTSIG L</description>
            <addressOffset>0x1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDHTSIGLDATA</name>
