            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00001062</resetValue>
            <fields>
              <field>
                <name>WLANRTMTDSFOPPMCONVFACT</name>
                <description>Sampling Frequency Offset, time tracking conversion factor: value of [resampler factor] * OpBW/fc,where OpBw is the operating bandwidth and fc is the channel centre frequency. (u-4.20)Note: default value set for resampler factor = 1, OpBW = 20MHz and fc = 5GHz</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANRTMTDSFOBYPASS</name>
                <description>Bypass Sample Frequency Offset when set to 1</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANRTMTDFSBDETECTLENCRR</name>
                <description>Fine symbol boundary detection length correction factor (s5.0).</description>
                <lsb>18</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG3</name>
            <description>WLAN RTM TD CONFIG 3</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000400</resetValue>
            <fields>
              <field>
                <name>WLANRTMTDCCACONTROLDIS</name>
                <description>Disable / enable CCA control for correlation indication and status known (ED).Timer non-zero flag always zero when disabled.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANRTMTDSECONDAGCDIS</name>
                <description>Disable / enable AGC control for the second estimation (ED/AGC).</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANRTMTDSECONDAGCADJUST</name>
                <description>Second AGC start wait time adjustment in number of samples. (s6.0)</description>
                <lsb>2</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>WLANRTMTDSECONDAGCLENSEL</name>
                <description>Second AGC estimation window length selection: ceil(log2(0.8*Fs)) - 3, where Fs is the ADC sampling rate.Note: default value is set assuming Fs equals 40MHz</description>
                <lsb>9</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANRTMTDJRLENABLE</name>
                <description>Enable/disable Jammer Rejection Logic : ED threshold and minimum variance for OFDM correlation PASS increased toED RSSI snapshot + EdThresholdMargin when Jammer is detected.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLANRTMTDJRLDETECTIONTHRESHOLD</name>
                <description>Jammer Detection Threshold. Total number of s2lFails required to trigger Jammer detection - 1 (u3.0).</description>
                <lsb>13</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANRTMTDJRLEDTHRESHOLDMARGIN</name>
                <description>Headroom added to the minimum variance for OFDM correlation once Jammer signal is detected in dB (u3.0).</description>
                <lsb>16</lsb>
                <msb>18</msb>
              </field>
            </fields>
