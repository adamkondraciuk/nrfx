                </enumeratedValue>
                <enumeratedValue>
                  <name>Implemented</name>
                  <description>An 8-bit wide counter register is implemented.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TRIGGERED</name>
              <description>A trigger has occurred and the counter has reached 0.</description>
              <lsb>16</lsb>
              <msb>16</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotOccured</name>
                  <description>Trigger has not occurred.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Occured</name>
