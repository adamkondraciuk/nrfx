              <fields>
                <field>
                  <name>ETHERNETTYPE</name>
                  <description>Ethernet type information extracted from the packet.This field will be cleared at the start of every new packet.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L3HDRVERSION</name>
                  <description>Protocol Version extracted from the packet.This field will be cleared at the start of every new packet.</description>
