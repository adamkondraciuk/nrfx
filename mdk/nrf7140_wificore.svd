                <name>WLANTXPPOSTFECBITSAFTERPADLSB</name>
                <description>Number of data bits after the post-FEC padding - LSB</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPPOSTFECBITSAFTERPADMSB</name>
            <description>WLAN TXP POST FEC BITS AFTER PAD MSB</description>
            <addressOffset>0x1A4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPPOSTFECBITSAFTERPADMSB</name>
                <description>Number of data bits after the post-FEC padding - MSB</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPPEDURATIONANDDCMCONTROL</name>
            <description>WLAN TXP PE DURATION AND DCM CONTROL</description>
            <addressOffset>0x1A8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPPEDURATION</name>
                <description>Packet Extension Duration in microseconds</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLANTXPDCMENABLE</name>
                <description>If set to 1, enable Dual Carrier Modulation.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANTXPDCMSINGLEBITPADDING</name>
                <description>If set to 1, enable single-bit padding in BPSK bitstream every WLAN_TXP_DCM_BIT_INSERT_PERIOD bits.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>WLANTXPDCMBITINSERTPERIOD</name>
                <description>Period at which the zero bit is inserted.Relevant only if WLAN_TXP_DCM_SINGLE_BIT_PADDING is 1.</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Every50Bits</name>
                    <description>Every 50 bits</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Every116Bits</name>
                    <description>Every 116 bits</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPTXPOWERCONTROL</name>
            <description>WLAN TXP TX POWER CONTROL</description>
            <addressOffset>0x1AC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPTXPOWERELEZEROGALUT</name>
                <description>TX power value for which IQ imbalance values are stored in 0th index of Gain Angle LUT.Value is in dBm and it can be in the range of -10dBm to +20dBm.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANTXPTXPOWERELEZERODPDLUT</name>
                <description>TX power value for which DPD coefficient values are stored in 0th index of LUT.Value is in dBm and it can be in the range of -10dBm to +10dBm.</description>
                <lsb>6</lsb>
                <msb>10</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPNUMHELTF</name>
            <description>WLAN TXP NUM HE LTF</description>
            <addressOffset>0x1B0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPNUMHELTF</name>
                <description>Number of HE-LTF symbols. Encoded as follows:0: 11: 22: 43: 64: 85-7: Reserved</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPDIRECTCTRL</name>
            <description>WLAN TXP DIRECT CTRL</description>
            <addressOffset>0x1B4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPDIRECTINPUT</name>
                <description>Selects whether TXP input comes from previous pipeline stage or EDC (tbus).</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Tbus</name>
                    <description>TBus.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Direct</name>
                    <description>Direct.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPDIRECTOUTPUT</name>
                <description>Selects whether TXP output goes to next pipeline stage or EDC (tbus).</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Tbus</name>
                    <description>TBus.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Direct</name>
                    <description>Direct.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPAUTOCONFIGPHYONLY</name>
                <description>Defines auto-configuration for WLAN_TXP_DIRECT_INPUT:</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>TxpInputComesFromPre</name>
                    <description>TXP input comes from previous pipeline stage (i.e. MAC).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TxpInputComesFromEdc</name>
                    <description>TXP input comes from EDC (tbus)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPDEBUG</name>
            <description>WLAN TXP DEBUG</description>
            <addressOffset>0x1F0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPDEBUG</name>
                <description>Enable debug registers WLAN_TXP_DEBUG_VALID and WLAN_TXP_DEBUG_ENABLE</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ValidEnable</name>
                    <description>Valid, Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StickyValidSticky</name>
                    <description>Sticky(Valid), Sticky(Enable)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ValidEnableSticky</name>
                    <description>Valid &amp;amp; Enable, Sticky(Valid &amp;amp; Enable)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPDEBUGVALID</name>
            <description>WLAN TXP DEBUG VALID</description>
            <addressOffset>0x1F4</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPDEBUGVALID</name>
                <description>Live state of the valid flow control signals0: TXP WR1: Vector Parser Output2: Header Generator Output3: Preamble Generator Output4: Aggregation Input5: DSSS PLCP Input6: TXP Core Input7: DSSS Input8: DSSS Output9: Scrambler Output10: BCC Encoder Output11: Post-FEC Padding Output12: HE-ER-SU Logic Output13: Repacker Output14: DCM Logic Output15: Stream Parser Output16: ODFM Modulator Input17: Interleaver Input18: Interleaver Output19: Mapper Input20: Mapper Output21: Pilot Insertion Output22: TXP RD</description>
                <lsb>0</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPDEBUGENABLE</name>
            <description>WLAN TXP DEBUG ENABLE</description>
            <addressOffset>0x1F8</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPDEBUGENABLE</name>
                <description>Live state of the enable flow control signals0: TXP WR1: Vector Parser Output2: Header Generator Output3: Preamble Generator Output4: Aggregation Input5: DSSS PLCP Input6: TXP Core Input7: DSSS Input8: DSSS Output9: Scrambler Output10: BCC Encoder Output11: Post-FEC Padding Output12: HE-ER-SU Logic Output13: Repacker Output14: DCM Logic Output15: Stream Parser Output16: ODFM Modulator Input17: Interleaver Input18: Interleaver Output19: Mapper Input20: Mapper Output21: Pilot Insertion Output22: TXP RD</description>
                <lsb>0</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPDEBUGSIDEBAND</name>
            <description>WLAN TXP DEBUG SIDEBAND</description>
            <addressOffset>0x1FC</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPDEBUGSIDEBAND</name>
                <description>Live state of the sideband signal</description>
                <lsb>0</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DataField</name>
                    <description>Data Field</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LStf</name>
                    <description>L-STF</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LLtf</name>
                    <description>L-LTF</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HtStfForHtFormatHe</name>
                    <description>HT-STF for HT format, HE-STF for HE formats</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HtLtf1ForHtFormatH</name>
                    <description>HT-LTF1 for HT format, HE-LTF for HE formats</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LSig</name>
                    <description>L-SIG</description>
                    <value>0x9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HtSig</name>
                    <description>HT-SIG</description>
                    <value>0xA</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtSigA1</name>
                    <description>VHT-SIG-A1</description>
                    <value>0xB</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtSigA2</name>
                    <description>VHT-SIG-A2</description>
                    <value>0xC</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtSigB20Mhz</name>
                    <description>VHT-SIG-B 20MHz</description>
                    <value>0xD</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtSigB40Mhz</name>
                    <description>VHT-SIG-B 40MHz</description>
                    <value>0xE</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSigA</name>
                    <description>HE-SIG-A</description>
                    <value>0xF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>TXSCP</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_TXSCP</headerStructName>
          <access>read-write</access>
          <addressOffset>0x11000</addressOffset>
          <register>
            <dim>0x1</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>CONFIG[%s]</name>
            <description>Description collection: TXSCP CONFIG</description>
            <addressOffset>0x0</addressOffset>
            <access>read-only</access>
            <resetValue>0x000000FF</resetValue>
            <fields>
              <field>
                <name>TXSCPCFRPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the CFR block in the TX SCP.0: CFR not present.1: CFR present.Writing to field would not change its value.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>TXSCPDPDPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the DPD block in the TX SCP.0: DPD not present.1: DPD present.Writing to field would not change its value.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>TXSCPIQIMBALANCEPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the IQ imbalance block in the TX SCP.0: IQ imbalance not present.1: IQ imbalance present.Writing to field would not change its value.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>TXSCPINTERPOLATORPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the Interpolator block in the TX SCP.0: Interpolator not present.1: Interpolator present.Writing to field would not change its value.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>TXSCPRESAMPLERPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the Resampler block in the TX SCP.0: Resampler not present.1: Resampler present.Writing to field would not change its value.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>TXSCPMIXERPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the Mixer block in the TX SCP.0: Mixer not present.1: Mixer present.Writing to field would not change its value.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>TXSCPGAINANGLEPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the Gain Angle block in the TX SCP.0: Gain Angle not present.1: Gain Angle present.Writing to field would not change its value.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>TXSCPDCOFFSETPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the DC Offset block in the TX SCP.0: DC Offset not present.1: DC Offset present.Writing to field would not change its value.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>TXSCPCFRPREINTERPPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the pre interpolator block in the TX SCP.0: Pre interpolator not present.1: Pre interpolator present.Writing to field would not change its value.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>TXSCPPCFPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the PCF block in the TX SCP.0: PCF not present.1: PCF present.Writing to field would not change its value.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x1</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>CTRL[%s]</name>
            <description>Description collection: TXSCP CTRL</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000708</resetValue>
            <fields>
              <field>
                <name>MIXEROUTGAIN</name>
                <description>Selects Mixer output gain:0: Gain of 1.0 is applied to the output of Mixer rotator (default).1: Gain of 2.0 is applied to the output of Mixer rotator (used to compensate for 0.5 gain in real input mode).Relevant when MIXER_DISABLE = 0.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>MIXERINVERTSPECTRUM</name>
                <description>Selects Mixer spectrum inversion:0: The mixer output spectrum is not inverted.1: The mixer output spectrum is inverted by swapping I and Q.The mixer design under normal operation inverts the output I and Q samples even if this field is set to 0. To re-invert set field to 1.Relevant when MIXER_DISABLE = 0.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>RESAMPSCALINGFACTOR</name>
                <description>X8 output scaled by a factor of:</description>
                <lsb>2</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>025</name>
                    <description>0.25</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>050</name>
                    <description>0.50</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>100</name>
                    <description>1.00</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>200</name>
                    <description>2.00</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>IQIMBALANCEDISABLE</name>
                <description>Used to set the bypass mode of the IQ imbalance compensation block:</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>IqImbalanceCompensat</name>
                    <description>IQ imbalance compensation is active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>IqImbalanceCompensta</name>
                    <description>IQ imbalance compenstation block is powered down and data passes around it unaltered.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DPDDISABLE</name>
                <description>Used to set the bypass mode of the DPD block:</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DpdIsActive</name>
                    <description>DPD is active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DpdIsPoweredDownAndD</name>
                    <description>DPD is powered down and data passes around it unaltered.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CFRDISABLE</name>
                <description>Used to set the bypass mode of the CFR block:</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CfrIsActive</name>
                    <description>CFR is active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CfrIsPoweredDownAndD</name>
                    <description>CFR is powered down and data passes around it unaltered.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RESAMPLINGDISABLE</name>
                <description>Used to set the bypass mode for the resampling operation:</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ResamplingOperationA</name>
                    <description>Resampling operation active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ResamplingOperationP</name>
                    <description>Resampling operation powered down. The input data to the resampler is sent unaltered to the Mixer.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DCOFFSETDISABLE</name>
                <description>Used to set the bypass mode of the DC Offset block:</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DcOffsetBlockIsActiv</name>
                    <description>DC Offset block is active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DcOffsetBlockIsPower</name>
                    <description>DC Offset block is powered down and data passes around it unaltered.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GAINANGLEDISABLE</name>
                <description>Used to set the bypass mode of the Gain Angle block:</description>
                <lsb>9</lsb>
                <msb>9</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>GainAngleBlockIsActi</name>
                    <description>Gain Angle block is active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainAngleBlockIsPowe</name>
                    <description>Gain Angle block is powered down and data passes around it unaltered.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>MIXERDISABLE</name>
                <description>Used to set the bypass mode of the Mixer block:</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MixerBlockIsActive</name>
                    <description>Mixer block is active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MixerBlockIsPoweredD</name>
                    <description>Mixer block is powered down and data passes around it unaltered.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INTERPDISABLE</name>
                <description>Used to set the bypass mode of the interpolator in TX-SCP block:</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>InterpolatorIsActive</name>
                    <description>Interpolator is active (Interpolation factor I = 2).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>InterpolatorIsPowere</name>
                    <description>Interpolator is powered down. Data passes around it unaltered (Interpolation factor I = 1).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PCFENABLE</name>
                <description>Used to set the bypass mode of the PCF in TX-SCP block:</description>
                <lsb>12</lsb>
                <msb>12</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PcfIsPoweredDownAndD</name>
                    <description>PCF is powered down and data passes around it unaltered.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PcfIsActive</name>
                    <description>PCF is active.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PREINTERPOLCFRENABLE</name>
                <description>Used to set the bypass mode of the pre interpolator CFR in TX-SCP block:</description>
                <lsb>13</lsb>
                <msb>13</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PreInterpolatorCfrIs</name>
                    <description>Pre interpolator CFR is powered down and data passes around it unaltered.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PreInterpolatorCfrIs1</name>
