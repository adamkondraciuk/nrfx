            <fields>
              <field>
                <name>WLANFFTDIRECTINPUT</name>
                <description>Selects whether TXP input comes from previous pipeline stage or EDC (tbus).</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Tbus</name>
                    <description>TBus.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Direct</name>
                    <description>Direct.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANFFTDIRECTOUTPUT</name>
                <description>Selects whether TXP output goes to next pipeline stage or EDC (tbus).</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Tbus</name>
                    <description>TBus.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Direct</name>
                    <description>Direct.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>TBUSRDSIGNATURE</name>
            <description>WLAN FFT TBUS RD SIGNATURE</description>
            <addressOffset>0xB8</addressOffset>
            <access>read-only</access>
            <resetValue>0x00FFFFFF</resetValue>
            <fields>
              <field>
                <name>WLANFFTTBUSRDSIGNATURE</name>
                <description>TBus debug output data signature.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGGING</name>
            <description>WLAN FFT DEBUG</description>
            <addressOffset>0xBC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANFFTDEBUG</name>
                <description>Enable debug registers WLAN_FFT_DEBUG_VALID and WLAN_FFT_DEBUG_ENABLE</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ValidEnable</name>
                    <description>Valid, Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StickyValidSticky</name>
                    <description>Sticky(Valid), Sticky(Enable)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ValidEnableSticky</name>
                    <description>Valid &amp;amp; Enable, Sticky(Valid &amp;amp; Enable)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGVALID</name>
            <description>WLAN FFT DEBUG VALID</description>
            <addressOffset>0xC0</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANFFTDEBUGVALID</name>
                <description>Live state of the valid flow control signals0: FFT WR1: RTM TD Input2: RTM TD Output3: Null SC Insertion Input4: Null SC Insertion Output5: FFT Input FIFO Input6: FFT Input FIFO Output7: Engine Input8: Engine Output9: RTM FD Input10: RTM FD Output11: FFT Output FIFO Input12: FFT Output FIFO Output13: RTM FD Delay Buffer Input14: RTM FD Delay Buffer Output15: CPE Input16: CPE Output17: FFT RD</description>
                <lsb>0</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGENABLE</name>
            <description>WLAN FFT DEBUG ENABLE</description>
            <addressOffset>0xC4</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANFFTDEBUGENABLE</name>
                <description>Live state of the enable flow control signals0: FFT WR1: RTM TD Input2: RTM TD Output3: Null SC Insertion Input4: Null SC Insertion Output5: FFT Input FIFO Input6: FFT Input FIFO Output7: Engine Input8: Engine Output9: RTM FD Input10: RTM FD Output11: FFT Output FIFO Input12: FFT Output FIFO Output13: RTM FD Delay Buffer Input14: RTM FD Delay Buffer Output15: CPE Input16: CPE Output17: FFT RD</description>
                <lsb>0</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>WLAN_TXP_TOP</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WLAN_TXP_TOP</headerStructName>
          <access>read-write</access>
          <addressOffset>0x10000</addressOffset>
          <register>
            <name>WLANTXPCONTROL</name>
            <description>WLAN TXP CONTROL</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPSOFTWARERESET</name>
                <description>This register is used to perform a software reset on the WLAN_TXP.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NormalOperation</name>
                    <description>Normal Operation.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ResetAsserted</name>
                    <description>Reset Asserted.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPDISCARDEXTRAINPUT</name>
                <description>Selects whether extra input after end of packet should be silently discarded.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotSilentlyDiscard</name>
                    <description>Do not silently discard.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SilentlyDiscard</name>
                    <description>Silently discard.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPTXMODE</name>
                <description>Selects the modulation mode for the TXP.Note DSSS/CCK Modulation is only valid when WLAN_TXP_WIFI_11B_SUPPORT = 1. In such a case the DSSS PLCP preamble and header are added to the stream.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OfdmModulationDepen</name>
                    <description>OFDM Modulation. Depending on WLAN_TXP_STREAM_*_SIZE, all WLAN_TXP_NUM_OUTPUT_STREAM number of TBus read ports can be active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DsssCckModulationO</name>
                    <description>DSSS/CCK Modulation. Only TBus read port 1 is active.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPSCRAMBLERBYPASS</name>
                <description>Causes the OFDM/DSSS scrambler to be bypassed depending on the modulation in WLAN_TXP_TX_MODE.</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ScramblerActive</name>
                    <description>Scrambler active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ScramblerBypassed</name>
                    <description>Scrambler bypassed.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPENCODERSELECT</name>
                <description>Selects encoding scheme to be performed. Relevant when WLAN_TXP_TX_MODE is 0.Note this field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1. When WLAN_TXP_LDPC_ENCODER_PRESENT = 0 only convolutional encoding can be performed.</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ConvolutionalEncodin</name>
                    <description>Convolutional Encoding. Both inputs to the Stream Parser can be active depending on WLAN_TXP_NUM_CONV_ENCODER.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LdpcEncodingOnlyOne</name>
                    <description>LDPC Encoding. Only one input to the Stream Parser is active.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPNUMCONVENCODERACTIVE</name>
                <description>Selects the number of convolutional encoders active in pipeline. Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 0.Note this field is only valid if WLAN_TXP_NUM_CONV_ENCODER = 2. When WLAN_TXP_NUM_CONV_ENCODER = 1 only one convolutional encoder can be active.</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>1ConvolutionEncoderA</name>
                    <description>1 Convolution Encoder active. Convolutional Encoder Parser bypassed and only one active input to Stream Parser.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2ConvolutionEncoderA</name>
                    <description>2 Convolution Encoder active. Convolutional Encoder Parser alternates bits into each Convolutional Encoder. Both inputs to Stream Parser active.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPENCODERCODERATE</name>
                <description>Selects the code rate (k/n) of encoder selected from WLAN_TXP_ENCODER_SELECT. Where k is the number of information bits and n is the number of information plus parity bits.Relevant when WLAN_TXP_TX_MODE is 0.Note if WLAN_TXP_ENCODER_SELECT is 0.1) The convolutional encoder is a rate 1/2 code and appropriate puncturing is performed to bring the code rate to the desired value.2) Both convolutional encoders get same code rate.</description>
                <lsb>8</lsb>
                <msb>9</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Indicates12CodeRate</name>
                    <description>Indicates 1/2 code rate.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Indicates23CodeRate</name>
                    <description>Indicates 2/3 code rate.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Indicates34CodeRate</name>
                    <description>Indicates 3/4 code rate.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Indicates56CodeRate</name>
                    <description>Indicates 5/6 code rate.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPNUMSAMPPERSYM</name>
                <description>This is the number of samples per symbol. Represents values in the range 1 - 1024, where a value of zero written to the register would result in one sample per symbol.</description>
                <lsb>10</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLANTXPGENERATEEOP</name>
                <description>Generate an EOP flag at the end of the packet:</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DonTGenerateAnEopFl</name>
                    <description>Don't generate an EOP flag at the end of the packet</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GenerateAnEopFlagAtT</name>
                    <description>Generate an EOP flag at the end of the packet</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPSTREAMSIZES</name>
            <description>WLAN TXP STREAM SIZES</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPSTREAM1SIZE</name>
                <description>Selects the number of valid bits at the Stream 1 output of the Stream Parser. Relevant when WLAN_TXP_TX_MODE is 0.Note stream size of 4-bits is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1.</description>
                <lsb>0</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>StreamInActive</name>
                    <description>Stream In-active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize1Bit</name>
                    <description>Stream size 1 bit.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize2Bits</name>
                    <description>Stream size 2 bits.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize3Bits</name>
                    <description>Stream size 3 bits.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize4Bits</name>
                    <description>Stream size 4 bits.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPSTREAM2SIZE</name>
                <description>Selects the number of valid bits at the Stream 2 output of the Stream Parser. Relevant when WLAN_TXP_TX_MODE is 0.Note stream size of 4-bits is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1. Note this field is only valid if WLAN_TXP_NUM_OUTPUT_STREAM &amp;gt;= 2.</description>
                <lsb>4</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>StreamInActive</name>
                    <description>Stream In-active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize1Bit</name>
                    <description>Stream size 1 bit.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize2Bits</name>
                    <description>Stream size 2 bits.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize3Bits</name>
                    <description>Stream size 3 bits.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize4Bits</name>
                    <description>Stream size 4 bits.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPSTREAM3SIZE</name>
                <description>Selects the number of valid bits at the Stream 3 output of the Stream Parser. Relevant when WLAN_TXP_TX_MODE is 0.Note stream size of 4-bits is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1. Note this field is only valid if WLAN_TXP_NUM_OUTPUT_STREAM &amp;gt;= 3.</description>
                <lsb>8</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>StreamInActive</name>
                    <description>Stream In-active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize1Bit</name>
                    <description>Stream size 1 bit.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize2Bits</name>
                    <description>Stream size 2 bits.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize3Bits</name>
                    <description>Stream size 3 bits.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize4Bits</name>
                    <description>Stream size 4 bits.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPSTREAM4SIZE</name>
                <description>Selects the number of valid bits at the Stream 4 output of the Stream Parser. Relevant when WLAN_TXP_TX_MODE is 0.Note stream size of 4-bits is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1. Note this field is only valid if WLAN_TXP_NUM_OUTPUT_STREAM = 4.</description>
                <lsb>12</lsb>
                <msb>14</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>StreamInActive</name>
                    <description>Stream In-active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize1Bit</name>
                    <description>Stream size 1 bit.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize2Bits</name>
                    <description>Stream size 2 bits.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize3Bits</name>
                    <description>Stream size 3 bits.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StreamSize4Bits</name>
                    <description>Stream size 4 bits.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPSCRAMBLERSTATE</name>
            <description>WLAN TXP SCRAMBLER STATE</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPSCRAMBLERSTATE</name>
                <description>OFDM or DSSS scrambler initial state. The scrambler state is pseudo-random for OFDM and fixed for DSSS. Scrambler state can be changed to any value by writing to this register.Current scrambler state can be observed by reading from register.</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPNUMOPSYM</name>
            <description>WLAN TXP NUM OP SYM</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPNUMOPSYM</name>
                <description>Denotes the number of output symbols expected from the TXP.Represents values in the range 1 - 65536, where a value of zero written to the register would result in one symbol. The TXP will give TXP_FIELD_END indication after these many number of symbols have been given out. One symbol consists of NUM_SAMP_PER_SYM samples.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPINTERLEAVER1CONTROL</name>
            <description>WLAN TXP INTERLEAVER 1 CONTROL</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPINTERLEAVER1NROWS</name>
                <description>This field specifies the number of active rows in the TXP Bit Interleaver.Note that each 'row' element holds Nbpsc bits of data.Valid values are shown below; other values are reserved and should not be used.Legacy: 3HT20: 4HT40: 6VHT80:9HE: 1, 3, 6, 9, 12Relevant when WLAN_TXP_TX_MODE is 0.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER1NCOLS</name>
                <description>This field specifies the number of active columns in the TXP Bit Interleaver (i.e. row width).Valid values are shown below; other values are reserved and should not be used.Legacy: 16HT20: 13HT40: 18VHT80:26HE: 4, 8, 13, 16, 17, 24, 26, 39Note that the maximum number of columns is 18 when WLAN_TXP_WIFI_AC_SUPPORT = 0.Relevant when WLAN_TXP_TX_MODE is 0.</description>
                <lsb>4</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER1BUFFERSIZE</name>
                <description>This register specifies the number of buffer storage elements required for TXP Bit Interleaver operation.Note that each buffer storage element holds Nbpsc bits of data.It is defined as WLAN_TXP_INTERLEAVER_1_NROWS multiplied by WLAN_TXP_INTERLEAVER_1_NCOLS - the value in this register is ONLY valid when it is derived from valid values in those two registers.</description>
                <lsb>11</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER1CONSTMAPMODE</name>
                <description>Specifies the constellation mapping mode.Valid values are below.Other values are reserved and should not be used.000:BPSK (Constellation size M = 2) (Nbpsc = 1, Nbpsc/2 = 1 rounded up from 0.5)001:QPSK (Constellation size M = 4) (Nbpsc = 2, Nbpsc/2 = 1)010:16-QAM (Constellation size M =16) (Nbpsc = 4, Nbpsc/2 = 2)011:64-QAM (Constellation size M =64) (Nbpsc = 6, Nbpsc/2 = 3)100: 256-QAM (Constellation size M = 256) (Nbpsc = 8, Nbpsc/2 = 4)Relevant when WLAN_TXP_TX_MODE is 0. Note mapping mode of 256-QAM is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1.</description>
                <lsb>20</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPINTERLEAVER2CONTROL</name>
            <description>WLAN TXP INTERLEAVER 2 CONTROL</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPINTERLEAVER2NROWS</name>
                <description>This field specifies the number of active rows in the TXP Bit Interleaver.Note that each 'row' element holds Nbpsc bits of data.Valid values are shown below; other values are reserved and should not be used.Legacy: 3HT20: 4HT40: 6VHT80:9HE: 1, 3, 6, 9, 12Relevant when WLAN_TXP_TX_MODE is 0.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER2NCOLS</name>
                <description>This field specifies the number of active columns in the TXP Bit Interleaver (i.e. row width).Valid values are shown below; other values are reserved and should not be used.Legacy: 16HT20: 13HT40: 18VHT80:26HE: 4, 8, 13, 16, 17, 24, 26, 39Note that the maximum number of columns is 18 when WLAN_TXP_WIFI_AC_SUPPORT = 0.Relevant when WLAN_TXP_TX_MODE is 0.</description>
                <lsb>4</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER2BUFFERSIZE</name>
                <description>This register specifies the number of buffer storage elements required for TXP Bit Interleaver operation.Note that each buffer storage element holds Nbpsc bits of data.It is defined as WLAN_TXP_INTERLEAVER_2_NROWS multiplied by WLAN_TXP_INTERLEAVER_2_NCOLS - the value in this register is ONLY valid when it is derived from valid values in those two registers.</description>
                <lsb>11</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER2CONSTMAPMODE</name>
                <description>Specifies the constellation mapping mode.Valid values are below.Other values are reserved and should not be used.000:BPSK (Constellation size M = 2) (Nbpsc = 1, Nbpsc/2 = 1 rounded up from 0.5)001:QPSK (Constellation size M = 4) (Nbpsc = 2, Nbpsc/2 = 1)010:16-QAM (Constellation size M =16) (Nbpsc = 4, Nbpsc/2 = 2)011:64-QAM (Constellation size M =64) (Nbpsc = 6, Nbpsc/2 = 3)100: 256-QAM (Constellation size M = 256) (Nbpsc = 8, Nbpsc/2 = 4)Relevant when WLAN_TXP_TX_MODE is 0. Note mapping mode of 256-QAM is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1.</description>
                <lsb>20</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPINTERLEAVER3CONTROL</name>
            <description>WLAN TXP INTERLEAVER 3 CONTROL</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPINTERLEAVER3NROWS</name>
                <description>This field specifies the number of active rows in the TXP Bit Interleaver.Note that each 'row' element holds Nbpsc bits of data.Valid values are shown below; other values are reserved and should not be used.Legacy: 3HT20: 4HT40: 6VHT80:9HE: 1, 3, 6, 9, 12Relevant when WLAN_TXP_TX_MODE is 0.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER3NCOLS</name>
                <description>This field specifies the number of active columns in the TXP Bit Interleaver (i.e. row width).Valid values are shown below; other values are reserved and should not be used.Legacy: 16HT20: 13HT40: 18VHT80:26HE: 4, 8, 13, 16, 17, 24, 26, 39Note that the maximum number of columns is 18 when WLAN_TXP_WIFI_AC_SUPPORT = 0.Relevant when WLAN_TXP_TX_MODE is 0.</description>
                <lsb>4</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER3BUFFERSIZE</name>
                <description>This register specifies the number of buffer storage elements required for TXP Bit Interleaver operation.Note that each buffer storage element holds Nbpsc bits of data.It is defined as WLAN_TXP_INTERLEAVER_3_NROWS multiplied by WLAN_TXP_INTERLEAVER_3_NCOLS - the value in this register is ONLY valid when it is derived from valid values in those two registers.</description>
                <lsb>11</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER3CONSTMAPMODE</name>
                <description>Specifies the constellation mapping mode.Valid values are below.Other values are reserved and should not be used.000:BPSK (Constellation size M = 2) (Nbpsc = 1, Nbpsc/2 = 1 rounded up from 0.5)001:QPSK (Constellation size M = 4) (Nbpsc = 2, Nbpsc/2 = 1)010:16-QAM (Constellation size M =16) (Nbpsc = 4, Nbpsc/2 = 2)011:64-QAM (Constellation size M =64) (Nbpsc = 6, Nbpsc/2 = 3)100: 256-QAM (Constellation size M = 256) (Nbpsc = 8, Nbpsc/2 = 4)Relevant when WLAN_TXP_TX_MODE is 0. Note mapping mode of 256-QAM is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1.</description>
                <lsb>20</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPINTERLEAVER4CONTROL</name>
            <description>WLAN TXP INTERLEAVER 4 CONTROL</description>
            <addressOffset>0x1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPINTERLEAVER4NROWS</name>
                <description>This field specifies the number of active rows in the TXP Bit Interleaver.Note that each 'row' element holds Nbpsc bits of data.Valid values are shown below; other values are reserved and should not be used.Legacy: 3HT20: 4HT40: 6VHT80:9HE: 1, 3, 6, 9, 12Relevant when WLAN_TXP_TX_MODE is 0.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER4NCOLS</name>
                <description>This field specifies the number of active columns in the TXP Bit Interleaver (i.e. row width).Valid values are shown below; other values are reserved and should not be used.Legacy: 16HT20: 13HT40: 18VHT80:26HE: 4, 8, 13, 16, 17, 24, 26, 39Note that the maximum number of columns is 18 when WLAN_TXP_WIFI_AC_SUPPORT = 0.Relevant when WLAN_TXP_TX_MODE is 0.</description>
                <lsb>4</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER4BUFFERSIZE</name>
                <description>This register specifies the number of buffer storage elements required for TXP Bit Interleaver operation.Note that each buffer storage element holds Nbpsc bits of data.It is defined as WLAN_TXP_INTERLEAVER_4_NROWS multiplied by WLAN_TXP_INTERLEAVER_4_NCOLS - the value in this register is ONLY valid when it is derived from valid values in those two registers.</description>
                <lsb>11</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER4CONSTMAPMODE</name>
                <description>Specifies the constellation mapping mode.Valid values are below.Other values are reserved and should not be used.000:BPSK (Constellation size M = 2) (Nbpsc = 1, Nbpsc/2 = 1 rounded up from 0.5)001:QPSK (Constellation size M = 4) (Nbpsc = 2, Nbpsc/2 = 1)010:16-QAM (Constellation size M =16) (Nbpsc = 4, Nbpsc/2 = 2)011:64-QAM (Constellation size M =64) (Nbpsc = 6, Nbpsc/2 = 3)100: 256-QAM (Constellation size M = 256) (Nbpsc = 8, Nbpsc/2 = 4)Relevant when WLAN_TXP_TX_MODE is 0. Note mapping mode of 256-QAM is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1.</description>
                <lsb>20</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPLDPCCONTROL</name>
            <description>WLAN TXP LDPC CONTROL</description>
            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPLDPCZBLOCKSIZE</name>
                <description>Selects the Z-block size of the LDPC encoder. Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 1.Note this field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ZBlockSize27Bits</name>
                    <description>Z-Block Size 27 bits.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ZBlockSize54Bits</name>
                    <description>Z-Block Size 54 bits.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ZBlockSize81Bits</name>
                    <description>Z-Block Size 81 bits.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>InvalidValue</name>
                    <description>Invalid value.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPLDPCNUMPARITYREPETITIONBLOCKS</name>
                <description>Defines the number of LDPC blocks equal to or below which:1) The number of parity bits is 1 less than the value configured in WLAN_TXP_LDPC_PARITY_BITS if WLAN_TXP_LDPC_REPETITION_ACTIVE is 0.2) The number of repetition bits is 1 more than the value configured in WLAN_TXP_LDPC_REPETITION_BITS if WLAN_TXP_LDPC_REPETITION_ACTIVE is 1.Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 1. Note :1) This field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.2) Represents values in the range 0 to 65535 if WLAN_TXP_WIFI_AC_SUPPORT = 1 or 0 to 1023 otherwise.</description>
                <lsb>4</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPLDPCNUMMESSAGEBLOCKS</name>
            <description>WLAN TXP LDPC NUM MESSAGE BLOCKS</description>
            <addressOffset>0x24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPLDPCNUMMESSAGEBLOCKS</name>
                <description>Defines the number of LDPC blocks equal to or below which the number of message bits is 1 less than the value configured in WLAN_TXP_LDPC_MESSAGE_BITS. Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 1.Note:1) This field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.2) Represents values in the range 0 to 65535 if WLAN_TXP_WIFI_AC_SUPPORT = 1 or 0 to 1023 otherwise.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPLDPCMESSAGEPARITYBITS</name>
            <description>WLAN TXP LDPC MESSAGE PARITY BITS</description>
            <addressOffset>0x28</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPLDPCMESSAGEBITS</name>
                <description>Defines the number of valid message bits in k information bits of a LDPC code word, the remaining bits are zero padded in order to perform block encoding (shortening).Value written to this field and WLAN_TXP_LDPC_NUM_MESSAGE_BLOCKS should be chosen such that the number of valid message bits lie in the range 1 to k-bits. Where the maximum value of k-bits supported by the code word can be obtained from WLAN_TXP_LDPC_Z_BLOCK_SIZE and WLAN_TXP_LDPC_CODE_RATE.Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 1. Note this field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.</description>
                <lsb>0</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>WLANTXPLDPCPARITYBITS</name>
                <description>Defines the number of valid parity bits in (n-k) parity bits of a LDPC code word, the remaining bits are discarded. Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 1.Note :1) Value written to this field and WLAN_TXP_LDPC_NUM_PARITY_REPETITION_BLOCKS should be chosen such that the number of valid parity bits lie in the range 1 to (n-k)-bits. Where the maximum value of (n-k)-bits supported by the code word can be obtained from WLAN_TXP_LDPC_Z_BLOCK_SIZE and WLAN_TXP_LDPC_CODE_RATE.2) In case WLAN_TXP_LDPC_REPETITION_ACTIVE is 1 the number of valid parity bits has to be equal to the maximum value of (n-k) bits.3) This field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.</description>
                <lsb>12</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPLDPCREPETITION</name>
            <description>WLAN TXP LDPC REPETITION</description>
            <addressOffset>0x2C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPLDPCREPETITIONBITS</name>
                <description>Defines the number of repetition bits to be given out by the LDPC encoder after the message and parity bits. Relevant when WLAN_TXP_TX_MODE is 0, WLAN_TXP_ENCODER_SELECT is 1 and WLAN_TXP_LDPC_REPETITION_ACTIVE is set to 1.Repetition starts with the first valid message bits and continues with the valid parity bits. The valid message and parity bits are resent in this order until the required number of repetition bits have been sent out of the LDPC encoder.Note:1) This field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.2) Note the value written to this field and WLAN_TXP_LDPC_NUM_PARITY_REPETITION_BLOCKS should be chosen such that the number of repetition bits lie in the range 1 to 65535 if WLAN_TXP_WIFI_AC_SUPPORT = 1 or 1 to 8191 otherwise.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANTXPLDPCREPETITIONACTIVE</name>
                <description>Selects if the message and parity bits need to be repeated. Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 1.Note this field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RepetitionInActive</name>
                    <description>Repetition In-active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RepetitionActive</name>
                    <description>Repetition Active.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x30</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>WLANTXPLDPCHSUBROTATION[%s]</name>
            <description>Description collection: WLAN TXP LDPC H SUB ROTATION</description>
            <addressOffset>0x30</addressOffset>
            <access>read-write</access>
            <resetValue>0x007F7F7F</resetValue>
            <fields>
              <field>
                <name>WLANTXPLDPCHSUBROTATION0</name>
                <description>Defines the amount of right cyclic shift that needs to be performed on the 3n identity sub-matrix to form the H (parity check) matrix. Valid range is 0 to the Z-block size defined by WLAN_TXP_LDPC_Z_BLOCK_SIZE. Value of 127 defines a null matrix.Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 1. Note this field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>WLANTXPLDPCHSUBROTATION1</name>
                <description>Defines the amount of right cyclic shift that needs to be performed on the 3n + 1 identity sub-matrix to form the H (parity check) matrix. Valid range is 0 to the Z-block size defined by WLAN_TXP_LDPC_Z_BLOCK_SIZE. Value of 127 defines a null matrix.Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 1. Note this field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.</description>
                <lsb>8</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>WLANTXPLDPCHSUBROTATION2</name>
                <description>Defines the amount of right cyclic shift that needs to be performed on the 3n + 2 identity sub-matrix to form the H (parity check) matrix. Valid range is 0 to the Z-block size defined by WLAN_TXP_LDPC_Z_BLOCK_SIZE. Value of 127 defines a null matrix.Relevant when WLAN_TXP_TX_MODE is 0 and WLAN_TXP_ENCODER_SELECT is 1. Note this field is only valid if WLAN_TXP_LDPC_ENCODER_PRESENT = 1.</description>
                <lsb>16</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPAGGRMPDUDELIMITER</name>
            <description>WLAN TXP AGGR MPDU DELIMITER</description>
            <addressOffset>0xF4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPAGGRMPDUDELIMITER</name>
                <description>Defines the first 16 bits of MPDU delimiter</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPAGGRNUMFLUSHBYTES</name>
            <description>WLAN TXP AGGR NUM FLUSH BYTES</description>
            <addressOffset>0xF8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPAGGRNUMFLUSHBYTES</name>
                <description>Defines the number of zero flush bytes that need to be added by the TXP Aggregation module at the end of a field. Represents values in the range 0 - 1023.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPAGGRNUMPAYLOADBYTES</name>
            <description>WLAN TXP AGGR NUM PAYLOAD BYTES</description>
            <addressOffset>0xFC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPAGGRNUMPAYLOADBYTES</name>
                <description>Defines the number of payload bytes (including 4 byte of CRC-32 if WLAN_TXP_AGGR_ADD_CRC32 is 1) that need to be sent as part of MPDU data by the TXP Aggregation.Represents values in the range 0 - 1048575.</description>
                <lsb>0</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPAGGRSERVICEBYTES</name>
            <description>WLAN TXP AGGR SERVICE BYTES</description>
            <addressOffset>0x100</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPAGGRSERVICEBYTES</name>
                <description>Defines the first service byte that needs to be added to the output of the TXP Aggregation module, where:1) Bits [7-0] represent the first byte which is needed to compute the descrambler initial state.2) Bits [15-8] represent the second byte which is the CRC-8 computed over VHT Sig-B field or zero for formats other than VHT.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPAGGRNUMNULLMPDU</name>
            <description>WLAN TXP AGGR NUM NULL MPDU</description>
            <addressOffset>0x104</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPAGGRNUMNULLMPDU</name>
                <description>Defines the number of zero length MPDUs with:1) EOF set to 0 that need to be added between two consecutive MPDUs in an A-MPDU to provide the minimum MPDU Start Spacing field.2) EOF set to 1 that need to be added after the last non-zero length MPDU to provide EOF padding.Sent by the TXP Aggregation.Represents values in the range 0 - 8191.</description>
                <lsb>0</lsb>
                <msb>12</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPAGGRCONTROL</name>
            <description>WLAN TXP AGGR CONTROL</description>
            <addressOffset>0x108</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPAGGRADDDELIMITER</name>
                <description>Defines whether MPDU Delimiter needs to be transferred before MPDU data to form an A-MPDU subframe by the TXP Aggregation.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MpduDelimiterNotTran</name>
                    <description>MPDU Delimiter not transferred.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MpduDelimiterTransfe</name>
                    <description>MPDU Delimiter transferred.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPAGGRADDCRC32</name>
                <description>Enable or Disable CRC-32 computation on the MPDU data in the TXP Aggregation.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Crc32NotComputed</name>
                    <description>CRC-32 not computed.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Crc32ComputedAndApp</name>
                    <description>CRC-32 computed and appended after payload.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPAGGRNUMPADBYTES</name>
                <description>Defines the number of zero pad bytes that need to be appended after the MPDU data for all A-MPDU sub-frames by the TXP Aggregation, except the last one, so that the (WLAN_TXP_AGGR_NUM_PAYLOAD_BYTES + WLAN_TXP_AGGR_NUM_PAD_BYTES) is a multiple of 4.Represents values in the range 0 - 3.</description>
                <lsb>2</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANTXPAGGRNUMEOFPADBYTES</name>
                <description>Defines the number of zero pad bytes that need to be appended after the last A-MPDU sub-frame by the TXP Aggregation to make A-MPDU length equal to PSDU length or a multiple of 4, whichever occurs first.Represents values in the range 0 - 3.</description>
                <lsb>4</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANTXPAGGRTXFIELD</name>
                <description>Selects the field for which TXP Aggregation is being configured.Note if VHT Sig-B field is being processed the input data is sent to the TXP Aggregation circular buffer. TXP Aggregation should only receive 4 input bytes in this case.Note this field is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1.</description>
                <lsb>8</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LegacyOrHtHighThrou</name>
                    <description>Legacy or HT (High Throughput) fields.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtVeryHighThroughp</name>
                    <description>VHT (Very High Throughput) all other fields.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtVeryHighThroughp4</name>
                    <description>VHT (Very High Throughput) Sig-B field20 MHz,4 bytes taken out of the TXP Aggregation.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtVeryHighThroughp5</name>
                    <description>VHT (Very High Throughput) Sig-B field40 MHz,7 bytes taken out of the TXP Aggregation.</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtVeryHighThroughp6</name>
                    <description>VHT (Very High Throughput) Sig-B field80 MHz, 15 bytes taken out of the TXP Aggregation.</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtVeryHighThroughp7</name>
                    <description>VHT (Very High Throughput) Sig-B field 160 MHz, 30 bytes taken out of the TXP Aggregation.</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPAGGRVHTBITINDEX</name>
                <description>Selects the bit index from which tail bit zero forcing of the output of the OFDM scrambler is enabled for the first flush bytes sent out of the TXP Aggregation at the end of a field.Relevant when WLAN_TXP_AGGR_TX_FIELD is 011 - 111; WLAN_TXP_ENCODER_SELECT is 0; and WLAN_TXP_AGGR_NUM_FLUSH_BYTES is not 0.Note this field is only valid if WLAN_TXP_WIFI_AC_SUPPORT = 1.</description>
                <lsb>11</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>WLANTXPAGGRBYPASS</name>
                <description>Causes the TXP Aggregation to be bypassed.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>AggregationNormalOpe</name>
                    <description>Aggregation normal operation.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AggregationBypassed</name>
                    <description>Aggregation bypassed.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXP11BMODECONTROL</name>
            <description>WLAN TXP 11B MODE CONTROL</description>
            <addressOffset>0x10C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXP11BPACKETFORMAT</name>
                <description>Selects the 802.11b data packet format.Note this field is only valid if WLAN_TXP_WIFI_11B_SUPPORT = 1.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LongDataPacketFormat</name>
                    <description>Long data packet format.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ShortDataPacketForma</name>
                    <description>Short data packet format.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXP11BDATARATE</name>
                <description>Selects the transmission data rate.Note this field is only valid if WLAN_TXP_WIFI_11B_SUPPORT = 1.</description>
                <lsb>1</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>1Mbps</name>
                    <description>1 Mbps.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2Mbps</name>
                    <description>2 Mbps.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>55Mbps</name>
                    <description>5.5 Mbps.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>11Mbps</name>
                    <description>11 Mbps.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXP11BLOCKEDCLOCKS</name>
                <description>Indicates that the transmit frequency and symbol clocks are derived from the same oscillator. This bit shall be set by the PHY layer based on its implementation configuration.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPINTERLEAVER1CONTROL2</name>
            <description>WLAN TXP INTERLEAVER 1 CONTROL 2</description>
            <addressOffset>0x110</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPINTERLEAVER1INIREADPOINTER</name>
                <description>Registers WLAN_TXP_INTERLEAVER_n_INI_ROW_SWAP_TYPE/INI_COL_OFFSET/INI_ROW_OFFSET/INI_READ_POINTER control Stage 3 interleaving.To turn off Hardware Stage 3 interleaving set all four registers to 0.To turn on Hardware Stage 3 interleaving configure all four registers correctly with non-zero values.This register specifies the initial value of the read pointer for reading the first element of bits from the read buffer.The value in this register is calculated as follows:((WLAN_TXP_INTERLEAVER_n_INI_ROW_OFFSET * WLAN_TXP_INTERLEAVER_n_NCOLS) + WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET)</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER1INIROWOFFSET</name>
                <description>Registers WLAN_TXP_INTERLEAVER_n_INI_ROW_SWAP_TYPE/INI_COL_OFFSET/INI_ROW_OFFSET/INI_READ_POINTER control Stage 3 interleaving.To turn off Hardware Stage 3 interleaving set all four registers to 0.To turn on Hardware Stage 3 interleaving configure all four registers correctly with non-zero values.Stage 3 Interleaver, Initial Row Offset. This is the row which holds the first Nbpsc read bits after rotation has been applied.Note that a Row is made up of elements, each element holds Nbpsc bits.Row Offset is computed from the equation in section 2.2.3 (Third interleaver stage), is given in Table 3.Note 1. WLAN_TXP_INTERLEAVER_n_INI_ROW_OFFSET has the range 0 to WLAN_TXP_INTERLEAVER_n_NROWS-1Note 2. The valid values for this register can be found in the HW TRM, see section 7.4.9 (TXP Interleaver).These are derived from the Row Offset equation in the same location.</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER1INICOLOFFSET</name>
                <description>Registers WLAN_TXP_INTERLEAVER_n_INI_ROW_SWAP_TYPE/INI_COL_OFFSET/INI_ROW_OFFSET/INI_READ_POINTER control Stage 3 interleaving.To turn off Hardware Stage 3 interleaving set all four registers to 0.To turn on Hardware Stage 3 interleaving configure all four registers correctly with non-zero values.Stage 3 Interleaver, Initial Column offset.This is the column which holds the first Nbpsc read bits after rotation has been applied.Note that a Column is made up of elements, each element holds Nbpsc bits.Note 1. WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET has the range 0 to WLAN_TXP_INTERLEAVER_n_NCOLS-1.Note 2. The valid values for this register can be found in the HW TRM, see section 7.4.9 (TXP Interleaver).These are derived from the Row Offset equation in the same location.</description>
                <lsb>12</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER1INIROWSWAPTYPE</name>
                <description>Registers WLAN_TXP_INTERLEAVER_n_INI_ROW_SWAP_TYPE/INI_COL_OFFSET/INI_ROW_OFFSET/INI_READ_POINTER control Stage 3 interleaving.To turn off Hardware Stage 3 interleaving set all four registers to 0.To turn on Hardware Stage 3 interleaving configure all four registers correctly with non-zero values.This register is used to specify the row swapping type in use in the column WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET.It is only used when the modulation, set in register WLAN_TXP_INTERLEAVER_n_CONST_MAP_MODE, is set to a modulation scheme that requires row swapping - i.e. not BPSK (Nbpsc = 1) or QPSK (Nbpsc = 2).The value in this register is calculated as follows:For16-QAM (Nbpsc = 4): WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET percent2i.e. 0x0 when WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET is an even number0x1 when WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET is an odd numberFor64-QAM (Nbpsc = 6): WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET percent3i.e. 0x0 when WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET is 0,3,6, 9,12,etc0x1 when WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET is 1,4,7,10,13,etc0x2 when WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET is 2,5,8,11,14,etcFor 256-QAM (Nbpsc = 8): WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET percent4i.e. 0x0 when WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET is 0,4, 8,12,etc0x1 when WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET is 1,5, 9,13,etc0x2 when WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET is 2,6,10,14,etc0x3 when WLAN_TXP_INTERLEAVER_n_INI_COL_OFFSET is 3,7,11,15,etc</description>
                <lsb>20</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER1LDPCMODE</name>
                <description>Defines the data processing mode when WLAN_TXP_ENCODER_SELECT=1 (i.e. LDPC Encoder is selected).When WLAN_TXP_ENCODER_SELECT=0 this register setting is not relevant.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LdpcToneMappingNotEn</name>
                    <description>LDPC Tone Mapping not enabled.Bypass the Interleaver logic such that received data is output unmodified (i.e. non-VHT frames)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LdpcToneMappingEnabl</name>
                    <description>LDPC Tone Mapping enabled.Apply LDPC Tone Mapping to data received in the Interleaver as configured in register WLAN_TXP_INTERLEAVER_n_CONTROL (i.e. VHT frames).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPINTERLEAVER2CONTROL2</name>
            <description>WLAN TXP INTERLEAVER 2 CONTROL 2</description>
            <addressOffset>0x114</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPINTERLEAVER2INIREADPOINTER</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_READ_POINTER</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER2INIROWOFFSET</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_ROW_OFFSET</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER2INICOLOFFSET</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_COL_OFFSET</description>
                <lsb>12</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER2INIROWSWAPTYPE</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_ROW_SWAP_TYPE</description>
                <lsb>20</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER2LDPCMODE</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_LDPC_MODE</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPINTERLEAVER3CONTROL2</name>
            <description>WLAN TXP INTERLEAVER 3 CONTROL 2</description>
            <addressOffset>0x118</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPINTERLEAVER3INIREADPOINTER</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_READ_POINTER</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER3INIROWOFFSET</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_ROW_OFFSET</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER3INICOLOFFSET</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_COL_OFFSET</description>
                <lsb>12</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER3INIROWSWAPTYPE</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_ROW_SWAP_TYPE</description>
                <lsb>20</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER3LDPCMODE</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_LDPC_MODE</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPINTERLEAVER4CONTROL2</name>
            <description>WLAN TXP INTERLEAVER 4 CONTROL 2</description>
            <addressOffset>0x11C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPINTERLEAVER4INIREADPOINTER</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_READ_POINTER</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER4INIROWOFFSET</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_ROW_OFFSET</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER4INICOLOFFSET</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_COL_OFFSET</description>
                <lsb>12</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER4INIROWSWAPTYPE</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_INI_ROW_SWAP_TYPE</description>
                <lsb>20</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER4LDPCMODE</name>
                <description>For description see WLAN_TXP_INTERLEAVER_1_LDPC_MODE</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPMAPPERANDPILOTCONTROL</name>
            <description>WLAN TXP MAPPER AND PILOT CONTROL</description>
            <addressOffset>0x120</addressOffset>
            <access>read-write</access>
            <resetValue>0x00040000</resetValue>
            <fields>
              <field>
                <name>WLANTXPRESOURCEUNITALLOCATION</name>
                <description>Used to determine the number of non null sub-carriers.Valid ranges of values are [0-8, 9-17, 37-40, 41-44, 53-56, 61-62, 65].Only applicable for HE packets.</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>WLANTXPPACKETTYPE</name>
                <description>Selects packet type:0 : Legacy1 : HT_MF2 : HT_GF3 : VHT4 : HE_SU5 : HE_MU6 : HE_ER_SU7 : HE_TBPackets 0-3 (Legacy, HT_MF, HT_GF, VHT) are in Pre-HE group with OFDM symbollength of 3.2us. HE packets have 12.8us OFDM symbol length.</description>
                <lsb>7</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANTXPDACHOLDOFF</name>
                <description>Selects DAC output hold-off</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DacOutputHoldOffSpe</name>
                    <description>DAC output hold-off specified by WLAN_CTRL_TX_HOLDOFF</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DacOutputHoldOffSpe1</name>
                    <description>DAC output hold-off specified by WLAN_CTRL_TX_HOLDOFF+WLAN_CTRL_TX_EXTRA_HOLDOFF</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPPREAMBLESTART</name>
                <description>Selects condition to start the preamble generator</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>StartPreambleGenerat</name>
                    <description>Start preamble generator after last byte of TX vector is received</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StartPreambleGenerat1</name>
                    <description>Start preamble generator after first payload byte after the AMPDU delimiter is received</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPSIGNALBANDWIDTH</name>
                <description>Selects samples per symbolNOTE: signal_bandwidth can have different value than channel bandwidth.Please sse the note for the WLAN_TXP_CHANNEL_BANDWIDTH field.</description>
                <lsb>12</lsb>
                <msb>13</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPCHANNELBANDWIDTH</name>
                <description>Selects samples per symbolNOTE: Channel bandwidth can have different value than signal bandwidth in case of Legacy packet type.For Legacy packet type signal bandwidth will always be 20MHz. In this case if channel bandwidth isset to 40MHz Legacy packet will be duplicated and if channel bandwidth is set to 80MHz Legacy packetwill be copied over four segments. Duplication will be handled after TXP (IFFT) and TXP will performcoresponding scaling of I and Q components (over 52, 104 or 208 non-null sub-carriers).Channel bandwidth is not auto-configured and it should be configured to STA Operating bandwidth.</description>
                <lsb>14</lsb>
                <msb>15</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPCHAINMODE</name>
                <description>Selects chain mode. HT-packets only.0 : 1x11 : 2x2 (chain 1)2 : 2x2 (chain 2)3 : reservedIt determines the sign of pilots.</description>
                <lsb>16</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>WLANTXPPILOTBYPASS</name>
                <description>Pilots insertion control.</description>
                <lsb>18</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>InsertPilots</name>
                    <description>Insert pilots</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Bypass</name>
                    <description>Bypass</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPHELTFTYPE</name>
                <description>Type of HE-LTF preamble. For HE formats only.</description>
                <lsb>19</lsb>
                <msb>20</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>1XHeLtf</name>
                    <description>1x HE-LTF</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2XHeLtf</name>
                    <description>2x HE-LTF</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>4XHeLtf</name>
                    <description>4x HE-LTF</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPHEGI</name>
                <description>Guard interval for HE frames.</description>
                <lsb>21</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>08Us</name>
                    <description>0.8us</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16Us</name>
                    <description>1.6us</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>32Us</name>
                    <description>3.2us</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPEVENTSTATUS</name>
            <description>WLAN TXP EVENT STATUS</description>
            <addressOffset>0x124</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPFIELDENDSTATUS</name>
                <description>This field indicates the current status of the txp_field_end event. Value of 1 indicates field has ended. Write any value to register to clear flag.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPSTATE</name>
            <description>WLAN TXP STATE</description>
            <addressOffset>0x128</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000010</resetValue>
            <fields>
              <field>
                <name>WLANTXPSTREAMPARSEROUTPUTSTATE</name>
                <description>This is a read-only field. Value read out indicates the output state of the Stream Parser in the TXP Core.0: Output enabled, normal operation.1: Output disabled after required symbols and samples have been sent out. Re-enable by asserting a soft or hard reset on the entire TXP (this will also reset any data in the pipeline).Writing to field would not change its value.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANTXPAGGRIDLE</name>
                <description>This is a read-only field. Value read out indicates the state of the TXP Aggregation.0: Aggregation busy, should not be reconfigured to process next job.1: Aggregation idle, can be reconfigured to process next job.Writing to field would not change its value.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPCONFIG</name>
            <description>WLAN TXP CONFIG</description>
            <addressOffset>0x12C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000427</resetValue>
            <fields>
              <field>
                <name>WLANTXPLDPCENCODERPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the LDPC encoder in the TXP.0: LDPC encoder not present.1: LDPC encoder present.Writing to field would not change its value.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANTXPWIFIACSUPPORT</name>
                <description>This is a read-only field. Value read out indicates 802.11ac support in the TXP.0: 802.11ac not supported.1: 802.11ac supported.Writing to field would not change its value.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANTXPWIFI11BSUPPORT</name>
                <description>This is a read-only field. Value read out indicates 802.11b support in the TXP.0: 802.11b not supported.1: 802.11b supported.Writing to field would not change its value.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLANTXPNUMCONVENCODER</name>
                <description>This is a read-only field. Value read out indicates the number of convolutional encoders present in the TXP. Writing to field would not change its value.</description>
                <lsb>4</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANTXPNUMOUTPUTSTREAM</name>
                <description>This is a read-only field. Value read out indicates the number of output streams present in the TXP. Writing to field would not change its value.</description>
                <lsb>8</lsb>
                <msb>10</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPCOREOPCONTROL</name>
            <description>WLAN TXP CORE OP CONTROL</description>
            <addressOffset>0x130</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANTXPCORESTREAM1OPDISCARD</name>
                <description>Discard debug mode output when WLAN_TXP_CORE_STREAM_1_OP_MODE = 1:</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OutputToPbusDebugMo</name>
                    <description>Output to PBus (debug mode).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DiscardOutput</name>
                    <description>Discard output.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPCORESTREAM2OPDISCARD</name>
                <description>Discard debug mode output when WLAN_TXP_CORE_STREAM_2_OP_MODE = 1:Note this field is only valid if WLAN_TXP_NUM_OUTPUT_STREAM &amp;gt;= 2.</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OutputToPbusDebugMo</name>
                    <description>Output to PBus (debug mode).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DiscardOutput</name>
                    <description>Discard output.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPCORESTREAM3OPDISCARD</name>
                <description>Discard debug mode output when WLAN_TXP_CORE_STREAM_3_OP_MODE = 1:Note this field is only valid if WLAN_TXP_NUM_OUTPUT_STREAM &amp;gt;= 3.</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OutputToPbusDebugMo</name>
                    <description>Output to PBus (debug mode).</description>
