                <lsb>0</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RXPDECVHTSIGBL</name>
            <description>WLAN RTM FD RXPDEC VHTSIGB L</description>
            <addressOffset>0x28</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDVHTSIGBLDATA</name>
                <description>VHT-SIG-B / HE-SIG-B decoded data - bits 23 .. 0</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RXPDECVHTSIGBH</name>
