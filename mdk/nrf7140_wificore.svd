          <register>
            <name>CTRL</name>
            <description>WLAN TIMERS CTRL</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>SOFTRESET</name>
                <description>Timers core soft reset.This bit is used to reset everything but the control registers.The soft reset should be applied after reprogramming the control registers and setting TIMERS_ENABLE.0: De-assert reset to core1: Assert reset to core</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>TIMERSENABLE</name>
                <description>Timers module enable/disable.0: Disable1: Enable</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DIVIDER</name>
            <description>WLAN TIMERS DIVIDER</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00040027</resetValue>
            <fields>
              <field>
                <name>DIVIDERMICROSEC</name>
                <description>Timers microsecond divider.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>DIVIDERMILLISEC</name>
                <description>Timers millisecond divider.NOTE: In the current implementation, when the milli second counter has reached the value 0x1,and the micro second counter has reached 0x0, then on the occurence of the enxt 40MHz clock pulsethe milli second counter is initialised to the DIVIDER_MILLI_SEC field value.</description>
                <lsb>8</lsb>
                <msb>23</msb>
              </field>
            </fields>
