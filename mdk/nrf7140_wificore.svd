                    <name>IqImbalanceCompensat</name>
                    <description>IQ imbalance compensation is active.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>IqImbalanceCompensta</name>
                    <description>IQ imbalance compenstation block is powered down and data passes around it unaltered.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
