          <register>
            <name>OFDMRTMFDEOPSNAPSHOTLSB</name>
            <description>WLAN CTRL OFDM RTM FD EOP SNAPSHOT LSB</description>
            <addressOffset>0x64</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLOFDMRTMFDEOPSNAPSHOTLSB</name>
                <description>LSB of snapshot of time measurement counter, taken when OFDM Receiver Training Mode - FD EOP goes high</description>
