            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLCCABUSYCOUNTER</name>
                <description>CCA busy window counter in Core clock cycles.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>NUMPAYLOADBYTESFORDEASSERTION</name>
            <description>WLAN CTRL NUM PAYLOAD BYTES FOR DEASSERTION</description>
            <addressOffset>0x3C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLNUMPAYLOADBYTESFORDEASSERTION</name>
                <description>Number of payload bytes after which PHY_RX_Request is deasserted.This value is set such that PHY-RX-Request is asserted till MAC hardware checkswhether MAC address of receiving packet is matching with expected address,i.e., this number should cover more than 10 bytes of MPDU.Typical value is 20 considering A-MPDU and some margin for MAC address matching.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TMCOUNTERMSB</name>
            <description>WLAN CTRL TM COUNTER MSB</description>
            <addressOffset>0x40</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLTMCOUNTERMSB</name>
                <description>MSB of Counter used for time measurement snapshots</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TMCOUNTERLSB</name>
            <description>WLAN CTRL TM COUNTER LSB</description>
            <addressOffset>0x44</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLTMCOUNTERLSB</name>
                <description>LSB of Counter used for time measurement snapshots</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ADCFIRSTSAMPLESNAPSHOTMSB</name>
            <description>WLAN CTRL ADC FIRST SAMPLE SNAPSHOT MSB</description>
            <addressOffset>0x48</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLADCFIRSTSAMPLESNAPSHOTMSB</name>
                <description>MSB of snapshot of time measurement counter, taken when first sample of ADC goes valid</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ADCFIRSTSAMPLESNAPSHOTLSB</name>
            <description>WLAN CTRL ADC FIRST SAMPLE SNAPSHOT LSB</description>
            <addressOffset>0x4C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLADCFIRSTSAMPLESNAPSHOTLSB</name>
                <description>LSB of snapshot of time measurement counter, taken when first sample of ADC goes valid</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
