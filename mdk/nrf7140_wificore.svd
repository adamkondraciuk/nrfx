        </cluster>
        <cluster>
          <name>WLAN_FFT</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WLAN_FFT</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0F000</addressOffset>
          <register>
            <name>CONTROL</name>
            <description>WLAN FFT CONTROL</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x0000004C</resetValue>
            <fields>
              <field>
                <name>FFTDONEEFCLEAR</name>
                <description>0 : Do nothing1 : Clear the event flag WLAN_FFT_DONE_EF_STATUSThis bit automatically returns to 0</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>FFTBYPASS</name>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PerformFftIfftOpera</name>
                    <description>Perform FFT/IFFT operation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Bypass</name>
                    <description>Bypass</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMTDBYPASS</name>
                <description>Set the Receiver Training Mode - Time Domain in bypass:</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotBypassRxTrainin</name>
                    <description>Do not bypass Rx Training Mode Time Domain</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BypassRxTrainingMode</name>
                    <description>Bypass Rx Training Mode Time Domain</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRTMFDBYPASS</name>
                <description>Set the Receiver Training Mode - Frequency Domain in bypass:Note: The RTM-FD is set in bypass when FFT_BYPASS is 1.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotBypassRxTrainin</name>
                    <description>Do not bypass Rx Training Mode Time Domain</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BypassRxTrainingMode</name>
                    <description>Bypass Rx Training Mode Time Domain</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>IFFT</name>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PerformFftOperation</name>
                    <description>Perform FFT operation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PerformIfftOperation</name>
                    <description>Perform IFFT operation</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LDPCENABLED</name>
                <lsb>5</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LdpcDecodingIsDisabl</name>
                    <description>LDPC decoding is disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LdpcDecodingIsEnable</name>
                    <description>LDPC decoding is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANFFTCONFIGAUTOMATIC</name>
                <description>Enable automatic configuration of the WLAN_FFT.</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ManualConfigurationM</name>
                    <description>Manual configuration mode</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AutomaticConfigurati</name>
                    <description>Automatic configuration mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANFFTDYNAMICSIZE</name>
                <description>Dynamic FFT size enable.</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FftSizeConfiguredByT</name>
                    <description>FFT size configured by the FFT_RADIX_PASS1/IFFT_RADIX_PASS1 registers.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FftSizeConfiguredByS</name>
                    <description>FFT size configured by sideband signal.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>IFFTRADIXPASS1</name>
                <description>Select the radix used on the first IFFT pass.Options are0-5 : reserved6 : radix=647 : radix=1288 : radix=2569 : radix=51210-15 : reserved</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>FFTRADIXPASS1</name>
                <description>Select the radix used on the first FFT pass.Options are0-5 : reserved6 : radix=647 : radix=1288 : radix=2569 : radix=51210-15 : reserved</description>
                <lsb>12</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>FFTINPUTSHIFT</name>
                <description>0 : No data shift at the input of the FFT engine.Input to FFT engine is in [0..N-1] order, where N is size of FFT.1 : Data at the input of the FFT engine is shifted such that thesecond half of input vector is swapped with the first half.Input to FFT engine is in [N/2..N-1,0,..N/2-1] order.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANEDMIDPACKET</name>
                <description>Mid-packet energy detection flag:</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DsssOrOfdmPacketDete</name>
                    <description>DSSS or OFDM packet detected</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MidPacketDetected</name>
                    <description>MID packet detected</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANFFTDISABLEPHYRESET</name>
                <description>Disable automatic PHY reset.</description>
                <lsb>18</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PhyWillAutomatically</name>
                    <description>PHY will automatically reset</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PhyWillNotAutomatica</name>
                    <description>PHY will not automatically reset</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DCMENABLED</name>
                <lsb>19</lsb>
                <msb>19</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DcmDecodingIsDisable</name>
                    <description>DCM decoding is disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DcmDecodingIsEnabled</name>
                    <description>DCM decoding is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LATCHEDSOFTWARERESET</name>
                <lsb>22</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RemoveReset</name>
                    <description>Remove reset</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ApplyReset</name>
                    <description>Apply reset</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PULSEDSOFTWARERESET</name>
                <description>0 : Do nothing1 : Apply a pulsed software resetThis bit is automatically returns to 0</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SHIFTVALUES</name>
            <description>WLAN FFT SHIFT VALUES</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>SHIFTVALUESTAGE1P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 1.Options are as above</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE2P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 2.Options are as above</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE3P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 3.Options are as above</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE4P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 4.Options are as above</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE5P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 5.Options are as above</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE6P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 6.Options are as above</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE7P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 7.Options are as above</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE8P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 8.Options are as above</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE9P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 9.Options are as above</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>OFDMCONFIG</name>
            <description>WLAN FFT OFDM CONFIG</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>INSERTGUARD</name>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNothing</name>
                    <description>Do nothing</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ForTransmitInsertGu</name>
                    <description>For transmit, insert Guard to the FFT output data stream</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INSERTSUBCARRIERS</name>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNothing</name>
                    <description>Do nothing</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ForTransmitInsertNu</name>
                    <description>For transmit, insert null sub-carriers into the FFT input data stream.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>REMOVESUBCARRIERS</name>
                <description>0: Do nothing1: For receive, remove the null sub-carriers from the FFT output data stream.Pilots will be outputted first following by data sub-carriers.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>GUARDDURATION</name>
                <description>Specifies the guard duration to be inserted or removed:</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>04Us</name>
                    <description>0.4us</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>08Us</name>
                    <description>0.8us</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16Us</name>
                    <description>1.6us</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>32Us</name>
                    <description>3.2us</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RXPCPECFOEST</name>
                <description>When set enables the CFO estimation based on the CPE.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>RXPCPENOPILOTSHIFT</name>
                <description>When set disables the pilot shift.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>RXPCPESTBC</name>
                <description>Selects STBC mode. HT-packets only.</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NonStbc</name>
                    <description>non-STBC</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Stbc</name>
                    <description>STBC</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RXPCPEBYPASS</name>
                <description>CPE compensation control.0 : CPE compensation1 : BypassThis field is used when REMOVE_SUB_CARRIERS is active (RX mode).In both cases pilots will be discarded but when bypass is not activeCPE compensation will be performed.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>OPERATINGWINDOW</name>
                <description>For receive selects the operating window when the channel bandwidth is not equal to the signal bandwidth0 : -3 Most lower operating window1 : -1 Lower operating window2 : +1 Upper operating window3 : +3 Most upper operating windowWhen the channel bandwidth is 40MHz and the signal bandwidth is 20MHz, the operating window should be configured toeither value 1 (lower operating window) or 2 (upper operating window). When the channel bandwidth is 80MHz and the signalbandwidth is 20MHz, the operating window should be configured to either value 1, 2, 3, or 4. 80MHz cbw/ 40MHz sbwshould follow the first case.</description>
                <lsb>10</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>HELTFTYPE</name>
                <description>Type of HE-LTF preamble. For HE formats only.</description>
                <lsb>12</lsb>
                <msb>13</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>1XHeLtf</name>
                    <description>1x HE-LTF</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2XHeLtf</name>
                    <description>2x HE-LTF</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>4XHeLtf</name>
                    <description>4x HE-LTF</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SIGNALBANDWIDTH</name>
                <description>Selects the signal bandwidth0 : 20MHz1 : 40MHz2 : 80MHz3 : reservedMust be equal or less than CHANNEL_BANDWIDTH.For receive, see the OPERATING_WINDOW description.For transmit, when signal bandwidth is less than channel bandwidth, input OFDM symbol will be duplicatedbefore performing inverse FFT. If channel bandwidth is two times signal bandwidth then OFDM symbol will beduplicated and if channel bandwidth is four times signal bandwidth then OFDM symbol will be quadrupled.</description>
                <lsb>14</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>RXCHANNELBANDWIDTH</name>
                <description>Selects the channel bandwidth</description>
                <lsb>17</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TXCHANNELBANDWIDTH</name>
                <description>Selects the channel bandwidth</description>
                <lsb>20</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>OFDMCONFIG2</name>
            <description>WLAN FFT OFDM CONFIG 2</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>PACKETTYPE</name>
                <description>Selects packet type:0 : Legacy1 : HT-MF2 : HT-GF3 : VHT4 : HE-SU5 : HE-MU6 : HE-ER7 : HE-TBPackets 0-3 (Legacy, HT_MF, HT_GF, VHT) are in Pre-HE group with OFDM symbol length of 3.2us.HE packet has 12.8us OFDM symbol length.NOTE: Whenever packet_type is configured the initial state of scrambler will be set accordingly.Scrambler is used within CPE block to generate PN sequence for pilot sign generation. PN sequencehas 127 elements and cyclically repeats after 127 OFDM symbols.</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>HEMUPPDUSIGBW</name>
                <description>Operating BW of the BSS (Basic Service Set):NOTE: only used for HE-MU packets</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20 MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40 MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80 MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PPDU20MHZOFFSET</name>
                <description>Selects the 20MHz partition of the PPDU bandwidth (up to 80 MHz supported):0-1: when BSS operating bandwidth is 40 MHz0-3: when BSS operating bandwidth is 80 MHzNOTE: only used when HE-MU packet and HEMU_PPDU_SIGBW &amp;gt;= 40 MHz</description>
                <lsb>6</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>RESOURCEUNIT</name>
                <description>Used to determine the positions of pilot and null sub-carriers.Valid range of values for SIGNAL_BANDWIDTH = 20 MHz are [0-8, 37-40, 53-54, 61].Valid range of values for SIGNAL_BANDWIDTH = 40 MHz are [0-17, 37-44, 53-56, 61-62, 65].Only applicable for HE packets.(SIGNAL_BANDWIDTH in WLAN_FFT_OFDM_CONFIG register)</description>
                <lsb>8</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>PEDURATION</name>
                <description>Duration of Packet Extension in microseconds. Only applicable for HE packets.</description>
                <lsb>15</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>ROTATIONMODE</name>
                <lsb>20</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoRotation</name>
                    <description>No rotation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RotationByGammaFacto</name>
                    <description>Rotation by gamma factor for 40MHz signal bandwidth</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RotationByGammaFacto2</name>
                    <description>Rotation by gamma factor for 80MHz signal bandwidth</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DUPLICATIONMODE</name>
                <lsb>22</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoDuplication</name>
                    <description>No duplication</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OfdmSymbolDuplicated</name>
                    <description>OFDM symbol duplicated prior to IFFT</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OfdmSymbolQuadrupled</name>
                    <description>OFDM symbol quadrupled prior to IFFT</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
