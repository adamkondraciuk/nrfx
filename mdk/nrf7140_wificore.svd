              <field>
                <name>WLANCTRLTXEXTRAHOLDOFF</name>
                <description>Specify extra TX hold-off to delay TX output to the DAC.This extra hold-off can be selected through the TX vector.Units are core clock cycles.</description>
                <lsb>0</lsb>
                <msb>13</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WATCHDOG</name>
            <description>WLAN CTRL WATCHDOG</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00050000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLWATCHDOGEFSTATUS</name>
                <description>WLAN watchdog event flag status.Latched high when watchdog timer reaches programmed thresholdCan be forced high by writing 1 to this register for debug purposes (to test event flag connectivity in hardware and software).</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANCTRLWATCHDOGEFENABLE</name>
                <description>WLAN watchdog event flag enable.ANDed with WLAN_CTRL_WATCHDOG_EF_STATUS before generating EF output from block.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANCTRLWATCHDOGEFCLEAR</name>
                <description>WLAN watchdog event flag acknowledge/clear.Write 1 to clear WLAN_CTRL_WATCHDOG_EF_STATUS.Writing 0 has no effect.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLANCTRLWATCHDOGTIMEOUTMS</name>
                <description>Specify watchdog timeout in milliseconds. Zero means the watchdog event flag is disabled.</description>
                <lsb>4</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANCTRLWATCHDOGCYCLESPER1US</name>
                <description>Configure the number of core clock cycles per microsecond.</description>
                <lsb>12</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGPHYRESET</name>
            <description>WLAN CTRL DEBUG PHY RESET</description>
            <addressOffset>0x1C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
