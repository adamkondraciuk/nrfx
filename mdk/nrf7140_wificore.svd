                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SecondAgcIsControlle</name>
                    <description>Second AGC is controlled by the receiver training mode (SECOND_AGC_EN register is overwritten)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
