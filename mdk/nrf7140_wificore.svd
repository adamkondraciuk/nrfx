            <addressOffset>0x7C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AGCTRIGGERLOWERRSSITHRESH</name>
                <description>contains threshold value in dB for triggering AGC gain estimation when AGC is free running. If Computed Variance - Target Variance is less than 0 and if Abs(Computed_Variance - Target_Variance) is more than threshold.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>AGCTRIGGERUPPERRSSITHRESH</name>
                <description>Contains threshold value in dB for triggering AGC gain estimation when AGC is free running. If Computed Variance - Target Variance is greater than 0 and if Abs(Computed_Variance - Target_Variance) is more than threshold.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
