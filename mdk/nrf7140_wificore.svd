          <register>
            <name>TXABORTCONTROL</name>
            <description>WLAN CTRL TX ABORT CONTROL</description>
            <addressOffset>0x54</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLTXABORTCONTROL</name>
                <description>Control to assert wlan_ctrl_rx_on when TX_ABORT is received.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotAssertWlanCtrl</name>
                    <description>Do not assert wlan_ctrl_rx_on</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AssertWlanCtrlRxO</name>
                    <description>Assert wlan_ctrl_rx_on when abort_status is high</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>OFDMRTMSCPEOPSNAPSHOTMSB</name>
