            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>PSMPINITVALUE</name>
                <description>A write to this register loads the initial Load value into the PSMP timer.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCACTRLAC0</name>
            <description>WLAN TIMERS EDCA CTRL AC0</description>
            <addressOffset>0x150</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>ENABLEAC011N</name>
                <description>Enabled setting this bit to '1' enables channel contention for ac0 category and generates an interrupt after winning channel. when this is set contention_start_ac0 has no effect.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>BWSELAC0</name>
                <description>00: Channel contention is for bandwidth 20MHz or above (20/40/80/160).01: Channel contention is for bandwidth 40MHz or above (40/80/160). If channel is idle only for 20MHz bandwidth then participate in contention till 40MHz bandwidth or above is won.10: Channel contention is for bandwidth 80MHz or above (80/160). If channel is idle only for less than 80MHz bandwidth then participate in contention till 80MHz bandwidth or above is won.11: Channel contention is for bandwidth 160MHz. If channel is idle only for less than 160MHz bandwidth then participate in contention till 160MHz bandwidth is won.Setting this bit to '1' enables channel contention for AC0 category and generates an interrupt after winning channel. When this is set CONTENTION_START_AC0 has no effect.</description>
                <lsb>1</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>CONTENTIONSTARTAC0</name>
                <description>When this bit is set to '1', EDCA timer participates in channel contention. If it wins channel, it waits tillENABLEAC1_11N is set before generating interrupt. In case channel busy condition arises after winning channelbefore setting ENABLEAC1_11N, it participates in channel contention again.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SECDIFSAC0</name>
            <description>WLAN TIMERS SECDIFS AC0</description>
            <addressOffset>0x154</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>DIFSAC0</name>
