          <register>
            <name>DSCPARAMETER</name>
            <description>This register configures Display Stream Compression</description>
            <addressOffset>0x0F0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>COMPRESSIONMODE</name>
                <description>When set to 1, this bit enables the compression mode.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>COMPRESSALGO</name>
                <description>This field indicates the algorithm identifier:</description>
                <lsb>8</lsb>
                <msb>9</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ALGO0</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ALGO1</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ALGO2</name>
                    <description>Unspecified</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ALGO3</name>
                    <description>Unspecified</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PPSSEL</name>
                <description>This field indicates the  PPS selector:</description>
                <lsb>16</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PPSSEL0</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PPSSEL1</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PPSSEL2</name>
                    <description>Unspecified</description>
                    <value>0x2</value>
                  </enumeratedValue>
