              <addressOffset>0x000</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <fields>
                <field>
                  <name>DPDCOEFFA10</name>
                  <description>DPD Coefficient A10. Relevant when DPD_DISABLE = 0.</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
