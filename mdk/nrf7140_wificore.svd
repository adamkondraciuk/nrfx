                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>GENERATEEOP</name>
            <description>WLAN LDPC DECODER GENERATE EOP</description>
            <addressOffset>0x28</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANLDPCDECODERGENERATEEOP</name>
                <description>Generate an EOP flag at the end of the packet:</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
