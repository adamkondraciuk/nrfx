            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>IQFILTERB0</name>
                <description>Filter Coefficient B0 for Quadrature phase stream. This is a Q10 format (i.e. output of filter is right-shifted by 10 bits) 2's complement value.Relevant when IQ_IMBALANCE_DISABLE = 0.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>IQFILTERB1</name>
                <description>Filter Coefficient B1 for Quadrature phase stream. This is a Q10 format (i.e. output of filter is right-shifted by 10 bits) 2's complement value.Relevant when IQ_IMBALANCE_DISABLE = 0.</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>IQIMBCOEFF2</name>
            <description>TXSCP IQ IMB COEFF2</description>
            <addressOffset>0x380</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>IQFILTERB2</name>
                <description>Filter Coefficient B2 for Quadrature phase stream. This is a Q10 format (i.e. output of filter is right-shifted by 10 bits) 2's complement value.Relevant when IQ_IMBALANCE_DISABLE = 0.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>IQFILTERB3</name>
                <description>Filter Coefficient B3 for Quadrature phase stream. This is a Q10 format (i.e. output of filter is right-shifted by 10 bits) 2's complement value.Relevant when IQ_IMBALANCE_DISABLE = 0.</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
            </fields>
