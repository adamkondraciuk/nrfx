    <peripheral>
      <name>GLOBAL_STMDATA_NS</name>
      <description>System Trace Macrocell data buffer 0</description>
      <baseAddress>0xA0000000</baseAddress>
      <headerStructName>STMDATA</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
      <!--Split access-->
      <addressBlock>
        <offset>0</offset>
        <size>0x10000000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>STMDATA</groupName>
      <size>0x20</size>
      <registers>
        <cluster>
          <dim>16</dim>
          <dimIncrement>0x2000000</dimIncrement>
          <name>DOMAIN[%s]</name>
          <description>Unspecified</description>
          <headerStructName>DOMAIN</headerStructName>
          <access>read-write</access>
          <addressOffset>0x000</addressOffset>
          <register>
            <dim>0x1000000</dim>
            <dimIncrement>0x1</dimIncrement>
            <name>NSDATA[%s]</name>
            <description>Description collection: NonSecure STM output data buffer for domain n. Writes to this region generates trace packets with id n+96.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <dataType>uint8_t</dataType>
            <size>0x8</size>
            <!--Security securemapping=NS-->
          </register>
          <register>
            <dim>0x1000000</dim>
            <dimIncrement>0x1</dimIncrement>
            <name>SDATA[%s]</name>
            <description>Description collection: Secure STM output data buffer for domain n. Writes to this region generates trace packets with id n+32.</description>
            <addressOffset>0x1000000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <dataType>uint8_t</dataType>
            <size>0x8</size>
            <!--Security securemapping=S-->
          </register>
        </cluster>
        <cluster>
          <dim>16</dim>
          <dimIncrement>0x1000000</dimIncrement>
          <name>BUFFER[%s]</name>
          <description>Raw buffer access to STM array. Use when DOMAIN array does not apply.</description>
          <headerStructName>BUFFER</headerStructName>
          <alternateCluster>DOMAIN[%s]</alternateCluster>
          <access>read-write</access>
          <addressOffset>0x000</addressOffset>
          <register>
            <dim>0x1000000</dim>
            <dimIncrement>0x1</dimIncrement>
            <name>DATA[%s]</name>
            <description>Description collection: STM output data buffer n. Writes to this region generates trace packets.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <dataType>uint8_t</dataType>
            <size>0x8</size>
            <!--Security securemapping=S-->
          </register>
        </cluster>
