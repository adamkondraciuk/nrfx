                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RXPDECHESIGAE</name>
            <description>WLAN RTM FD RXPDEC HESIGA E</description>
            <addressOffset>0x24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANRTMFDHESIGAEDATA</name>
