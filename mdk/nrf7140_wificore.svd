            <field>
              <name>SWOMAN</name>
              <description>Indicates whether Serial Wire Output, Manchester encoded format, is supported.</description>
              <lsb>10</lsb>
              <msb>10</msb>
              <enumeratedValues>
                <enumeratedValue>
