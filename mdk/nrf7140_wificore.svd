            <addressOffset>0x220</addressOffset>
            <register>
              <name>DEBUGSTAT</name>
              <description>Description cluster: EDC SYS DEBUG STAT</description>
              <addressOffset>0x000</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <fields>
                <field>
                  <name>ITEMSLEFT</name>
                  <description>The number of items remaining in each DMA transfer, represented in 'natural' format.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>TRANSFERSLEFT</name>
                  <description>When TRANSFERS_MODE=0:The number of DMA transfers remaining in the DMA job, represented in 'natural' format.When TRANSFERS_MODE=1:ITEMS_LEFT[23:0].</description>
                  <lsb>16</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGENDEBUGSTAT</name>
              <description>Description cluster: EDC SYS AGEN DEBUG STAT</description>
              <addressOffset>0x004</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <fields>
                <field>
                  <name>AGENITEMSLEFT</name>
                  <description>The number of Address Generator items remaining in each DMA transfer, represented in 'natural' format.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>AGENTRANSFERSLEFT</name>
                  <description>When TRANSFERS_MODE=0:The number of Address Generator DMA transfers remaining in the DMA job, represented in 'natural' format.When TRANSFERS_MODE=1:ITEMS_LEFT[23:0].</description>
                  <lsb>16</lsb>
                  <msb>23</msb>
                </field>
                <field>
                  <name>AGENBURSTLEFT</name>
                  <description>The number of Address Generator items remaining in each burst transfer, represented in 'natural' format.</description>
                  <lsb>28</lsb>
                  <msb>31</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <register>
            <name>STATCTRL</name>
            <description>EDC SYS STAT CTRL</description>
            <addressOffset>0x424</addressOffset>
            <access>read-write</access>
            <resetValue>0x40000000</resetValue>
            <fields>
              <field>
                <name>STATREQSEL</name>
                <description>Requestor to accumulate statistics for when STAT_REQ_ALL=0.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>STATREQALL</name>
                <description>Statistic accumulation request selection:</description>
                <lsb>30</lsb>
                <msb>30</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>AccumulateStatistics</name>
                    <description>Accumulate statistics for STAT_REQ_SEL requestor only.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AccumulateStatistics1</name>
                    <description>Accumulate statistics across all requestors.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>STATREQENABLE</name>
                <description>Statistic accumulation control:</description>
                <lsb>31</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>AccumulationOfStatis</name>
                    <description>Accumulation of statistics disabled (power saving mode).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AccumulationOfStatis1</name>
                    <description>Accumulation of statistics enabled (debug mode).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DCPCYCLECNT</name>
            <description>EDC SYS DCP CYCLE CNT</description>
            <addressOffset>0x428</addressOffset>
