            <addressOffset>0x80</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>SETINITGAININTRIGGERSTATE</name>
                <description>In method-2 if this flag sets then if agc trigger happens due to decrease in signal power then we will set the gain to initial gain.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TRIGGERCLIPTHRESH</name>
            <description>WLAN AGC TRIGGER CLIP THRESH</description>
            <addressOffset>0x84</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AGCTRIGGERCLIPTHRESH</name>
                <description>Number of samples in clip to trigger AGC gain estimation when AGC is free running..</description>
                <lsb>0</lsb>
                <msb>10</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TRIGGERDISABLE</name>
            <description>WLAN AGC TRIGGER DISABLE</description>
            <addressOffset>0x88</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AGCTRIGGERDISABLE</name>
                <description>Disables AGC trigger.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>AgcEstimationEnabled</name>
                    <description>AGC estimation enabled.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StopTriggeringAgcEst</name>
                    <description>Stop triggering AGC estimation so that the gain value does not change.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>MAXRFRSSISTATUSCOUNT</name>
            <description>WLAN AGC MAX RF RSSI STATUS COUNT</description>
            <addressOffset>0x8C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>MAXNOOFRFRSSIBASEDGAINSET</name>
                <description>This value indicates the maximum no of times, we can do RF RSSI status basedgain mapping in RF_RSSI_STATUS_GAIN_SET state in AGC.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>GAINTHRESHOLDFORCCA</name>
            <description>WLAN AGC GAIN THRESHOLD FOR CCA</description>
            <addressOffset>0x90</addressOffset>
            <access>read-write</access>
            <resetValue>0x00008080</resetValue>
            <fields>
              <field>
                <name>GAINTHRESHOLD1TOSETCCA</name>
                <description>Register for setting the gain threshold to compare with estimated gain value and set cca flag. value is2's complement of the value, so the range is from -128 to 127dB.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>GAINTHRESHOLD2TOSETCCA</name>
                <description>Register for setting the gain threshold to compare with estimated gain value and set cca flag. value is2's complement of the value, so the range is from -128 to 127dB.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WAITTIMEAFTERTRIGGER</name>
            <description>WLAN AGC WAIT TIME AFTER TRIGGER</description>
            <addressOffset>0x94</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WAITTIMEAFTERAGCTRIGGER</name>
                <description>this value represents the amount of time we need to wait after AGC trigger and before we go to estimation process. this is needed to avoid AGC estimation on initial ramp of the signal.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FINVALMAPPED</name>
            <description>WLAN AGC FIN VAL MAPPED</description>
            <addressOffset>0x98</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>MAPPEDAGCVALUE</name>
                <description>This represents the AGC value after mapping</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FINVAL</name>
            <description>WLAN AGC FIN VAL</description>
            <addressOffset>0x9C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>AGCFINALVALUE</name>
                <description>Register where the final value of the AGC is written.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUS</name>
            <description>WLAN AGC STATUS</description>
            <addressOffset>0xA0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>FIRSTAGCDONE</name>
                <description>Level 'High' indicates first stage AGC is completed.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>SECONDAGCDONE</name>
                <description>Level 'High' indicates second stage AGC is completed.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>RFRSSISTATUS</name>
                <description>Indicates the status of the RF RSSI (Only returns bit 0 used by legacy mode).</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>RFRSSIVALID</name>
                <description>Indicates when RF_RSSI_STATUS is holding a valid value. Write any value to this field to acknowledge read and reset it.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>CCASTATUSFROMGAINEST</name>
                <description>Generating the status by comparing the Agc Gain with Threshold to represent the channel busy status.Level 'High' indicates channel is busy.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>AGCINTRANSIENT</name>
                <description>Indicates when AGC is in transient.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>HWAGCTRIGGERDISABLESTATUS</name>
                <description>Hardware Controlled AGC Trigger disable status</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>MAXLNAGAINMODEWITHRFRSSIZERO</name>
                <description>This register holds the value of the LNA gain mode to which the AGC converged to during the RF RSSI based LNA gain stage setting. This the max LNA gain mode for which average RF RSSI was zero.Note that this value of the LNA gain mode will be different from the final AGC LNA mode, because based on baseband gain constraints (max and min values), we will be forced to choose a different LNA gain mode.</description>
                <lsb>7</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>RFRSSISTATUSFULL</name>
                <description>Indicates the status of the RF RSSI. (Returns all 3-bits).</description>
                <lsb>12</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>DEBUGMODERFRSSIAVGSTART</name>
                <description>This bit is the output of the internal RF RSSI AVG start signal. The port output is connected to this register, so that it can be used for AGC testing in DEBUG IQ mode.</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGINFO1</name>
            <description>WLAN AGC DEBUG INFO1</description>
            <addressOffset>0xA4</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>NOOFRFRSSIITERATIONS</name>
                <description>stores the value which represents the no of rf rssi loops (LNA stage chages )entered in the RF RSSI STATE.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>NOOFCUTBACKITERATIONSFIRSTAGC</name>
                <description>stores the value which represents the no of cutback iterations taken in the First AGC estimation process.</description>
                <lsb>4</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>NOOFCUTBACKITERATIONSSECAGC</name>
                <description>stores the value which represents the no of cutback iterations taken in the Sec AGC estimation process.</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGINFO2</name>
            <description>WLAN AGC DEBUG INFO2</description>
            <addressOffset>0xA8</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CLIPCOUNTFIRSTITERATION</name>
                <description>stores the value which represents the no of saturated samples seen in the second cutback iteration.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>CLIPCOUNTSECONDITERATION</name>
                <description>stores the value which represents the no of saturated samples seen in the first cutback iteration.</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VARIANCEOUT</name>
            <description>WLAN AGC VARIANCE OUT</description>
            <addressOffset>0xAC</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>VARIANCEINDBLATCHED</name>
                <description>This value is the variance in dB, which was latched during the posedge of EdDone.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>VARIANCEINDBLIVE</name>
                <description>This is the free running variance in dB, which is being computed for variance based AGC triggering.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>VARIANCELIVEVALID</name>
                <description>Valid for VARIANCE_IN_DB_LIVE. This will become high after the first update of the live variance. Will become low during module reset or during AGC trigger.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RSSICOMPUTESETTINGS</name>
            <description>WLAN AGC RSSI COMPUTE SETTINGS</description>
            <addressOffset>0xB0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000300</resetValue>
            <fields>
              <field>
                <name>RSSICOMPFACTOR</name>
                <description>This is a signed value in dB that used in the AGC RSSI computation, from the AGC log variance.AGC_RSSI= (AGC_LOG_VARIANCE - AGC_GAIN_DB) + AGC_RSSI_COMP_FACTOR</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>VARMVGAVGESTLEN</name>
                <description>The moving averager that averages the latest N variance estimates. (The moving averaged variance could be given out as free-running Live variance by setting the register configuration). The value of N is selected by this field.0x0 - not used0x1 - N=20x2 - N=40x3 - N=8</description>
                <lsb>8</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>AGCDONETIMEOUT</name>
                <description>Timeout in clock cycles for the rf_rssi_valid after rf_rssi_avg_start is triggered:- if timeout an internal rf_rssi_valid is generated to prevent the FSM to stuck- timeout check is disabled if AGC_DONE_TIMEOUT is set to 0</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
