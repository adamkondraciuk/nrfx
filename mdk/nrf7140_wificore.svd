            <name>EDCAFSMSTATE</name>
            <description>WLAN TIMERS EDCA FSM STATE</description>
            <addressOffset>0x1DC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <fields>
              <field>
                <name>EDCAFSMCURRENTSTATE</name>
                <description>Returns the current state of the EDCA FSM.Note : The FSM encoding is one-hot encoded.EDCA_FSM_CURRENT_STATE [7 .. 0] :0x1=&amp;gt; State = Idle.0x2=&amp;gt; State = SIFS_COUNTER0x4=&amp;gt; State = PHY_CS_BUSY0x8=&amp;gt; State = PHY_VIRTUAL_BUSY0x10 =&amp;gt; State = CHECK_FCS0x20 =&amp;gt; State = DIFS_BACKOFF0x40 =&amp;gt; State = TX_ON.</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCADEBUGCOMPGRDIFSBACKOFFZEROAC0</name>
            <description>WLAN TIMERS EDCA DEBUG COMP GR DIFS BACKOFF ZERO AC0</description>
            <addressOffset>0x1E0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>DEBUGDIFSCOMPEXPIRYAC0</name>
                <description>This field is set if the Back-off counter 0 has counted down to zero and the slotcompensation register value is greater than the DIFS counter 0 period and the interrupt for AC0 is asserted.This field is cleared when if the interrupt for AC0 is cleared.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>DEBUGDIFSRESETONSIFSAC0</name>
                <description>This field is set if the field DEBUG_DIFS_COMP_EXPIRY_AC0 is set and the FSM enters the SIFS_COUNTER state.The field is cleared if the interrupt for AC0 is cleared.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>DEBUGDIFSVALUEBEFORERESETAC0</name>
                <description>Returns the current state of Difs counter 0, if DEBUG_DIFS_COMP_EXPIRY_AC0 isset and just before the DIFS counter 0 is reset when the FSM is in the TX_ON state.</description>
                <lsb>8</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
