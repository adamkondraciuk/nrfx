    <peripheral>
      <name>GLOBAL_STM_NS</name>
      <description>System Trace Macrocell</description>
      <baseAddress>0xBF042000</baseAddress>
      <headerStructName>STM</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
