            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>WLANCTRLOFDMRTMSCPEOPSNAPSHOTMSB</name>
                <description>MSB of snapshot of time measurement counter, taken when OFDM Receiver Training Mode - SCP EOP goes high</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>OFDMRTMSCPEOPSNAPSHOTLSB</name>
