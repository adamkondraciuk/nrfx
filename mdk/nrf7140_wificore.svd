          <register>
            <name>DCPWAITCNT</name>
            <description>EDC SYS DCP WAIT CNT</description>
            <addressOffset>0x430</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
