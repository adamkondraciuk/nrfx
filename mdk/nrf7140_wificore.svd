                </field>
                <field>
                  <name>L3HDRLENGTH</name>
                  <description>Length of the IP header in 32 bit words extracted from the packet.For example value 5 means 5*4 = 20 bytes.This field will be cleared at the start of every new packet.</description>
                  <lsb>20</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMDEBUG3</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM DEBUG3</description>
              <addressOffset>0x00C</addressOffset>
              <access>read-only</access>
              <resetValue>0x0000FFEC</resetValue>
              <fields>
                <field>
                  <name>L3HDRTOTALLENGTH</name>
                  <description>Total length of packet in bytes extracted from the packet.Note: In case of IPV4 ethernet type this field is the sum of the IP header lengthL3_HDR_LENGTH and the IP payload length.In case of IPV6 ethernet type this field represents the IP payload length only.This field will be cleared at the start of every new packet.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L3HDRPROTOCOL</name>
                  <description>Transport layer protocol information extracted from the packet.This field will be cleared at the start of every new packet.</description>
                  <lsb>16</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
