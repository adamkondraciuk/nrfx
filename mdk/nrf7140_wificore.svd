          <register>
            <name>NOTCHBYPASS</name>
            <description>SCP NOTCH BYPASS</description>
            <addressOffset>0x27C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>HWCONTROLNOTCH0</name>
                <description>Determine the Notch filter 0 enabling/disabling control mode:0. Notch filter 0 is enabled if SCP_NOTCH_0.NOTCH0_ENABLE register field is set.1. Notch filter 0 is dynamically controlled using DSSS or OFDM information from ED block: enable notch when DSSS packet is detected, disable when OFDM packet is detected.*Note: mode 1 requires SCP_NOTCH_0.NOTCH0_ENABLE = 1 and SCP_NOTCH_BYPASS.NOTCH_BYPASS = 0</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>NOTCHACCUM</name>
                <description>Determines whether notch phase accumulators are reset when NOTCHn_FREQ registers are written to.</description>
                <lsb>22</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ResetAccumulationWhe</name>
                    <description>Reset accumulation when NOTCHn_FREQ registers are written to.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ContinueAccumulation</name>
                    <description>Continue accumulation when NOTCHn_FREQ registers are written to.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>NOTCHBYPASS</name>
                <description>Used to set the bypass mode of the Notch filter block.When bypass is set the Notch filter block is powered down and data passes around it unaltered.When set to Normal the block operates as programmed by the registers that control it.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NormalOperation</name>
                    <description>Normal operation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BlockBypassedOverru</name>
                    <description>Block Bypassed (overrules any other block settings)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
