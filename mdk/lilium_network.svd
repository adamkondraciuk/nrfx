                    <enumeratedValue>
                      <name>Lock</name>
                      <description>Interface is locked and cannot be enabled.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Unlock</name>
                      <description>Interface is unlocked and can be enabled.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>WRITTEN</name>
                  <description>Status bit indicating if write once register has been written to since last reset</description>
                  <lsb>8</lsb>
                  <msb>8</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Written</name>
                      <description>Write once register has been written to and cannot be overwritten unless reset.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Unwritten</name>
                      <description>Write once register has not been written to and can be overwritten.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
