            <field>
              <name>ADDRESS</name>
              <description>The address of the digital island to write to</description>
              <lsb>16</lsb>
              <msb>27</msb>
            </field>
            <field>
              <name>DONOTTRANSFER</name>
              <description>When 1, we do not transfer this word to AdPll at power up</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
