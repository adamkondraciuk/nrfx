              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>CALAMP</name>
              <description>Stored calAmp value</description>
              <lsb>8</lsb>
              <msb>12</msb>
            </field>
            <field>
              <name>CALPHI</name>
              <description>Stored calPhi value</description>
              <lsb>16</lsb>
              <msb>20</msb>
            </field>
            <field>
              <name>CALPHISIGN</name>
              <description>Sign of calPhi value</description>
              <lsb>27</lsb>
              <msb>27</msb>
            </field>
            <field>
              <name>MODE</name>
              <description>IQCal search mode</description>
              <lsb>28</lsb>
              <msb>29</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Optimized</name>
                  <description>Optimized search algorithm.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Exhaustive</name>
                  <description>Exhaustive search.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Cancellation</name>
                  <description>Optimized search with cancellation.</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RUN</name>
              <description>Run I and Q calibration procedure</description>
              <lsb>31</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Stored</name>
                  <description>Using stored values for calPhi and calAmp</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Calib</name>
                  <description>Running calibration</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
