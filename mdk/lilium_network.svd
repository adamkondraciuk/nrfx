                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Both</name>
                  <description>Both BBLogMag and BitSlicerSwing</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DBCTIMEOUT</name>
              <description>Override value for correlator timeout,in bit periods (hypermode)</description>
