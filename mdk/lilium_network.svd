                </enumeratedValue>
                <enumeratedValue>
                  <name>1M</name>
                  <description>1 Mbps</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2M</name>
                  <description>2 Mbps</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4M</name>
                  <description>4 Mbps</description>
                  <value>0x4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
