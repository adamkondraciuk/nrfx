        <cluster>
          <name>INTERCEPT</name>
          <description>Write 1 to a bit to arm the task/event at that index for a single intercept.
      Write 0 to a bit to disarm.
      After arming, the bit will be read out as 1 until the task/event has been intercepted or disarmed, after which it will be read out as 0.
      Both PPI-triggered and APB-triggered tasks will be intercepted.
      Only core-triggered events will be intercepted, not APB-triggered events.</description>
          <headerStructName>RADIO_INTERCEPT</headerStructName>
          <access>read-write</access>
          <addressOffset>0x5B0</addressOffset>
          <register>
            <dim>0x2</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>TASKS[%s]</name>
            <description>Description collection:</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>ONEBITPERTASK</name>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x2</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>EVENTS[%s]</name>
            <description>Description collection:</description>
            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>ONEBITPEREVENT</name>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG</name>
            <description>Unspecified</description>
            <addressOffset>0x010</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000003</resetValue>
            <fields>
              <field>
                <name>STOPTASKS</name>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>STOPEVENTS</name>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
        </cluster>
