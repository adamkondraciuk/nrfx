                  <description>BT=0.55</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0BT60</name>
                  <description>BT=0.60</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IQMODINDEX</name>
