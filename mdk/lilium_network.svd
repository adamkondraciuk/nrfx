                <enumeratedValue>
                  <name>Peripheral</name>
                  <description>Peripheral with dedicated pins</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TND</name>
                  <description>Trace and Debug Subsystem</description>
                  <value>0x7</value>
