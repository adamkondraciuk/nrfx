            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CALTARGET</name>
                <description>Calibration target selection for calibration engine, 0: DC_CAL, 1: RC_CAL</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG</name>
            <description>Configuration of manual calibration</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>CALTSTART</name>
                <description>Startup wait time</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>CALTSETTLE</name>
                <description>Settle wait time</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>CALTCOMPARE</name>
                <description>Compare wait time</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>CALBITS</name>
                <description>Number of valid bits to be calibrated</description>
                <lsb>24</lsb>
                <msb>26</msb>
              </field>
              <field>
                <name>CALINVERTCMP1</name>
                <description>1: invert calCmp1 before it goes into calibration engine #1</description>
                <lsb>28</lsb>
                <msb>28</msb>
              </field>
              <field>
                <name>CALINVERTCMP2</name>
                <description>1: invert calCmp2 before it goes into calibration engine #2</description>
                <lsb>29</lsb>
                <msb>29</msb>
              </field>
              <field>
                <name>CALMANUAL</name>
                <description>0: use hard-coded calibration timing, 1: use manual calibration timing above</description>
                <lsb>31</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RESULT</name>
            <description>Calibration result</description>
            <addressOffset>0x008</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>RCCALCODE</name>
                <description>Calibration result from RC calibration</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>RFMIXDCCALI</name>
                <description>Calibration result from DC offset calibration on channel I</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>RFMIXDCCALQ</name>
                <description>Calibration result from DC offset calibration on channel Q</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
        </cluster>
