              <description>calAmp from IQCal</description>
              <lsb>8</lsb>
              <msb>12</msb>
            </field>
            <field>
              <name>CALFIN</name>
              <description>High when IQCal search finished</description>
              <lsb>15</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>MAGNITUDE</name>
              <description>Magnitude output from BB peak detector</description>
              <lsb>16</lsb>
              <msb>27</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FECONFIG</name>
          <description>Config register</description>
          <addressOffset>0x908</addressOffset>
          <access>read-write</access>
          <resetValue>0x10000005</resetValue>
          <fields>
            <field>
              <name>ALPHA</name>
              <description>Alpha for IIR filter used in logMag calculation</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>SCALERDECAY</name>
              <description>The number of clock cycles to wait before stepping down the internal memory for the scaling. The value 0 means that the decay feature is off.</description>
              <lsb>8</lsb>
              <msb>13</msb>
            </field>
            <field>
              <name>SCALECONST</name>
              <description>A constant scaling that overrides dynamic scaling behaviour in the IQ Scaler. Value != 0 enables constant scaling.</description>
              <lsb>16</lsb>
              <msb>19</msb>
            </field>
            <field>
              <name>QDISABLE</name>
              <description>Disable Q samples to save power</description>
              <lsb>24</lsb>
              <msb>24</msb>
            </field>
            <field>
              <name>INVERTI</name>
              <description>Invert I channel in case Q channel leads I</description>
              <lsb>28</lsb>
              <msb>28</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>IQCALCONF</name>
          <description>Gain and phase mismatch calibration control for I and Q</description>
          <addressOffset>0x90C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00101028</resetValue>
          <fields>
            <field>
              <name>IQCALWAIT</name>
