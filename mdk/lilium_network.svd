          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADPLLCOMMAND</name>
              <description>Controls the asynch interface, bits[27:16] are address, bits [15:0] are command/data field</description>
              <lsb>0</lsb>
              <msb>27</msb>
            </field>
            <field>
              <name>READ</name>
              <description>When 1, a read transaction is initiated. When the event COMPLETETRANS is set, read back this register</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
