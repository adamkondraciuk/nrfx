              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Classic</name>
                  <description>use classic demodulator</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LrSyncEngine</name>
                  <description>Use LrSyncEngine demodulator</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
