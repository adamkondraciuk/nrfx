              <name>OVRVALTXPWR</name>
              <description>Override value of TX_PWR_0V8</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>OVRENTXPWR</name>
              <description>Enable override of TX_PWR_0V8</description>
              <lsb>7</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>BUFFEREDTXPWR</name>
              <description>Set to high to buffer TXPOWER so that sub-modules in the MMI will only update next tx power config at TX_EN, RX_EN and LB_EN. Set to low if special test is needed for Tx test.</description>
              <lsb>8</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>TIEADCBITOZERO</name>
              <description>0: output normal adcBinaryBI, 1: tie adcBinaryBI to zero</description>
              <lsb>9</lsb>
              <msb>9</msb>
            </field>
            <field>
              <name>TIEADCBQTOZERO</name>
              <description>0: output normal adcBinaryBQ, 1: tie adcBinaryBQ to zero</description>
              <lsb>10</lsb>
              <msb>10</msb>
            </field>
            <field>
              <name>RFMIXINVERTSIGNBIT</name>
              <description>1: Invert the sign bit of calibration code for DC offset calibration(invert DCCAL[4]). This inverts both channel I and Q.</description>
              <lsb>11</lsb>
              <msb>11</msb>
            </field>
            <field>
              <name>SHORTRCCALCODETOAAFRCTRIM</name>
              <description>1: short RCCAL_CODE[3:0] to RX_AAF_RCTRIMM[3:0]</description>
              <lsb>12</lsb>
              <msb>12</msb>
            </field>
          </fields>
