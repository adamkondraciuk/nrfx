        <register>
          <name>SUPPORTEDTRIGGERMODES</name>
          <description>The Supported_trigger_modes register indicates the implemented trigger counter multipliers and other supported features of the trigger system.</description>
          <addressOffset>0x100</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MULT_0</name>
              <description>Indicates whether multiplying the trigger counter by 2^(0+1) is supported.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotSelected</name>
                  <description>Multiplying the trigger counter by 2^(0+1) is supported.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Selected</name>
                  <description>Multiplying the trigger counter by 2^(0+1) is supported.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MULT_1</name>
              <description>Indicates whether multiplying the trigger counter by 2^(1+1) is supported.</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotSelected</name>
                  <description>Multiplying the trigger counter by 2^(1+1) is supported.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Selected</name>
