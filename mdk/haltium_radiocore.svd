            </field>
            <field>
              <name>NFCID1_X</name>
              <description>NFCID1 byte X</description>
              <lsb>16</lsb>
              <msb>23</msb>
            </field>
            <field>
              <name>NFCID1_W</name>
              <description>NFCID1 byte W</description>
              <lsb>24</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>NFCID1_2ND_LAST</name>
