                <enumeratedValue>
                  <name>Mode1</name>
                  <description>Mode 1: nRF51 legacy debounce method</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
