              <name>ID_1</name>
              <description>Drives the ATIDMI[1] output pin.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>ID_2</name>
              <description>Drives the ATIDMI[2] output pin.</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>ID_3</name>
              <description>Drives the ATIDMI[3] output pin.</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>ID_4</name>
              <description>Drives the ATIDMI[4] output pin.</description>
              <lsb>4</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>ID_5</name>
