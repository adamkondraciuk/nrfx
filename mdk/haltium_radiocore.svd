    <peripheral derivedFrom="MVDMA_NS">
      <name>MVDMA_S</name>
      <description>MVDMA performs direct-memory-accesses between memories. Data is transferred according to job descriptor lists.  Each transfer has corresponding source and sink descriptor lists with matching data amounts. The lists are in memory and they contain data buffer information, address pointers, buffer sizes and data type attributes. MVDMA IP connects to an ARM standard AXI4 bus. 1</description>
      <baseAddress>0x53003000</baseAddress>
      <!--Security dma=NSA-->
      <!--Security securemapping=US-->
      <interrupt>
        <name>MVDMA</name>
        <value>3</value>
      </interrupt>
    </peripheral>
