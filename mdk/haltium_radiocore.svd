              <msb>14</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>MODE</name>
          <description>Counter mode selection</description>
          <addressOffset>0x510</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>AUTOEN</name>
              <description>Automatic enable to keep the SYSCOUNTER active.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Default</name>
                  <description>Keep the SYSCOUNTER active when KEEPRUNNING is set, or access to any task registers, INT registers or SYSCOUNTER registers.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CpuActive</name>
                  <description>In addition to the above mode, any local CPU that is not sleeping keep the SYSCOUNTER active.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYSCOUNTEREN</name>
              <description>Enable the SYSCOUNTER</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>SYSCOUNTER disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>SYSCOUNTER enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SYSCOUNTERL</name>
          <description>The lower 32-bits of the SYSCOUNTER</description>
          <addressOffset>0x514</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>VALUE</name>
              <description>The lower 32-bits of the SYSCOUNTER value.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>SYSCOUNTERH</name>
          <description>The higher 32-bits of the SYSCOUNTER</description>
          <addressOffset>0x518</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>VALUE</name>
              <description>The higher 32-bits of the SYSCOUNTER value.</description>
              <lsb>0</lsb>
              <msb>19</msb>
            </field>
            <field>
              <name>OVERFLOW</name>
              <description>The SYSCOUNTERL overflow indication after reading it.</description>
              <lsb>31</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NoOverflow</name>
                  <description>SYSCOUNTERL is not overflown</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Overflow</name>
                  <description>SYSCOUNTERL overflown</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
