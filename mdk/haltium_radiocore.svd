              <lsb>0</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>DATAACQENABLE</name>
              <description>Set high to enable data acquisition</description>
              <lsb>7</lsb>
              <msb>7</msb>
            </field>
          </fields>
