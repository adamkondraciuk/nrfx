                </enumeratedValue>
                <enumeratedValue>
                  <name>VREFPEAKFORPEAKDET</name>
                  <description>VREF_PEAK for peak detection</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
