      <registers>
        <register>
          <name>IDFILTER0</name>
          <description>The IDFILTER0 register enables the programming of ID filtering for master port 0.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ID0_00_0F</name>
              <description>Enable or disable ID filtering for IDs 0x00_0x0F.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotFiltered</name>
                  <description>Transactions with these IDs are passed on to ATB master port 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Selected</name>
                  <description>Transactions with these IDs are discarded by the replicator.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ID0_10_1F</name>
              <description>Enable or disable ID filtering for IDs 0x10_0x1F.</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
