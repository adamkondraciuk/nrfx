          <description>This is used to enable write access to device registers.</description>
          <addressOffset>0xFB0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ACCESS</name>
              <description>A write of 0xC5ACCE55 enables further write access to this device. Any other write removes write access.</description>
              <lsb>0</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UnLock</name>
