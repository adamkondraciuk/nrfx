                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TRIGGERED</name>
              <description>A trigger has occurred and the counter has reached 0.</description>
              <lsb>16</lsb>
              <msb>16</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotOccured</name>
