                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PC_1</name>
              <description>Selects processor comparator 1 inputs for Single-shot control</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
