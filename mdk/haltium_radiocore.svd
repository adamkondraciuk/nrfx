            <fields>
              <field>
                <name>MODE</name>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>SingleMode</name>
                    <description>Descriptor list pointers are in registers, SOURCELISTPTR and SINKLISTPTR.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MultiMode</name>
                    <description>Descriptor list pointers are in a list in memory and different pointers are chosen with different taskStart tasks.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
