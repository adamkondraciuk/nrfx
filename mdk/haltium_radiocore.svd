                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CMFBOFFSETCOMP</name>
                  <description>Divided Common mode of NFC1 and NFC2 at the CMFB OFFSET comparator</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VREFPEAKDETECTORREF</name>
                  <description>VREF for peak detector reference</description>
