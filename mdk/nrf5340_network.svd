          <resetValue>0x00023282</resetValue>
          <fields>
            <field>
              <name>NUMBEROF8US</name>
              <description>Length of CTE in number of 8 microseconds. Used in TX mode and in RX mode when CTEINLINECTRL is 0</description>
              <lsb>0</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>DFEINEXTENSION</name>
              <description>Add CTE extension and do antenna switching/sampling in this extension. If 0, antenna switching/sampling is done in the packet payload</description>
              <lsb>7</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>TSWITCHSPACING</name>
              <description>Interval between switching antennas</description>
              <lsb>8</lsb>
              <msb>9</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>8us</name>
