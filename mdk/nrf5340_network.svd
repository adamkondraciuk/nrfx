          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DEMOD</name>
              <description>Demodulator mode override value. 1=hyper,0=standard</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Standard</name>
                  <description>Hypermode disabled (override value)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Hyper</name>
                  <description>Hypermode enabled (override value)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AAFFREQ</name>
              <description>IF frequency, 0=1MHz (for &amp;lt; =1Mbps), 1=2MHz (for 2Mbps)</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>AAFENSTAGE</name>
              <description>Enable extra AAF filter stage</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>OVRENDEMOD</name>
              <description>if '1' enable override for DEMOD</description>
              <lsb>24</lsb>
              <msb>24</msb>
            </field>
            <field>
              <name>OVRENAAFFREQ</name>
              <description>if '1' enable override for AAFFREQ</description>
              <lsb>25</lsb>
              <msb>25</msb>
            </field>
            <field>
              <name>OVRENAAFENSTAGE</name>
              <description>if '1' enable override for AAFENSTAGE</description>
              <lsb>26</lsb>
              <msb>26</msb>
            </field>
            <field>
              <name>OVRENLNACURR</name>
              <description>if '1' enable override for LNACURR</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>QOVERRIDE21</name>
          <description>Trim value override register 21 for nRF52</description>
