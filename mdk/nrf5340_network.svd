              <lsb>28</lsb>
              <msb>30</msb>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Enable or disable override of default trim values</description>
              <lsb>31</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>QOVERRIDE22</name>
          <description>Trim value override register 22 for nRF52</description>
          <addressOffset>0x77C</addressOffset>
          <access>read-write</access>
          <resetValue>0x62040122</resetValue>
          <fields>
            <field>
              <name>DSSSPEAKDISTTOL</name>
              <description>Override for dsssPeakDistanceTolerance</description>
              <lsb>0</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>DSSSMINPEAKCOUNT</name>
              <description>Override for dsssMinPeakCount</description>
              <lsb>4</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>DISABLEHYPERANT</name>
              <description>Disable or enable hypermode fix for ANT</description>
              <lsb>8</lsb>
              <msb>8</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DISABLEADDRWINDOW</name>
              <description>Disable or enable the qualification of addressMatch vs. detect</description>
              <lsb>9</lsb>
              <msb>9</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TRXTXASYM1M2MHOLD</name>
              <description>TIFS negative offset when the mode is switched from 1M to 2M</description>
              <lsb>11</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>TRXTXTURNAROUNDHOLD</name>
              <description>Additional delay to hold Tx/Rx turnaround, full resolution [250ns]</description>
              <lsb>16</lsb>
              <msb>25</msb>
            </field>
            <field>
              <name>TRXTXASYM2M1MHOLD</name>
              <description>TIFS positive offset when the mode is switched from 2M to 1M</description>
              <lsb>26</lsb>
              <msb>30</msb>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Enable or disable override for DSSSPEAKDISTTOL and DSSSMINPEAKCOUNT</description>
              <lsb>31</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>QOVERRIDE23</name>
          <description>Trim value override register 23 for nRF52</description>
          <addressOffset>0x780</addressOffset>
          <access>read-write</access>
          <resetValue>0x00002808</resetValue>
          <fields>
            <field>
              <name>ENDSSSCFOAVE</name>
              <description>Enable CFO averaging</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>ENDSSSSTAVE</name>
              <description>Enable strobe time averaging</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>ENMAYBESIDELOBE</name>
              <description>Ignore peaks from DBC which look like sidelobes</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>ENADUALDISTANCE</name>
              <description>Allow dual distance between peaks</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>DRIFTSATENABLEALWAYS</name>
              <description>Enable saturation in drift calculator for all modes</description>
              <lsb>4</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>OVRENCNRIPPLEWARNCFG</name>
              <description>Override enable for CNPEAKMINTHR and CNABSMAXTHR in the CNRIPPLEWARNCFG register</description>
              <lsb>5</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>ENABLEFEEDBACK</name>
              <description>Enable decision feedback for matched filter bank</description>
              <lsb>6</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>HIGHERTHANMARGINDBC</name>
              <description>Required peak height required for a double correlator peak to be considered higher than previous ones. The register value will be multiplied by 25 to obtain the actual margin. The bitfield is NOT subject to the enable override at bit position 31, and will always be enabled for hypermode.</description>
              <lsb>8</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>KEEPSTDINDSSS</name>
              <description>Keep standard demod in DSSS mode</description>
              <lsb>16</lsb>
              <msb>16</msb>
            </field>
            <field>
              <name>DISABLESYMBOLTRACK</name>
              <description>Disable symbol tracking for IEEE 802.15.4 and BLE LR modes</description>
              <lsb>17</lsb>
              <msb>17</msb>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Enable override for OVERRIDE23 (except HIGHERTHANMARGINDBC and OVRENCNRIPPLEWARNCFG)</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>QOVERRIDE24</name>
          <description>Configuration for the CNRIPPLEWARN functionality used for BLE LR. Configuration is only enabled when OVRENCNRIPPLEWARNCFG in OVERRIDE23 is set</description>
          <addressOffset>0x784</addressOffset>
          <access>read-write</access>
          <resetValue>0x03200640</resetValue>
          <fields>
            <field>
              <name>CNPEAKMINTHR</name>
              <description>Required peak height compared to baseline level measured just before the peak at the double correlator output. If the peak height is below the threshold, it will be ignored. This feature is disabled when CNPEAKMINTHR is set to 0x0000.</description>
              <lsb>0</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>CNABSMAXTHR</name>
              <description>maximum baseline value before the peak at the double correlator output. if the baseline value is above the threshold, the following peak will be ignored. this value is ignored when CNABSMAXTHR is set to 0x0000.</description>
              <lsb>16</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>QOVERRIDE25</name>
          <description>Unspecified</description>
          <addressOffset>0x788</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DBCCORRTHSTRICT</name>
              <description>Correlation threshold for double correlator used in BleLr and Ieee802154 mode to resync to another preamble while already working on a previous preamble.</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>DBCCORRTHPREVREQUIR</name>
              <description>Correlation threshold for double correlator used in BleLr and Ieee802154 mode to reject a later resync using DBCCORRTHSTRICT.</description>
              <lsb>8</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>MINPEAKCOUNTSTRICT</name>
              <description>Min number of peaks to detect before resyncing to another preamble while already working on a previous preamble in BleLr and Ieee802154 mode.</description>
              <lsb>16</lsb>
              <msb>18</msb>
            </field>
            <field>
              <name>OVRENDBCCORRTHSTRICT</name>
              <description>Override enable for DBCCORRTHSTRICT</description>
              <lsb>28</lsb>
              <msb>28</msb>
            </field>
            <field>
              <name>OVRENDBCCORRTHPREVREQUIR</name>
              <description>Override enable for DBCCORRTHPREVREQUIR</description>
              <lsb>29</lsb>
              <msb>29</msb>
            </field>
            <field>
              <name>OVRENMINPEAKCOUNTSTRICT</name>
              <description>Override enable for MINPEAKCOUNTSTRICT</description>
              <lsb>30</lsb>
              <msb>30</msb>
            </field>
          </fields>
        </register>
        <cluster>
          <name>DEBUGPSEL</name>
          <description>Unspecified</description>
          <headerStructName>RADIO_DEBUGPSEL</headerStructName>
          <addressOffset>0x800</addressOffset>
          <register>
            <name>CLOCK</name>
            <description>Pin select for RADIO clock (direct mode, base band debug. Refer to digip_064 and digip_061, txCk and ckDataIn signals)</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <fields>
              <field>
                <name>PIN</name>
                <description>Pin number</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>PORT</name>
                <description>Port number</description>
                <lsb>8</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>CONNECT</name>
                <description>Connection</description>
                <lsb>31</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disconnected</name>
                    <description>Disconnect</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Connected</name>
                    <description>Connect</description>
                    <value>0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DATA</name>
            <description>Pin select for RADIO data (direct mode, base band debug. Refer to digip_064 and digip_061, txRadioData and dataIn signals)</description>
