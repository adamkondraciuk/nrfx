        <cluster>
          <name>TESTCOUNTER</name>
          <description>Test counter</description>
          <headerStructName>OTP_TESTCOUNTER</headerStructName>
          <addressOffset>0x650</addressOffset>
          <register>
            <name>CONFIG</name>
            <description>Configuration register</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <fields>
              <field>
                <name>OPERATIONMODE</name>
                <description>Enable TESTCOUNTER-triggered latching of PDOUT</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Direct</name>
                    <description>The TESTDATA registers reads the immediate value of PDOUT</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Latched</name>
                    <description>The TESTDATA registers reads the latched value of PDOUT</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>TRIGGER</name>
            <description>Starts the counter. Only applicable when CONFIG.OPERATIONMODE=Direct</description>
            <addressOffset>0x004</addressOffset>
            <access>write-only</access>
            <fields>
              <field>
                <name>TRIGGER</name>
                <description>Start counter</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotStart</name>
                    <description>Do not start counter</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Start</name>
                    <description>Start counter. Only applicable when CONFIG.OPERATIONMODE=Direct</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>RELOAD</name>
            <description>Reload value for counter</description>
            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>RELOAD</name>
                <description>This is the counter reload value, used each time the decrementing counter is triggered</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RUNNING</name>
            <description>Check if TESTCOUNTER is running</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-only</access>
            <fields>
              <field>
                <name>RUNNING</name>
                <description>Checks if TESTCOUNTER is running</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NotRunning</name>
                    <description>Counter is not running</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Running</name>
                    <description>Counter is running</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
