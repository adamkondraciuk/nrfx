              </enumeratedValues>
            </field>
            <field>
              <name>SAMPLETYPE</name>
              <description>Whether to sample I/Q or magnitude/phase. 0: I/Q, 1: mag/phase</description>
              <lsb>15</lsb>
              <msb>15</msb>
