              <lsb>16</lsb>
              <msb>23</msb>
            </field>
            <field>
              <name>TDELTAOVREN</name>
              <description>Override enable</description>
              <lsb>24</lsb>
              <msb>24</msb>
            </field>
            <field>
              <name>TXPASRAMP0V9</name>
