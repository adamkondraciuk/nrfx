          </register>
          <register>
            <name>MAX</name>
            <description>Maximum number of buffer words to transfer</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x00001000</resetValue>
            <fields>
              <field>
                <name>MAX</name>
                <description>Maximum number of buffer words to transfer</description>
                <lsb>0</lsb>
                <msb>15</msb>
