        </register>
        <register>
          <name>DFECTRL2</name>
          <description>Start offset for Direction finding</description>
          <addressOffset>0x914</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TSWITCHOFFSET</name>
              <description>Offset after the end of the CRC before starting switching in number of 16M cycles. Relative to start trigger (TASKS_DFESTART or internal signals from link layer). Is a signed value.</description>
              <lsb>0</lsb>
              <msb>12</msb>
            </field>
            <field>
              <name>TSAMPLEOFFSET</name>
              <description>Offset before starting sampling in number of 16M cycles. (relative to the beginning of reference period - 12 us after switching start). Is a signed value.</description>
              <lsb>16</lsb>
              <msb>27</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DFECTRL3</name>
          <description>Various hacker/tuning configuration for Direction finding</description>
          <addressOffset>0x918</addressOffset>
          <access>read-write</access>
          <resetValue>0x28433000</resetValue>
          <fields>
            <field>
              <name>SPACINGBETWEEN</name>
              <description>Signed tuning value for the spacing between the last sample using default spacing and the next one in 8M cycles</description>
              <lsb>0</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>SPACINGBETWEEN2US</name>
              <description>Same as SPACINGBETWEEN when using CTEINLINECTRL and CTETYPE is 2 us slots</description>
              <lsb>6</lsb>
              <msb>11</msb>
            </field>
            <field>
              <name>COMP4USSWITCHING</name>
              <description>Number of 4us periods to subtract from numberOf8us when calculating total number of antenna slots switches. Usually it will need to compensate for 12 us of GUARD and REF - yielding the value 3</description>
              <lsb>12</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>COMP4USSAMPLING</name>
              <description>Number of 4us periods to subtract from numberOf8us when calculating total number of samples to capture. Usually it will need to compensate for 12 us of GUARD and REF - yielding the value 3</description>
              <lsb>16</lsb>
              <msb>19</msb>
            </field>
            <field>
              <name>TGUARDPERIOD</name>
              <description>Length of GUARD period in number of microsends. This should normally be 4</description>
              <lsb>20</lsb>
              <msb>23</msb>
            </field>
            <field>
              <name>TREFPERIOD</name>
              <description>Length of REFERENCE period in number of microsends. This should normally be 8</description>
              <lsb>24</lsb>
              <msb>28</msb>
            </field>
            <field>
              <name>CHANGESAMPLERATE</name>
              <description>Whether to always use TSAMPLESPACING in the REFERENCE period even when CTEINLINE configuration is different</description>
              <lsb>29</lsb>
              <msb>29</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DFECTRL4</name>
          <description>Various hacker/tuning configuration for Direction finding</description>
          <addressOffset>0x91C</addressOffset>
          <access>read-write</access>
          <resetValue>0xFFFFFF00</resetValue>
          <fields>
            <field>
              <name>SAMPLESTARTRELATIVETO</name>
              <description>Start sampling relative to which part in the switching state machine. This decides at what point we start counting TSAMPLEOFFSET 16M cycles before sampling starts</description>
              <lsb>0</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>REFERENCE</name>
                  <description>At the start of the REFERENCE antenna period</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWITCHING</name>
                  <description>At the start of antenna switching after the reference antenna period</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRIGGER</name>
                  <description>When it is triggered. Either TASKS_DFESTART, address match or startOfCte from UTxRxChain</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GUARD</name>
                  <description>At the start of the GUARD period</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IGNORE8USLENGTH</name>
              <description>Ignore the length specification in numberOf8us</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>IGNOREMAXSPEC</name>
              <description>Ignore the maximum number of samples specified with max registers</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>IGNOREENDOFPACKET</name>
              <description>Ignore that the UTxRxChain says that the packet has been received. Continue running if more time to run.</description>
              <lsb>5</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>ONESAMPLEPERSLOT</name>
              <description>TSAMPLESPACING is ignored for the samples taken in the SWITCHING state. TSAMPLESPACING is still used for the first samples (REFERENCE period). Note: only works with TSAMPLESPACING from 1 us to 4 us</description>
              <lsb>6</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>DFECORREN</name>
              <description>Enable correlator before Direction Finding samples</description>
              <lsb>7</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>MAXTOTALSLOTS</name>
              <description>Maximum number of antenna slots</description>
              <lsb>8</lsb>
              <msb>18</msb>
            </field>
            <field>
              <name>MAXTOTALSAMPLES</name>
              <description>Maximum number of samples to capture</description>
              <lsb>20</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>SWITCHPATTERN</name>
          <description>GPIO patterns to be used for each antenna</description>
          <addressOffset>0x928</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SWITCHPATTERN</name>
              <description>Maximum 8 GPIOs can be controlled. The first write sets the 'packet pattern' - used everywhere when not inCTE. The second write sets the 'reference pattern' - used in the GUARD and REFERENCE period only. The following writes sets the antenna patterns for the various slots. If the total number of antenna slots is bigger than the number of patterns, we loop back to the first antenna slot pattern (index 2). Use TASKS_FLUSHPATTERN if a new set of patterns will be written. When reading this register we get the total number of written patterns until now.</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
