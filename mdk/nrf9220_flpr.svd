                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Escalate</name>
                  <description>ASYNC priority escalates on second synchronization request.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
