                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MULT_4</name>
              <description>Indicates whether multiplying the trigger counter by 2^(4+1) is supported.</description>
              <lsb>4</lsb>
              <msb>4</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotSelected</name>
                  <description>Multiplying the trigger counter by 2^(4+1) is supported.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Selected</name>
                  <description>Multiplying the trigger counter by 2^(4+1) is supported.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TCOUNT8</name>
              <description>Indicates whether an 8-bit wide counter register is implemented.</description>
              <lsb>8</lsb>
              <msb>8</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotImplemented</name>
