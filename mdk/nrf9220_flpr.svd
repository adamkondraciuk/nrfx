    <peripheral>
      <name>GLOBAL_MIPIRFFE</name>
      <description>MipiRffe Master</description>
      <baseAddress>0x5F99B000</baseAddress>
      <!--Security dma=NA-->
      <!--Security securemapping=US-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>MIPIRFFE</name>
        <value>411</value>
      </interrupt>
      <groupName>MIPIRFFE</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>TASKS_START</name>
          <description>MipiRffe transmission start trigger</description>
          <addressOffset>0x000</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TASKS_START</name>
