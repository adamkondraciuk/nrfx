                  <value>0x00</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>High gain setting</description>
                  <value>0x3F</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Low</name>
                  <description>Low gain setting</description>
                  <value>0x40</value>
                </enumeratedValue>
