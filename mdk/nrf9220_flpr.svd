                    <msb>9</msb>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>Unconfigured</name>
                        <description>Power rail is unconfigured.</description>
                        <value>0x3</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>Internal</name>
                        <description>Power rail is configured to use the internal regulator.</description>
                        <value>0x0</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>External</name>
