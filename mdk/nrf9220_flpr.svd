                <usage>read</usage>
                <enumeratedValue>
                  <name>Unretained</name>
                  <description>Read: pin not retained</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Retained</name>
                  <description>Read: pin retained</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>Set</name>
                  <description>Write: writing a '1' sets pin to retained; writing a '0' has no effect</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
