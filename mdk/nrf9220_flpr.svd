                <enumeratedValue>
                  <name>NotOccured</name>
                  <description>Either a trigger has not occurred or the counter is at 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Occured</name>
                  <description>A trigger has occurred but the counter is not at 0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
